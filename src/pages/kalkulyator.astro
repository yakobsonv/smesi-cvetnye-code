---
// Калькулятор расхода (план страниц, волна 1). Угол — «сколько мешков нужно»: честный расчёт
// по нормам производителей, без смешения методик и без своих коэффициентов.
// Все числа — из src/data/series-facts.ts → CONSUMPTION (у каждой нормы URL источника)
// и фасовки дилера src/data/catalog.ts → packKg. «Запаса на бой» в данных нет — его нет и здесь.
// Вид (редизайн 11.10): калькулятор — «бланк» (Calculator.astro), нормы — записи через линии в сетке 5/7
// вместо карточек с рамкой; кирпича на странице нет, цвет дают только полосы оттенков у смесей.
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import Calculator from '../components/smesi/Calculator.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import { CONSUMPTION, SERIES_FACTS } from '../data/series-facts';
import { seriesById } from '../data/catalog';
import { PAGES } from '../data/nav';
import { liveUrl } from '../lib/sites';
import { plural } from '../lib/format';
import { nb as typo } from '../lib/typo';
import type { FaqItem } from '../lib/types';

const H1 = 'Калькулятор расхода цветной кладочной смеси';
const TITLE = 'Калькулятор расхода цветной кладочной смеси — сколько мешков нужно';
const DESCRIPTION =
  'Сколько мешков смеси нужно на кладку: Perel SL, VL, NL — по числу и формату кирпича, Основит Брикформ — по площади, затирка Perel RL и расшивка ХС30.';

/** Неразрывный пробел между числом и единицей: «1 м²» и «50 кг» не рвутся по строкам. */
const nb = (t: string) => t.replace(/(\d|½) (?=кг|м²|мм|кирпич|мешк|шт)/g, '$1\u00a0');
const num = (n: number, digits = 2) => n.toLocaleString('ru-RU', { maximumFractionDigits: digits });
const range = (a: number, b: number) => (a === b ? num(a) : `${num(a)}–${num(b)}`);
/** Для текста на экране: диапазон и «1-НФ» не рвутся по дефису/тире (U+2060 — невидимый запрет переноса). В FAQ не применяем — уходит в микроразметку. */
const keep = (t: string) => t.replace(/([\d\p{L}])([-–])(?=[\d\p{L}])/gu, '$1$2\u2060');
const one = (n: number) => n.toLocaleString('ru-RU', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
/** Нормы на кирпич — с одной десятой, как в таблице каталога Perel: «0,8–1,0», а не «0,8–1». */
const range1 = (a: number, b: number) => (a === b ? one(a) : `${one(a)}–${one(b)}`);
const bags = (kg: number, pack: number) => Math.ceil(Math.round(kg * 100) / Math.round(pack * 100));

const P = CONSUMPTION.perel;
const O = CONSUMPTION.osnovit;
const R = CONSUMPTION.perelRl;
const X = CONSUMPTION.osnovitXc30;

const perelPack = seriesById('perel-sl').packKg;
const osPack = seriesById('osnovit-mc11').packKg;
const rlPack = seriesById('perel-rl').packKg;
const xcPack = seriesById('osnovit-xc30').packKg;
const osWall = O.wall.replace('1/2', '½');

const rlCond = R.basis.match(/в зависимости[^.]*/)?.[0] ?? '';
if (!rlCond) throw new Error('Калькулятор: в норме Perel RL нет условия «в зависимости…»');
const rlJoint = SERIES_FACTS['perel-rl'].specs.find((f) => f.label === 'Ширина шва');

// Пример под таблицей Perel — тот же расчёт, что в калькуляторе: 1 000 кирпичей первого формата.
const ex = P.perBrick[0];
const EX_N = 1000;
const exKgMin = Math.round(EX_N * ex.kgMin * 100) / 100;
const exKgMax = Math.round(EX_N * ex.kgMax * 100) / 100;
const exBagsMax = bags(exKgMax, perelPack);
const exBags = `${bags(exKgMin, perelPack)}–${exBagsMax}\u00a0${plural(exBagsMax, 'мешок', 'мешка', 'мешков')}`;
const bigFmt = P.perBrick.reduce((a, b) => (b.kgMax > a.kgMax ? b : a));
const perelMin = Math.min(...P.perBrick.map((f) => f.kgMin));
const perelMax = Math.max(...P.perBrick.map((f) => f.kgMax));

const osBagsPerM2 = O.kgPerM2 / osPack;
// Пример под нормой Основит — 10 м² кладки, тот же расчёт, что в калькуляторе.
const OS_EX = 10;
const osExKg = Math.round(OS_EX * O.kgPerM2 * 100) / 100;
const osExBags = bags(osExKg, osPack);
const osBagsWord = plural(Math.ceil(osBagsPerM2), 'мешок', 'мешка', 'мешков');
const xcM2PerBag = xcPack / X.kgPerM2;

const faqRaw: FaqItem[] = [
  {
    q: 'Сколько смеси Perel SL, VL, NL уходит на один кирпич?',
    a: `По каталогу Perel — от ${one(perelMin)} до ${one(perelMax)} кг сухой смеси на кирпич, в зависимости от формата: для ${ex.format} (${ex.size} мм) — ${range1(ex.kgMin, ex.kgMax)} кг, для ${bigFmt.format} (${bigFmt.size} мм) — ${range1(bigFmt.kgMin, bigFmt.kgMax)} кг. Норма одна для серий SL, VL и NL; толщину шва производитель в таблице не указывает.`,
  },
  {
    q: 'Сколько мешков Брикформ МС11 нужно на 1 м² кладки?',
    a: `Основит даёт норму ${num(O.kgPerM2)} кг смеси на 1 м² кладки при условии: ${O.joint}, ${osWall}. Это ${num(osBagsPerM2)} ${osBagsWord} по ${osPack} кг на квадратный метр. Норма одна для МС11 и МС11/1.`,
  },
  {
    q: 'Почему Perel считается по кирпичам, а Основит — по площади?',
    a: `Так производители дают нормы: Perel — расход на 1 кирпич по формату, Основит — расход на 1 м² кладки при условии: ${O.joint}, ${osWall}. Калькулятор считает каждую смесь по норме её производителя и не переводит одну норму в другую.`,
  },
  {
    q: 'Сколько затирки Perel RL нужно на 1 м²?',
    a: `${range(R.kgPerM2Min, R.kgPerM2Max)} кг на 1 м² — ${rlCond}.${rlJoint ? ` Затирка рассчитана на швы шириной ${rlJoint.value}.` : ''} Мешок — ${rlPack} кг.`,
  },
  {
    q: 'Сколько раствора Бриксэйв ХС30 нужно для расшивки швов?',
    a: `${one(X.kgPerM2)} кг на 1 м² кладки при условии: ${X.condition}. Мешок — ${xcPack} кг: при этих условиях его хватает примерно на ${num(xcM2PerBag)} м².`,
  },
];

const faq = faqRaw.map((f) => ({ q: nb(f.q), a: nb(f.a) }));

const pageLd = {
  '@type': 'WebPage',
  name: H1,
  description: DESCRIPTION,
  url: liveUrl('smesi', 'kalkulyator'),
  inLanguage: 'ru-RU',
};

const src = { rel: 'nofollow noopener', target: '_blank' } as const;

// Нормы коротко — для первого экрана: те же числа, что в таблицах ниже и в вопросах.
const glance = [
  { name: 'Perel SL, VL, NL', per: 'на 1 кирпич, по формату', value: keep(range1(perelMin, perelMax)) },
  { name: 'Основит Брикформ МС11, МС11/1', per: 'на 1 м² кладки', value: num(O.kgPerM2) },
  { name: 'Perel RL', per: 'на 1 м², затирка швов', value: keep(range(R.kgPerM2Min, R.kgPerM2Max)) },
  { name: 'Основит Бриксэйв ХС30', per: 'на 1 м², расшивка швов', value: one(X.kgPerM2) },
].map((g) => ({ ...g, name: nb(g.name), per: nb(g.per) }));
---

<Page title={TITLE} description={DESCRIPTION} slug="kalkulyator" current="kalkulyator" source="kalkulyator" jsonLd={[pageLd]}>
  <PageHead
    kicker="Расчёт мешков"
    h1={H1}
    crumb="Калькулятор расхода"
    lead="Сколько мешков смеси нужно на вашу кладку — по нормам Perel и Основит. Каждую смесь считаем по методике её производителя: кладочные Perel — на кирпич по формату, Основит Брикформ — на квадратный метр кладки, затирку и расшивку швов — на квадратный метр."
  >
    <div class="hn" slot="aside">
      <p class="hn__cap">Расход по нормам производителей</p>
      <dl class="hn__list">
        {glance.map((g) => (
          <div class="hn__row">
            <dt>{g.name}<span>{g.per}</span></dt>
            <dd><b class="num">{g.value}</b>&nbsp;кг</dd>
          </div>
        ))}
      </dl>
      <a class="arrow-link hn__go" href="#raschet">Посчитать мешки <span aria-hidden="true">↓</span></a>
    </div>
  </PageHead>

  <Section id="raschet" bg="base" pad="sm" aria-label="Расчёт">
    <Calculator id="calc" />
  </Section>

  <Section
    id="normy"
    kicker="Нормы"
    title="Как считают производители"
    subtitle="Нормы — из документов Perel и Основит, у каждой ссылка на источник."
    bg="alt"
  >
    <ol class="norms">
      <li class="norm" data-reveal>
        <div class="norm__head">
          <p class="norm__tag"><span class="norm__n num" aria-hidden="true">01</span>Perel SL, VL, NL&nbsp;·&nbsp;кладка</p>
          <h3 class="norm__title">{typo('На кирпич — по формату')}</h3>
          <p class="norm__text">
            {typo('Расход сухой смеси на один кирпич. Норма одна для трёх серий; толщину шва производитель в таблице не указывает.')}
          </p>
        </div>
        <div class="norm__body">
          <div class="tbl-wrap">
            <table class="tbl tbl--brick">
              <caption class="vh">Расход сухой смеси Perel на 1 кирпич по формату</caption>
              <thead>
                <tr><th scope="col">Формат</th><th scope="col">Размер, мм</th><th scope="col" class="tbl__r">Смеси на 1&nbsp;кирпич, кг</th></tr>
              </thead>
              <tbody>
                {P.perBrick.map((f) => (
                  <tr><th scope="row">{keep(f.format)}</th><td class="num">{f.size}</td><td class="tbl__num tbl__r num">{keep(range1(f.kgMin, f.kgMax))}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <div class="norm__foot">
          <p class="norm__example">
            <span class="norm__ex-label">Пример</span>
            {num(EX_N)}&nbsp;кирпичей {keep(ex.format)} — {keep(range(exKgMin, exKgMax))}&nbsp;кг, это {keep(exBags)} по {perelPack}&nbsp;кг.
          </p>
          <p class="srcline">По данным производителя: <a href={P.src} {...src}>каталог Perel, стр. 7</a></p>
          <p class="norm__links">
            Цвета в каталоге:
            <a href={`${PAGES.katalog.href}#perel-sl`}>SL</a>,
            <a href={`${PAGES.katalog.href}#perel-vl`}>VL</a>,
            <a href={`${PAGES.katalog.href}#perel-nl`}>NL</a>
          </p>
        </div>
      </li>

      <li class="norm" data-reveal>
        <div class="norm__head">
          <p class="norm__tag"><span class="norm__n num" aria-hidden="true">02</span>Основит Брикформ МС11, МС11/1&nbsp;·&nbsp;кладка</p>
          <h3 class="norm__title">{typo('На квадратный метр кладки')}</h3>
        </div>
        <div class="norm__body">
          <p class="norm__big"><b class="num">{num(O.kgPerM2)}</b><span>кг смеси на 1&nbsp;м²</span></p>
          <ul class="norm__cond" aria-label="Условия нормы">
            <li>{nb(O.joint)}</li>
            <li>{nb(osWall)}</li>
          </ul>
        </div>
        <div class="norm__foot">
          <p class="norm__text">
            Норма одна для МС11 и&nbsp;МС11/1. Мешок — {osPack}&nbsp;кг, то есть {num(osBagsPerM2)}&nbsp;{osBagsWord} на&nbsp;квадратный
            метр при этих условиях.
          </p>
          <p class="norm__example">
            <span class="norm__ex-label">Пример</span>
            {OS_EX}&nbsp;м² кладки — {num(osExKg)}&nbsp;кг, это {osExBags}&nbsp;{plural(osExBags, 'мешок', 'мешка', 'мешков')} по {osPack}&nbsp;кг.
          </p>
          <p class="srcline">По данным производителя: <a href={O.src} {...src}>страница Брикформ МС11, osnovit.ru</a></p>
          <p class="norm__links">
            Цвета в каталоге:
            <a href={`${PAGES.katalog.href}#osnovit-mc11`}>МС11</a>,
            <a href={`${PAGES.katalog.href}#osnovit-mc11-1`}>МС11/1</a>
          </p>
        </div>
      </li>

      <li class="norm" data-reveal>
        <div class="norm__head">
          <p class="norm__tag"><span class="norm__n num" aria-hidden="true">03</span>Perel RL&nbsp;·&nbsp;Основит Бриксэйв ХС30</p>
          <h3 class="norm__title">{typo('Затирка и расшивка швов — на 1 м²')}</h3>
        </div>
        <div class="norm__body">
          <div class="tbl-wrap">
            <table class="tbl tbl--joints">
              <caption class="vh">Расход растворов для затирки и расшивки швов на 1 м²</caption>
              <thead>
                <tr><th scope="col">Смесь</th><th scope="col">Расход на 1&nbsp;м²</th><th scope="col">Условие нормы</th><th scope="col">Мешок</th></tr>
              </thead>
              <tbody>
                <tr>
                  <th scope="row"><a href={`${PAGES.katalog.href}#perel-rl`}>Perel RL</a> <span class="tbl__use">затирка</span></th>
                  <td data-label="Расход на 1 м²" class="tbl__num num">{range(R.kgPerM2Min, R.kgPerM2Max)}&nbsp;кг</td>
                  <td data-label="Условие нормы">{nb(rlCond)}</td>
                  <td data-label="Мешок" class="tbl__num num">{rlPack}&nbsp;кг</td>
                </tr>
                <tr>
                  <th scope="row"><a href={`${PAGES.katalog.href}#osnovit-xc30`}>Основит Бриксэйв ХС30</a> <span class="tbl__use">расшивка</span></th>
                  <td data-label="Расход на 1 м²" class="tbl__num num">{one(X.kgPerM2)}&nbsp;кг</td>
                  <td data-label="Условие нормы">{nb(X.condition)}</td>
                  <td data-label="Мешок" class="tbl__num num">{xcPack}&nbsp;кг</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="norm__foot">
          <p class="srcline">
            По данным производителей: <a href={R.src} {...src}>{keep('карточка Perel RL, td-perel.ru')}</a> ·
            <a href={X.src} {...src}>страница Бриксэйв ХС30, osnovit.ru</a>
          </p>
        </div>
      </li>
    </ol>

    <div class="why" data-reveal>
      <h3 class="why__title">{typo('Почему без общей формулы')}</h3>
      <p>
        {typo('В норме Perel нет толщины шва, в норме Основит — формата кирпича. Чтобы перевести одну в другую, пришлось бы досчитывать то, чего производитель не указал. Поэтому калькулятор считает каждую смесь только по норме её производителя — без своих коэффициентов и надбавок, а мешки округляет вверх до целого.')}
      </p>
    </div>
  </Section>

  <Section id="voprosy" kicker="Вопросы" title="Частые вопросы о расходе" bg="base">
    <FaqAccordion items={faq} site="smesi" slug="kalkulyator" />
  </Section>

  <CtaBand
    source="kalkulyator"
    title={typo('Посчитаем мешки под ваш проект')}
    text={typo('Назовите кирпич, его количество или площадь кладки — подскажем серию и цвет шва, назовём цену и наличие.').replace(/ — /g, '\u00a0— ')}
  />
</Page>

<style is:global>
  /* Сквозная проверка дизайна 11.10: итог калькулятора стоял залитой плашкой (--paper-2) — единственный
     «короб» на сайте, где всё разделяют линии. Итог — третий шаг бланка: без заливки и отступов коробки,
     его отделяет та же линия под подписью «03 Понадобится», что и шаги 01–02. */
  html[data-site='smesi'] #raschet .calc__out { padding: 0; background: none; }
</style>

<style>
  /* Нормы (редизайн 11.10): не карточки, а записи через линии — слева номер, подпись и пояснение,
     справа таблица или крупная цифра. Сетка 5/7. */
  .norms { margin: 0; padding: 0; list-style: none; }
  /* Запись: шапка (номер, подпись, заголовок) → норма (таблица или цифра) → пояснение и источник.
     На десктопе норма справа во всю высоту записи, пояснение — под шапкой слева. */
  .norm {
    display: grid;
    grid-template-areas: 'head' 'body' 'foot';
    gap: var(--space-5);
    padding: clamp(32px, 4vw, 56px) 0;
    border-top: 1px solid var(--hair-strong);
  }
  .norm:first-child { padding-top: clamp(24px, 3vw, 40px); }
  .norm:last-child { padding-bottom: 0; }
  @media (min-width: 960px) {
    .norm {
      grid-template-areas: 'head body' 'foot body';
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      gap: var(--space-5) clamp(40px, 5vw, 88px);
      align-items: start;
    }
  }
  .norm__head { grid-area: head; display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .norm__foot { grid-area: foot; display: flex; flex-direction: column; gap: var(--space-3); min-width: 0; }
  .norm__body { grid-area: body; min-width: 0; }
  .norm__tag {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0;
    font-size: var(--fs-tiny);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .norm__n { letter-spacing: 0.04em; color: var(--ink); }
  .norm__title {
    margin: var(--space-2) 0 var(--space-1);
    font-size: clamp(30px, 3vw, 44px);
    line-height: 1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .norm__text { margin: 0; max-width: 46ch; color: var(--color-text-soft); }
  .norm__example { margin: 0; padding-top: var(--space-3); border-top: 1px solid var(--hair); max-width: 46ch; }
  /* На телефоне пример идёт сразу под таблицей — её нижняя линия уже отделяет его */
  @media (max-width: 959px) { .norm__foot > .norm__example:first-child { padding-top: 0; border-top: 0; } }
  .norm__ex-label {
    display: block;
    margin-bottom: 4px;
    font-size: var(--fs-tiny);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .norm__links { margin: 0; font-size: var(--fs-small); color: var(--color-text-soft); }
  .norm__links a, .srcline a, .tbl a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--hair-strong); }
  .norm__links a:hover, .srcline a:hover, .tbl a:hover { text-decoration-color: var(--ink); }

  .srcline { margin: 0; font-size: 14px; color: var(--color-muted); }

  /* Основит: крупная цифра нормы и условия строками через линии */
  .norm__big { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px; margin: 0; }
  .norm__big b { font-family: var(--font-head); font-weight: 500; font-size: clamp(96px, 12vw, 176px); line-height: 0.8; letter-spacing: -0.04em; }
  .norm__big span { font-size: var(--fs-lead); color: var(--color-text-soft); }
  .norm__cond { margin: clamp(24px, 3vw, 40px) 0 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .norm__cond li { padding: 14px 0; border-bottom: 1px solid var(--hair); font-family: var(--font-head); font-size: clamp(22px, 2vw, 28px); line-height: 1.1; }

  /* Таблицы — строки через линии, номер формата антиквой */
  .tbl-wrap { max-width: 100%; }
  .tbl { width: 100%; border-collapse: collapse; font-size: var(--fs-small); }
  .tbl th, .tbl td { padding: 14px var(--space-4) 14px 0; border-bottom: 1px solid var(--hair); text-align: left; vertical-align: baseline; }
  .tbl th:last-child, .tbl td:last-child { padding-right: 0; }
  .tbl thead th { padding-top: 0; font-size: var(--fs-tiny); font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); border-bottom-color: var(--hair-strong); }
  .tbl tbody th { font-weight: 500; }
  .tbl__num { white-space: nowrap; font-weight: 500; }
  .tbl .tbl__r { text-align: right; }
