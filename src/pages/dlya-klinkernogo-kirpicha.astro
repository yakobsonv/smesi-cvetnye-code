---
// Кладочная смесь для клинкерного кирпича (план, волна 1). Угол страницы: у клинкера низкое
// водопоглощение — поэтому смесь под него своя; что подходит у Perel и у Основит.
//
// ФАКТЫ — только из данных:
//   - назначение и «для какого кирпича» — дословно SERIES_FACTS[…].purpose / .forBrick
//     (Perel NL: td-perel.ru; Основит Брикформ МС11 — блок «Рекомендуемые материалы» на osnovit.ru);
//   - диапазоны водопоглощения на шкале — строки «Водопоглощение кирпича» из SERIES_FACTS[…].specs,
//     зона клинкера — BRICK_TYPES.klinker (подраздел дилера «Клинкерный кирпич 0–5 %»);
//   - какие серии подходят к клинкеру — seriesFor('klinker') (Perel NL, Dauer BRICK.COLOR 252 + Основит МС11 через ALSO_FOR);
//   - Dauer (с 24.10): BRICK.COLOR 252 — «Для клинкерного кирпича с водопоглощением от 1 до 5%» (карточка dauer.ru);
//   - МС11/1 к клинкеру НЕ относим (DISCREPANCIES в series-facts.ts);
//   - расшивка готовой кладки — Основит Бриксэйв ХС30: в его forBrick (блок «Рекомендуемые основания»
//     на osnovit.ru, сверено 11.10) назван клинкерный кирпич; в purpose ХС30 клинкерного кирпича НЕТ;
//   - цвета и фасовка — ассортимент дилера (catalog.ts), расход — CONSUMPTION.
// Кадров кладки здесь нет: визуализаций клинкера в материалах клиента нет. Цен нет (catalog.ts).
// Зимние модификации не показываем: возит ли их дилер — неизвестно (series-facts.ts).
//
// Вид (редизайн 11.10, язык «палитра шва»): без карточек-коробок — разделение тонкими линиями;
// шкала водопоглощения — линия 0–20 % с зоной клинкера песком и диапазонами серий тушью;
// цитаты производителей — курсивом антиквы с подписью-источником. Цвет на странице дают только
// плашки раствора. Ось 0–20 % — оформление графика, а не данные: границы диапазонов на оси —
// из строк «Водопоглощение кирпича» самих производителей.
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import SeriesCard from '../components/smesi/SeriesCard.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import SpecTable from '../components/content/SpecTable.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import { BRICK_TYPES, POSITIONS, seriesById, seriesFor, seriesHref, type FactSeriesId, type SeriesId } from '../data/catalog';
import { SERIES_FACTS, CONSUMPTION, factsOf, type Fact } from '../data/series-facts';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { plural } from '../lib/format';
import { nb as typoNb } from '../lib/typo';
// Пробел перед «—» — неразрывный: тире не начинает строку (сквозная проверка дизайна 11.10).
const nb = (t: string) => typoNb(t).replace(/ — /g, '\u00a0— ');
import type { FaqItem, SpecRow } from '../lib/types';

const SLUG = 'dlya-klinkernogo-kirpicha';
const KL = BRICK_TYPES.klinker;

const nl = seriesById('perel-nl');
const mc11 = seriesById('osnovit-mc11');
const mc111 = seriesById('osnovit-mc11-1');
const sl = seriesById('perel-sl');
const vl = seriesById('perel-vl');
const xc30 = seriesById('osnovit-xc30');
const d252 = seriesById('dauer-252');
const F = SERIES_FACTS;

const klinkerIds = seriesFor('klinker').map((s) => s.id);
const klinkerPositions = POSITIONS.filter((p) => klinkerIds.includes(p.series));
const colorsWord = (n: number) => `${n} ${plural(n, 'цвет', 'цвета', 'цветов')}`;
const kg = (n: number) => n.toFixed(1).replace('.', ',');

const LABEL_ABS = 'Водопоглощение кирпича';
const absOf = (id: SeriesId): Fact => {
  const f = factsOf(id).specs.find((x) => x.label === LABEL_ABS);
  if (!f) throw new Error(`Нет строки «${LABEL_ABS}» у ${id}`);
  return f;
};

/** «0–5 %» → 0…5; «до 12 %…» → 0…12; «более 12 %…» → 12…открыто. */
function parseRange(v: string): { from: number; to: number | null } {
  const range = v.match(/(\d+)\s*[–-]\s*(\d+)/);
  if (range) return { from: Number(range[1]), to: Number(range[2]) };
  const upTo = v.match(/^до\s*(\d+)/);
  if (upTo) return { from: 0, to: Number(upTo[1]) };
  const above = v.match(/^более\s*(\d+)/);
  if (above) return { from: Number(above[1]), to: null };
  throw new Error(`Не разобрать диапазон «${v}»`);
}

// ── Шкала водопоглощения: на какой кирпич рассчитана каждая кладочная серия ──────────
const scaleIds: FactSeriesId[] = ['perel-nl', 'perel-sl', 'perel-vl', 'osnovit-mc11', 'osnovit-mc11-1', 'dauer-252', 'dauer-250', 'dauer-251'];
const parsed = scaleIds.map((id) => ({ id, value: absOf(id).value, ...parseRange(absOf(id).value) }));
// Ось — 0–20 %: с запасом над самой верхней границей в данных (17 % у VL), чтобы открытый
// диапазон «более 12 %» было куда продолжить. Если в данных появится граница выше — ось растянется.
const scaleMax = Math.max(20, ...parsed.map((r) => r.to ?? r.from));
const pct = (n: number) => `${((n / scaleMax) * 100).toFixed(2)}%`;
const zone = parseRange(KL.absorption);
const scaleRows = parsed.map((r) => ({
  ...r,
  name: seriesById(r.id).name,
  open: r.to === null,
  klinker: klinkerIds.includes(r.id),
  style: `--from:${pct(r.from)};--to:${pct(r.to ?? scaleMax)}`,
}));
// Деления оси — границы диапазонов из данных + концы оси
const ticks = [...new Set([0, ...parsed.flatMap((r) => [r.from, r.to]).filter((n): n is number => n !== null), zone.from, zone.to ?? 0, scaleMax])].sort((a, b) => a - b);
const zoneStyle = `--from:${pct(zone.from)};--to:${pct(zone.to ?? scaleMax)}`;

// Источники шкалы: у Perel все три диапазона названы на странице подбора по водопоглощению,
// у Основит — на страницах МС11 и МС11/1, у Dauer — на карточках 250, 251, 252.
const scaleSrc = [
  { href: F['perel-nl'].forBrickSrc, label: 'серии Perel на td-perel.ru' },
  { href: absOf('osnovit-mc11').src, label: 'Брикформ МС11 на osnovit.ru' },
  { href: absOf('osnovit-mc11-1').src, label: 'Брикформ МС11/1 на osnovit.ru' },
  { href: absOf('dauer-252').src, label: 'BRICK.COLOR 252 на dauer.ru' },
  { href: absOf('dauer-250').src, label: 'BRICK.COLOR 250 на dauer.ru' },
  { href: absOf('dauer-251').src, label: 'BRICK.COLOR 251 на dauer.ru' },
];

// ── Характеристики: ключевые строки производителя ─────────────────────────────────
function pick(id: FactSeriesId, labels: string[]): { rows: SpecRow[]; srcs: string[] } {
  const facts = labels
    .map((l) => F[id].specs.find((f) => f.label === l))
    .filter((f): f is Fact => Boolean(f));
  return { rows: facts.map((f) => ({ label: f.label, value: f.value })), srcs: [...new Set(facts.map((f) => f.src))] };
}

const nlSpecs = pick('perel-nl', [
  LABEL_ABS,
  'Прочность на сжатие',
  'Адгезия (сцепление с основанием)',
  'Морозостойкость',
  'Жизнеспособность раствора',
  'Вода затворения',
  'Температура применения',
]);
const mc11Specs = pick('osnovit-mc11', [
  LABEL_ABS,
  'Прочность на сжатие',
  'Сцепление с основанием',
  'Морозостойкость',
  'Жизнеспособность раствора',
  'Вода затворения',
  'Толщина шва',
  'Температура применения',
]);
const d252Specs = pick('dauer-252', [
  LABEL_ABS,
  'Прочность на сжатие',
  'Прочность при сдвиге',
  'Морозостойкость',
  'Жизнеспособность раствора',
  'Вода затворения',
  'Толщина шва',
  'Температура применения',
]);

// «до 12 %, а также клинкерный кирпич» → ['до 12 %', 'а также клинкерный кирпич'] — для плашки
const mc11Abs = (() => {
  const v = absOf('osnovit-mc11').value;
  const i = v.indexOf(',');
  return i > 0 ? [v.slice(0, i).trim(), v.slice(i + 1).trim()] : [v, 'водопоглощение кирпича'];
})();

const srcName = (href: string) => {
  const host = new URL(href).hostname;
  if (href.toLowerCase().includes('.pdf')) return `техническая карта, ${host}`;
  return host;
};

// ── Расшивка готовой кладки: Бриксэйв ХС30 ───────────────────────────────────────
const xcFacts = F['osnovit-xc30'];
const xcCons = CONSUMPTION.osnovitXc30;
const xcPoints = [
  { text: 'Кладка должна выстояться не менее 3–4 недель — за это время кладочный раствор набирает марочную прочность. Швы расчищают на одинаковую глубину, не менее 1,5–2 см.', src: xcFacts.steps[0].src },
  { text: `Расход — ${kg(xcCons.kgPerM2)} кг на 1 м² кладки (${xcCons.condition}).`, src: xcCons.src },
  { text: xcFacts.notes?.[0]?.text ?? '', src: xcFacts.notes?.[0]?.src ?? '' },
].filter((p) => p.text);
const xcSrcs = [...new Set(xcPoints.map((p) => p.src))];
const xcHref = seriesHref(xc30);

// ── Вопросы и ответы: только факты из данных ─────────────────────────────────────
const perelBrick = CONSUMPTION.perel.perBrick
  .map((r) => `${r.format} (${r.size}) — ${kg(r.kgMin)}–${kg(r.kgMax)} кг`)
  .join('; ');
const brikformTiming = F['osnovit-mc11'].steps.find((s) => s.text.startsWith('Расшивку начинать'));
const brikformTrial = F['osnovit-mc11'].steps.find((s) => s.text.startsWith('Перед расшивкой'));

const faq: FaqItem[] = [
  {
    q: 'Подойдёт ли для клинкера смесь для обычного облицовочного кирпича?',
    a: `Зависит от производителя. У Perel для клинкера отдельная серия — NL, она рассчитана на кирпич с водопоглощением ${absOf('perel-nl').value}; ${sl.name} — на ${absOf('perel-sl').value}, ${vl.name} — на ${absOf('perel-vl').value}. У Основит клинкерный кирпич назван в назначении Брикформ МС11 — того же раствора, что и для керамического и силикатного облицовочного кирпича с водопоглощением до 12 %. Брикформ МС11/1 производитель рекомендует для кирпича с водопоглощением более 12 % и кирпича ручной формовки. У Dauer для клинкера отдельная смесь — BRICK.COLOR 252 (${absOf('dauer-252').value}); 250 и 251 рассчитаны на кирпич с водопоглощением ${absOf('dauer-250').value} и ${absOf('dauer-251').value}.`,
  },
  {
    q: 'Чем BRICK.COLOR 252 отличается от других смесей Dauer?',
    a: `Кирпичом и прочностью. Производитель пишет о 252: «${F['dauer-252'].forBrick}». Прочность на сжатие у неё ${F['dauer-252'].specs.find((f) => f.label === 'Прочность на сжатие')?.value}, морозостойкость — ${F['dauer-252'].specs.find((f) => f.label === 'Морозостойкость')?.value}; у 250 и 251 — ${F['dauer-250'].specs.find((f) => f.label === 'Прочность на сжатие')?.value} и ${F['dauer-250'].specs.find((f) => f.label === 'Морозостойкость')?.value}. Палитра у трёх смесей одна — ${colorsWord(d252.colors.length)}, мешки 25 и 50 кг.`,
  },
  {
    q: 'Чем отличаются Perel NL и Основит Брикформ МС11?',
    a: `Perel NL производитель разработал специально для облицовки кирпичом с низким водопоглощением, от 0 до 5 %. Брикформ МС11 — раствор для керамического, силикатного и клинкерного облицовочного кирпича с возможностью расшивки швов в момент укладки. У нас ${nl.name} — ${colorsWord(nl.colors.length)} в мешках по ${nl.packKg} кг, ${mc11.name} — ${colorsWord(mc11.colors.length)} в мешках по ${mc11.packKg} кг.`,
  },
  {
    q: 'Сколько смеси нужно на клинкерную кладку?',
    a: `Производители считают по-разному. Perel даёт расход сухой смеси на один кирпич по формату, норма одна для SL, VL и NL (толщина шва в таблице не указана): ${perelBrick}. Основит — ${CONSUMPTION.osnovit.kgPerM2} кг на 1 м² кладки (${CONSUMPTION.osnovit.joint}, ${CONSUMPTION.osnovit.wall}). Сколько это мешков, посчитает <a href="${PAGES.kalkulyator.href}">калькулятор расхода</a>.`,
  },
  ...(brikformTiming && brikformTrial
    ? [{
        q: 'Когда расшивать шов при кладке на Брикформ МС11?',
        a: 'По технической карте Основит расшивку начинают после начала схватывания раствора — время зависит от температуры, влажности и впитывающей способности кирпича. Шов не переувлажняют и расшивают быстрыми движениями, без долгого «перетирания». Перед работой производитель советует пробную расшивку на небольшом участке — убедиться, что инструмент не меняет цвет шва.',
      }]
    : []),
  {
    q: 'Можно ли сделать цветной шов на уже готовой клинкерной кладке?',
    a: `Да, раствором для расшивки: среди рекомендуемых оснований для Основит Бриксэйв ХС30 производитель называет клинкерный облицовочный кирпич. Расшивают не раньше чем через 3–4 недели после кладки, когда кладочный раствор наберёт марочную прочность, — швы перед этим расчищают не меньше чем на 1,5–2 см. Расход — ${kg(xcCons.kgPerM2)} кг на 1 м² кладки. У нас ${colorsWord(xc30.colors.length)} в мешках по ${xc30.packKg} кг.`,
  },
];

const itemList = {
  '@type': 'ItemList',
  name: 'Кладочные смеси для клинкерного кирпича',
  numberOfItems: klinkerPositions.length,
  itemListElement: klinkerPositions.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title })),
};

const picks = [nl, mc11, d252].map((s) => ({
  s,
  href: `#${s.id}`,
  abs: absOf(s.id).value,
  strip: s.colors.map((c) => swatchFor(s.id, c.code)),
}));


// Ключевые цифры серии — строкой через линии (цвета у нас, мешок, водопоглощение кирпича)
const keyFacts = {
  nl: [
    { v: String(nl.colors.length), l: `${plural(nl.colors.length, 'цвет', 'цвета', 'цветов')} у нас` },
    { v: `${nl.packKg} кг`, l: 'мешок' },
    { v: absOf('perel-nl').value, l: 'водопоглощение кирпича' },
  ],
  mc11: [
    { v: String(mc11.colors.length), l: `${plural(mc11.colors.length, 'цвет', 'цвета', 'цветов')} у нас` },
    { v: `${mc11.packKg} кг`, l: 'мешок' },
    { v: mc11Abs[0], l: 'водопоглощение кирпича, а также клинкер' },
  ],
  d252: [
    { v: String(d252.colors.length), l: `${plural(d252.colors.length, 'цвет', 'цвета', 'цветов')} в палитре` },
    { v: '25 и 50 кг', l: 'мешок у производителя' },
    { v: absOf('dauer-252').value, l: 'водопоглощение кирпича' },
  ],
};
const colorsTitle = (n: number, name: string) => `${n} ${plural(n, 'цвет', 'цвета', 'цветов')} ${name}`;
const two = (n: number) => String(n).padStart(2, '0');
// Дословная цитата: только неразрывные пробелы (nb) и ещё один — перед дефисом-тире «0% - до 5%»,
// чтобы строка не начиналась с дефиса. Буквы и знаки цитаты не меняются.
const qt = (t: string) => nb(t).replace(/ (?=[-–—] )/g, '\u00a0');
---

<Page
  title="Кладочная смесь для клинкерного кирпича — Perel NL, Основит МС11, Dauer 252"
  description={`Цветные кладочные смеси для клинкера с водопоглощением ${KL.absorption}: Perel NL — ${colorsWord(nl.colors.length)}, Основит Брикформ МС11 — ${colorsWord(mc11.colors.length)}, Dauer BRICK.COLOR 252 — ${colorsWord(d252.colors.length)}. Расшивка готовой кладки, Москва и МО.`}
  slug={SLUG}
  current="klinker"
  source="klinker"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Клинкерный кирпич"
    h1="Кладочная смесь для клинкерного кирпича"
    crumb="Для клинкерного кирпича"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={`У клинкерного кирпича низкое водопоглощение — ${KL.absorption}. Для него у Perel есть отдельная серия NL, у Dauer — смесь BRICK.COLOR 252, а у Основит клинкер назван в назначении Брикформ МС11. У нас ${colorsWord(nl.colors.length)} NL, ${colorsWord(mc11.colors.length)} МС11 и ${colorsWord(d252.colors.length)} BRICK.COLOR 252 — нажмите на образец, чтобы узнать цену и наличие.`}
  >
    <div class="kh" slot="aside">
      <p class="kh__big num">{nb(KL.absorption)}</p>
      <p class="label kh__cap">водопоглощение клинкерного кирпича</p>
      <ol class="kh__list" data-reveal-stagger>
        {picks.map((p) => (
          <li>
            <a class="kh__pick" href={p.href}>
              <span class="kh__strip strip" aria-hidden="true">{p.strip.map((c) => <span class="mortar" style={`--c:${c}`}></span>)}</span>
              <span class="kh__name">{p.s.name}</span>
              <span class="kh__go" aria-hidden="true">↓</span>
              <span class="kh__meta">водопоглощение кирпича: <span class="num">{nb(p.abs)}</span> · {colorsWord(p.s.colors.length)} · мешок {p.s.packKg}&nbsp;кг</span>
            </a>
          </li>
        ))}
      </ol>
      <a class="arrow-link kh__more" href="#rasshivka">Кладка уже готова — расшивка {xc30.name} <span aria-hidden="true">↓</span></a>
    </div>
  </PageHead>

  <Section
    id="pochemu"
    kicker="01 — Водопоглощение"
    title="Почему клинкеру нужна своя смесь"
    subtitle="Главное условие подбора кладочной смеси у Perel — водопоглощение кирпича, то есть сколько воды он впитывает. У клинкера оно низкое, от 0 до 5 %, и все три производителя с данными в нашем каталоге называют такой кирпич отдельно."
    bg="base"
  >
    <figure class="sc" data-reveal>
      <figcaption class="sc__top">
        <span class="sc__cap">{nb('На какое водопоглощение кирпича рассчитана смесь')}</span>
        <span class="sc__legend">
          <span class="sc__key"><i class="sc__key-zone" aria-hidden="true"></i>зона клинкера, {nb(KL.absorption)}</span>
          <span class="sc__key"><i class="sc__key-bar" aria-hidden="true"></i>смеси, которые производитель называет для клинкера</span>
        </span>
      </figcaption>

      <div class="sc__plot">
        <div class="sc__row sc__row--head" aria-hidden="true">
          <span class="sc__name"></span>
          <span class="sc__track">
            <span class="sc__zone" style={zoneStyle}></span>
            <span class="sc__zlabel label" style={zoneStyle}>Клинкер</span>
          </span>
        </div>
        <ul class="sc__rows">
          {scaleRows.map((r) => (
            <li class:list={['sc__row', r.klinker && 'is-klinker']}>
              <span class="sc__name"><span class="sc__nm">{r.name}</span><span class="sc__val">{nb(r.value)}</span></span>
              <span class="sc__track" aria-hidden="true">
                <span class="sc__zone" style={zoneStyle}></span>
                {ticks.map((t) => <span class="sc__gl" style={`--x:${pct(t)}`}></span>)}
                <span class:list={['sc__bar', r.open && 'is-open']} style={r.style}></span>
              </span>
            </li>
          ))}
        </ul>
