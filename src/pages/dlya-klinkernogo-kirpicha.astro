<style>
  /* ── первый экран: «0–5 %» крупно и две смеси под клинкер строками через линии ── */
  .kh { display: grid; }
  .kh__big {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(64px, 7vw, 108px);
    line-height: 0.85;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .kh__cap { margin: var(--space-3) 0 var(--space-6); }
  .kh__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .kh__list li { border-bottom: 1px solid var(--hair); }
  .kh__pick {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 6px var(--space-4);
    align-items: baseline;
    padding: var(--space-4) 0 var(--space-5);
    color: var(--ink);
    text-decoration: none;
  }
  .kh__strip { grid-column: 1 / -1; height: 40px; margin-bottom: var(--space-3); }
  .kh__strip span { transition: flex-grow 0.5s var(--ease); }
  .kh__pick:hover .kh__strip span:hover { flex-grow: 2.4; }
  .kh__name { font-family: var(--font-head); font-weight: 500; font-size: clamp(26px, 2.2vw, 32px); line-height: 1; letter-spacing: -0.01em; }
  .kh__go { font-size: 22px; line-height: 1; transition: translate 0.4s var(--ease); }
  .kh__meta { grid-column: 1 / -1; font-size: var(--fs-small); color: var(--color-muted); }
  .kh__pick:hover .kh__name { font-style: italic; }
  .kh__pick:hover .kh__go { translate: 0 4px; }
  .kh__pick:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .kh__more { justify-self: start; margin-top: var(--space-5); font-size: var(--fs-small); }

  /* ── общие мелочи ── */
  .src { margin: var(--space-4) 0 0; font-size: var(--fs-tiny); color: var(--color-muted); }
  .src a { color: inherit; white-space: nowrap; }

  /* Дословная цитата производителя: курсив антиквы, подпись-источник мелко; без плашки и полосы */
  .q { margin: 0; }
  .q p { margin: 0; max-width: 38ch; font-family: var(--font-head); font-style: italic; font-weight: 500; font-size: clamp(22px, 1.9vw, 27px); line-height: 1.22; letter-spacing: -0.005em; color: var(--ink); }
  .q footer { margin-top: var(--space-3); font-size: var(--fs-tiny); color: var(--color-muted); }
  .q footer a { color: inherit; white-space: nowrap; }
  .q--lead p { max-width: none; font-size: clamp(23px, 2vw, 29px); }

  /* ── шкала водопоглощения: линия 0–20 %, зона клинкера песком, диапазоны серий тушью ── */
  .sc { margin: 0; }
  .sc__top {
    display: grid;
    gap: var(--space-3) var(--space-7);
    padding-bottom: var(--space-5);
  }
  .sc__cap { font-family: var(--font-head); font-weight: 500; font-size: var(--fs-h3); line-height: 1.05; letter-spacing: -0.01em; max-width: 22ch; }
  .sc__legend { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); align-self: end; font-size: var(--fs-tiny); color: var(--color-text-soft); }
  .sc__key { display: inline-flex; align-items: center; gap: 10px; }
  .sc__key i { display: inline-block; flex: none; }
  .sc__key-zone { width: 22px; height: 14px; background: var(--sand); }
  .sc__key-bar { width: 22px; height: 5px; background: var(--ink); }

  .sc__plot { --nw: 0px; --g: 0px; border-top: 1px solid var(--hair-strong); }
  .sc__rows { margin: 0; padding: 0; list-style: none; }
  .sc__row { display: grid; grid-template-columns: minmax(0, 1fr); }
  .sc__rows .sc__row { row-gap: 10px; padding: var(--space-4) 0 var(--space-5); border-bottom: 1px solid var(--hair); }
  .sc__name { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 12px; min-width: 0; }
  .sc__nm { font-family: var(--font-head); font-weight: 500; font-size: clamp(22px, 1.8vw, 26px); line-height: 1.05; color: var(--color-text-soft); }
  .sc__val { font-size: var(--fs-tiny); color: var(--color-muted); }
  .is-klinker .sc__nm { color: var(--ink); }
  .is-klinker .sc__val { color: var(--color-text-soft); }

  .sc__track { position: relative; display: block; min-height: 30px; }
  .sc__zone { position: absolute; top: 0; bottom: 0; left: var(--from); width: calc(var(--to) - var(--from)); background: color-mix(in srgb, var(--sand) 72%, transparent); }
  .sc__gl { position: absolute; top: 0; bottom: 0; left: var(--x); width: 1px; translate: -0.5px 0; background: var(--hair); }
  .sc__bar {
    position: absolute;
    top: 50%;
    left: var(--from);
    width: calc(var(--to) - var(--from));
    height: 2px;
    translate: 0 -50%;
    background: var(--hair-strong);
    color: var(--hair-strong);
  }
  /* засечки на концах диапазона — как на мерной линейке */
  .sc__bar::before,
  .sc__bar::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 1px;
    height: 14px;
    translate: 0 -50%;
    background: currentColor;
  }
  .sc__bar::before { left: 0; }
  .sc__bar::after { right: 0; }
  .is-klinker .sc__bar { height: 5px; background: var(--ink); color: var(--ink); }
  .is-klinker .sc__bar::before, .is-klinker .sc__bar::after { width: 2px; height: 20px; }
  /* «более 12 %» — без правой засечки, линия уходит в бумагу */
  .sc__bar.is-open::after { display: none; }
  .sc__bar.is-open { -webkit-mask-image: linear-gradient(90deg, #000 55%, transparent); mask-image: linear-gradient(90deg, #000 55%, transparent); }

  .sc__row--head { display: none; }
  .sc__zlabel { position: absolute; left: var(--from); bottom: 8px; padding-left: 10px; color: var(--ink); white-space: nowrap; }

  .sc__row--axis { padding-top: 8px; }
  .sc__row--axis .sc__name { display: none; }
  .sc__ticks { min-height: 20px; }
  .sc__tick { position: absolute; top: 0; left: var(--x); translate: -50% 0; font-size: var(--fs-tiny); color: var(--color-muted); white-space: nowrap; }
  .sc__tick.is-first { translate: 0 0; }
  .sc__tick.is-last { translate: -100% 0; }
  /* деления ближе 2 % к соседу (1, 6, 18 — границы серий Dauer) на телефоне не подписываем: «17 18 20 %» слипались (QA 24.10) */
  @media (max-width: 599px) { .sc__tick.is-crowded { display: none; } }
  .sc .src { margin-top: var(--space-5); }

  @media (min-width: 720px) {
    .sc__plot { --nw: 220px; --g: 32px; }
    .sc__row { grid-template-columns: var(--nw) minmax(0, 1fr); column-gap: var(--g); }
    .sc__rows .sc__row { padding: 0; }
    .sc__rows .sc__name { flex-direction: column; align-items: flex-start; gap: 4px; padding: 18px 0; }
    .sc__rows .sc__track { min-height: 76px; }
    .sc__row--head { display: grid; }
    .sc__row--head .sc__track { min-height: 44px; }
    .sc__row--axis .sc__name { display: block; padding-top: 1px; }
  }
  @media (min-width: 1000px) {
    .sc__top { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
    .sc__legend { flex-direction: column; justify-self: end; }
  }

  /* ── цитаты производителей и «паспорт кирпича» ── */
  .why { margin-top: clamp(56px, 7vw, 104px); row-gap: var(--space-7); }
  .why__quotes { grid-column: 1 / -1; display: grid; border-top: 1px solid var(--hair-strong); }
  .why__quotes .q { padding: var(--space-5) 0 var(--space-6); border-bottom: 1px solid var(--hair); }
  .why__pass { grid-column: 1 / -1; display: grid; gap: var(--space-3); justify-items: start; align-content: start; padding-top: var(--space-4); border-top: 1px solid var(--hair-strong); }
  .why__pass .label { margin: 0; }
  .why__title { margin: 0; font-size: var(--fs-h3); line-height: 1.05; letter-spacing: -0.01em; }
  .why__pass p:not(.label) { margin: 0; max-width: 44ch; color: var(--color-text-soft); }
  .why__pass .arrow-link { margin-top: var(--space-2); }
  @media (min-width: 1000px) {
    .why__quotes { grid-column: 1 / span 7; }
    .why__pass { grid-column: 9 / -1; }
  }

  /* ── серия: назначение и цифры слева, характеристики справа; без рамок ── */
  .ser { row-gap: var(--space-7); align-items: start; }
  .ser__intro { grid-column: 1 / -1; display: grid; gap: var(--space-6); justify-items: start; min-width: 0; }
  .ser__specs { grid-column: 1 / -1; min-width: 0; }
  .ser__label { margin: 0 0 var(--space-3); }
  .ser__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); }
  .ser__note { max-width: 52ch; margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--hair); font-size: var(--fs-small); color: var(--color-text-soft); }
  .ser__note a { color: inherit; }

  /* цифры серии: на телефоне строки «подпись — значение», с 600 px — три колонки через линии */
  .kf { width: 100%; margin: 0; border-top: 1px solid var(--hair-strong); }
  .kf div { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4); padding: 12px 0; border-bottom: 1px solid var(--hair); }
  .kf dt { font-size: var(--fs-small); color: var(--color-muted); }
  .kf dd { margin: 0; font-family: var(--font-head); font-weight: 500; font-size: 26px; line-height: 1; text-align: right; white-space: nowrap; }
  @media (min-width: 600px) {
    .kf { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--hair); }
    .kf div { flex-direction: column-reverse; justify-content: flex-end; align-items: flex-start; gap: 8px; padding: var(--space-4) var(--space-4) var(--space-4) 0; border-bottom: 0; }
    .kf div + div { padding-left: var(--space-4); border-left: 1px solid var(--hair); }
    .kf dt { font-size: var(--fs-tiny); letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.35; }
    .kf dd { font-size: clamp(34px, 3vw, 46px); text-align: left; white-space: normal; }
  }

  @media (min-width: 1000px) {
    .ser__intro { grid-column: 1 / span 5; position: sticky; top: var(--space-9); }
    .ser__specs { grid-column: 7 / -1; }
  }

  /* палитра серии: заголовок слева, ссылка на подбор шва справа, линия над всем */
  .pal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin: clamp(64px, 8vw, 112px) 0 var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair-strong);
