---
// Кладочная смесь для клинкерного кирпича (план, волна 1). Угол страницы: у клинкера низкое
// водопоглощение — поэтому смесь под него своя; что подходит у Perel и у Основит.
//
// ФАКТЫ — только из данных:
//   - назначение и «для какого кирпича» — дословно SERIES_FACTS[…].purpose / .forBrick
//     (Perel NL: td-perel.ru; Основит Брикформ МС11 — блок «Рекомендуемые материалы» на osnovit.ru);
//   - диапазоны водопоглощения на шкале — строки «Водопоглощение кирпича» из SERIES_FACTS[…].specs,
//     зона клинкера — BRICK_TYPES.klinker (подраздел дилера «Клинкерный кирпич 0–5 %»);
//   - какие серии подходят к клинкеру — seriesFor('klinker') (Perel NL + Основит МС11 через ALSO_FOR);
//   - МС11/1 к клинкеру НЕ относим (DISCREPANCIES в series-facts.ts);
//   - расшивка готовой кладки — Основит Бриксэйв ХС30: в его forBrick (блок «Рекомендуемые основания»
//     на osnovit.ru, сверено 11.10) назван клинкерный кирпич; в purpose ХС30 клинкерного кирпича НЕТ;
//   - цвета и фасовка — ассортимент дилера (catalog.ts), расход — CONSUMPTION.
// Кадров кладки здесь нет: визуализаций клинкера в материалах клиента нет. Цен нет (catalog.ts).
// Зимние модификации не показываем: возит ли их дилер — неизвестно (series-facts.ts).
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import SeriesCard from '../components/smesi/SeriesCard.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import SpecTable from '../components/content/SpecTable.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import { BRICK_TYPES, POSITIONS, seriesById, seriesFor, type SeriesId } from '../data/catalog';
import { SERIES_FACTS, CONSUMPTION, type Fact } from '../data/series-facts';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { localPath } from '../lib/sites';
import { plural } from '../lib/format';
import type { FaqItem, SpecRow } from '../lib/types';

const SLUG = 'dlya-klinkernogo-kirpicha';
const KL = BRICK_TYPES.klinker;

const nl = seriesById('perel-nl');
const mc11 = seriesById('osnovit-mc11');
const mc111 = seriesById('osnovit-mc11-1');
const sl = seriesById('perel-sl');
const vl = seriesById('perel-vl');
const xc30 = seriesById('osnovit-xc30');
const F = SERIES_FACTS;

const klinkerIds = seriesFor('klinker').map((s) => s.id);
const klinkerPositions = POSITIONS.filter((p) => klinkerIds.includes(p.series));
const colorsWord = (n: number) => `${n} ${plural(n, 'цвет', 'цвета', 'цветов')}`;
const kg = (n: number) => n.toFixed(1).replace('.', ',');

const LABEL_ABS = 'Водопоглощение кирпича';
const absOf = (id: SeriesId): Fact => {
  const f = F[id].specs.find((x) => x.label === LABEL_ABS);
  if (!f) throw new Error(`Нет строки «${LABEL_ABS}» у ${id}`);
  return f;
};

/** «0–5 %» → 0…5; «до 12 %…» → 0…12; «более 12 %…» → 12…открыто. */
function parseRange(v: string): { from: number; to: number | null } {
  const range = v.match(/(\d+)\s*[–-]\s*(\d+)/);
  if (range) return { from: Number(range[1]), to: Number(range[2]) };
  const upTo = v.match(/^до\s*(\d+)/);
  if (upTo) return { from: 0, to: Number(upTo[1]) };
  const above = v.match(/^более\s*(\d+)/);
  if (above) return { from: Number(above[1]), to: null };
  throw new Error(`Не разобрать диапазон «${v}»`);
}

// ── Шкала водопоглощения: на какой кирпич рассчитана каждая кладочная серия ──────────
const scaleIds: SeriesId[] = ['perel-nl', 'perel-sl', 'perel-vl', 'osnovit-mc11', 'osnovit-mc11-1'];
const parsed = scaleIds.map((id) => ({ id, value: absOf(id).value, ...parseRange(absOf(id).value) }));
const scaleMax = Math.max(...parsed.map((r) => r.to ?? 0));
const pct = (n: number) => `${((n / scaleMax) * 100).toFixed(2)}%`;
const zone = parseRange(KL.absorption);
const scaleRows = parsed.map((r) => ({
  ...r,
  name: seriesById(r.id).name,
  open: r.to === null,
  klinker: klinkerIds.includes(r.id),
  style: `--from:${pct(r.from)};--to:${pct(r.to ?? scaleMax)}`,
}));
const ticks = [...new Set(parsed.flatMap((r) => [r.from, r.to]).filter((n): n is number => n !== null))].sort((a, b) => a - b);
const zoneStyle = `--from:${pct(zone.from)};--to:${pct(zone.to ?? scaleMax)}`;

// Источники шкалы: у Perel все три диапазона названы на странице подбора по водопоглощению,
// у Основит — на страницах МС11 и МС11/1.
const scaleSrc = [
  { href: F['perel-nl'].forBrickSrc, label: 'серии Perel на td-perel.ru' },
  { href: absOf('osnovit-mc11').src, label: 'Брикформ МС11 на osnovit.ru' },
  { href: absOf('osnovit-mc11-1').src, label: 'Брикформ МС11/1 на osnovit.ru' },
];

// ── Характеристики: ключевые строки производителя ─────────────────────────────────
function pick(id: SeriesId, labels: string[]): { rows: SpecRow[]; srcs: string[] } {
  const facts = labels
    .map((l) => F[id].specs.find((f) => f.label === l))
    .filter((f): f is Fact => Boolean(f));
  return { rows: facts.map((f) => ({ label: f.label, value: f.value })), srcs: [...new Set(facts.map((f) => f.src))] };
}

const nlSpecs = pick('perel-nl', [
  LABEL_ABS,
  'Прочность на сжатие',
  'Адгезия (сцепление с основанием)',
  'Морозостойкость',
  'Жизнеспособность раствора',
  'Вода затворения',
  'Температура применения',
]);
const mc11Specs = pick('osnovit-mc11', [
  LABEL_ABS,
  'Прочность на сжатие',
  'Сцепление с основанием',
  'Морозостойкость',
  'Жизнеспособность раствора',
  'Вода затворения',
  'Толщина шва',
  'Температура применения',
]);

// «до 12 %, а также клинкерный кирпич» → ['до 12 %', 'а также клинкерный кирпич'] — для плашки
const mc11Abs = (() => {
  const v = absOf('osnovit-mc11').value;
  const i = v.indexOf(',');
  return i > 0 ? [v.slice(0, i).trim(), v.slice(i + 1).trim()] : [v, 'водопоглощение кирпича'];
})();

const srcName = (href: string) => {
  const host = new URL(href).hostname;
  if (href.toLowerCase().includes('.pdf')) return `техническая карта, ${host}`;
  return host;
};

// ── Расшивка готовой кладки: Бриксэйв ХС30 ───────────────────────────────────────
const xcFacts = F['osnovit-xc30'];
const xcCons = CONSUMPTION.osnovitXc30;
const xcPoints = [
  { text: 'Кладка должна выстояться не менее 3–4 недель — за это время кладочный раствор набирает марочную прочность. Швы расчищают на одинаковую глубину, не менее 1,5–2 см.', src: xcFacts.steps[0].src },
  { text: `Расход — ${kg(xcCons.kgPerM2)} кг на 1 м² кладки (${xcCons.condition}).`, src: xcCons.src },
  { text: xcFacts.notes?.[0]?.text ?? '', src: xcFacts.notes?.[0]?.src ?? '' },
].filter((p) => p.text);
const xcSrcs = [...new Set(xcPoints.map((p) => p.src))];
const xcHref = `${localPath('smesi', xc30.page)}#${xc30.id}`;

// ── Вопросы и ответы: только факты из данных ─────────────────────────────────────
const perelBrick = CONSUMPTION.perel.perBrick
  .map((r) => `${r.format} (${r.size}) — ${kg(r.kgMin)}–${kg(r.kgMax)} кг`)
  .join('; ');
const brikformTiming = F['osnovit-mc11'].steps.find((s) => s.text.startsWith('Расшивку начинать'));
const brikformTrial = F['osnovit-mc11'].steps.find((s) => s.text.startsWith('Перед расшивкой'));

const faq: FaqItem[] = [
  {
    q: 'Подойдёт ли для клинкера смесь для обычного облицовочного кирпича?',
    a: `Зависит от производителя. У Perel для клинкера отдельная серия — NL, она рассчитана на кирпич с водопоглощением ${absOf('perel-nl').value}; ${sl.name} — на ${absOf('perel-sl').value}, ${vl.name} — на ${absOf('perel-vl').value}. У Основит клинкерный кирпич назван в назначении Брикформ МС11 — того же раствора, что и для керамического и силикатного облицовочного кирпича с водопоглощением до 12 %. Брикформ МС11/1 производитель рекомендует для кирпича с водопоглощением более 12 % и кирпича ручной формовки.`,
  },
  {
    q: 'Чем отличаются Perel NL и Основит Брикформ МС11?',
    a: `Perel NL производитель разработал специально для облицовки кирпичом с низким водопоглощением, от 0 до 5 %. Брикформ МС11 — раствор для керамического, силикатного и клинкерного облицовочного кирпича с возможностью расшивки швов в момент укладки. У нас ${nl.name} — ${colorsWord(nl.colors.length)} в мешках по ${nl.packKg} кг, ${mc11.name} — ${colorsWord(mc11.colors.length)} в мешках по ${mc11.packKg} кг.`,
  },
  {
    q: 'Сколько смеси нужно на клинкерную кладку?',
    a: `Производители считают по-разному. Perel даёт расход сухой смеси на один кирпич по формату, норма одна для SL, VL и NL (толщина шва в таблице не указана): ${perelBrick}. Основит — ${CONSUMPTION.osnovit.kgPerM2} кг на 1 м² кладки (${CONSUMPTION.osnovit.joint}, ${CONSUMPTION.osnovit.wall}). Сколько это мешков, посчитает <a href="${PAGES.kalkulyator.href}">калькулятор расхода</a>.`,
  },
  ...(brikformTiming && brikformTrial
    ? [{
        q: 'Когда расшивать шов при кладке на Брикформ МС11?',
        a: 'По технической карте Основит расшивку начинают после начала схватывания раствора — время зависит от температуры, влажности и впитывающей способности кирпича. Шов не переувлажняют и расшивают быстрыми движениями, без долгого «перетирания». Перед работой производитель советует пробную расшивку на небольшом участке — убедиться, что инструмент не меняет цвет шва.',
      }]
    : []),
  {
    q: 'Можно ли сделать цветной шов на уже готовой клинкерной кладке?',
    a: `Да, раствором для расшивки: среди рекомендуемых оснований для Основит Бриксэйв ХС30 производитель называет клинкерный облицовочный кирпич. Расшивают не раньше чем через 3–4 недели после кладки, когда кладочный раствор наберёт марочную прочность, — швы перед этим расчищают не меньше чем на 1,5–2 см. Расход — ${kg(xcCons.kgPerM2)} кг на 1 м² кладки. У нас ${colorsWord(xc30.colors.length)} в мешках по ${xc30.packKg} кг.`,
  },
];

const itemList = {
  '@type': 'ItemList',
  name: 'Кладочные смеси для клинкерного кирпича',
  numberOfItems: klinkerPositions.length,
  itemListElement: klinkerPositions.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title })),
};

const picks = [nl, mc11].map((s) => ({
  s,
  href: `#${s.id}`,
  abs: absOf(s.id).value,
  strip: s.colors.map((c) => swatchFor(s.id, c.code)),
}));

---

<Page
  title="Кладочная смесь для клинкерного кирпича — Perel NL и Основит МС11"
  description={`Цветные кладочные смеси для клинкера с водопоглощением ${KL.absorption}: Perel NL — ${colorsWord(nl.colors.length)}, Основит Брикформ МС11 — ${colorsWord(mc11.colors.length)}. Расшивка готовой кладки, Москва и МО.`}
  slug={SLUG}
  current="klinker"
  source="klinker"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Клинкерный кирпич"
    h1="Кладочная смесь для клинкерного кирпича"
    crumb="Для клинкерного кирпича"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={`У клинкерного кирпича низкое водопоглощение — ${KL.absorption}. Для него у Perel есть отдельная серия NL, а у Основит клинкер назван в назначении Брикформ МС11. У нас ${colorsWord(nl.colors.length)} NL и ${colorsWord(mc11.colors.length)} МС11 — нажмите на образец, чтобы узнать цену и наличие.`}
  >
    <div class="picks" slot="aside" data-reveal-stagger>
      {picks.map((p) => (
        <a class="pick" href={p.href}>
          <span class="pick__strip" aria-hidden="true">{p.strip.map((c) => <span style={`--c:${c}`}></span>)}</span>
          <span class="pick__body">
            <span class="pick__name">{p.s.name}</span>
            <span class="pick__abs">водопоглощение кирпича: {p.abs}</span>
            <span class="pick__meta">{colorsWord(p.s.colors.length)} · мешок {p.s.packKg} кг</span>
          </span>
          <span class="pick__go" aria-hidden="true">↓</span>
        </a>
      ))}
      <a class="pick-more" href="#rasshivka">Кладка уже готова — расшивка {xc30.name} <span aria-hidden="true">↓</span></a>
    </div>
  </PageHead>

  <Section id="pochemu" kicker="Водопоглощение" title="Почему клинкеру нужна своя смесь" bg="base">
    <div class="why">
      <div class="why__text">
        <p class="lead" data-reveal>
          Главное условие подбора кладочной смеси у Perel — водопоглощение кирпича, то есть сколько воды он
          впитывает. У клинкера оно низкое, от 0 до 5 %, и оба производителя из нашего каталога называют
          такой кирпич отдельно.
        </p>
        <div class="quotes" data-reveal-stagger>
          <blockquote class="quote">
            <p>«{F['perel-nl'].forBrick}»</p>
            <footer>Perel, подбор серии по водопоглощению кирпича — <a href={F['perel-nl'].forBrickSrc} rel="nofollow noopener" target="_blank">td-perel.ru</a></footer>
          </blockquote>
          <blockquote class="quote">
            <p>«{F['osnovit-mc11'].forBrick}»</p>
            <footer>Основит, рекомендуемые материалы для Брикформ МС11 — <a href={F['osnovit-mc11'].forBrickSrc} rel="nofollow noopener" target="_blank">osnovit.ru</a></footer>
          </blockquote>
        </div>
        <p class="why__p" data-reveal>
          Диапазоны остальных кладочных серий начинаются выше: у {sl.name} и {vl.name} — от 5 %,
          у Брикформ МС11/1 — более 12 %.
        </p>
      </div>

      <figure class="scale" data-reveal>
        <figcaption class="scale__cap">На какое водопоглощение кирпича рассчитана смесь</figcaption>
        <ul class="scale__rows">
          {scaleRows.map((r) => (
            <li class:list={['scale__row', r.klinker && 'is-klinker']}>
              <span class="scale__name">{r.name}<small>{r.value}</small></span>
              <span class="scale__track" aria-hidden="true">
                <span class="scale__zone" style={zoneStyle}></span>
                <span class:list={['scale__bar', r.open && 'is-open']} style={r.style}></span>
              </span>
            </li>
          ))}
          <li class="scale__row scale__row--axis" aria-hidden="true">
            <span class="scale__name"></span>
            <span class="scale__ticks">
              {ticks.map((t, i) => (
                <span class:list={['scale__tick', i === 0 && 'is-first', i === ticks.length - 1 && 'is-last']} style={`--x:${pct(t)}`}>{t} %</span>
              ))}
            </span>
          </li>
        </ul>
        <p class="scale__legend">
          <span class="scale__item"><span class="scale__key" aria-hidden="true"></span>зона клинкера, {KL.absorption}</span>
          <span class="scale__item"><span class="scale__key scale__key--bar" aria-hidden="true"></span>смеси, которые производитель называет для клинкера</span>
        </p>
        <p class="src">
          По данным производителей:{' '}
          {scaleSrc.map((s, i) => (
            <Fragment>{i > 0 && ', '}<a href={s.href} rel="nofollow noopener" target="_blank">{s.label}</a></Fragment>
          ))}
        </p>
      </figure>
    </div>

    <aside class="passport" data-reveal>
      <h3 class="passport__title">Как узнать водопоглощение своего кирпича</h3>
      <p>
        Найдите цифру в паспорте кирпича и сравните со шкалой выше — станет видно, какая серия смеси на него
        рассчитана. Паспорта под рукой нет — назовите завод и марку кирпича, подскажем.
        <a href="#zayavka">Оставить заявку</a>
      </p>
    </aside>
  </Section>

  <Section id={nl.id} kicker="Perel" title="Perel NL — серия под клинкер" bg="alt">
    <div class="ser">
      <div class="ser__intro" data-reveal>
        <blockquote class="quote quote--plain">
          <p>{F['perel-nl'].purpose}</p>
          <footer>Назначение серии — <a href={F['perel-nl'].purposeSrc} rel="nofollow noopener" target="_blank">td-perel.ru</a></footer>
        </blockquote>
        <ul class="facts">
          <li><b>{nl.colors.length}</b><span>{plural(nl.colors.length, 'цвет', 'цвета', 'цветов')} у нас</span></li>
          <li><b>{nl.packKg} кг</b><span>мешок</span></li>
          <li><b>{absOf('perel-nl').value}</b><span>водопоглощение кирпича</span></li>
        </ul>
        <button class="btn btn--primary" type="button" data-ask={`${nl.name} — цвет подберём`}>Узнать цену</button>
      </div>
      <div class="ser__specs" data-reveal>
        <SpecTable rows={nlSpecs.rows} />
        <p class="src">
          По данным производителя:{' '}
          {nlSpecs.srcs.map((h, i) => (
            <Fragment>{i > 0 && ', '}<a href={h} rel="nofollow noopener" target="_blank">карточка смеси на {srcName(h)}</a></Fragment>
          ))}
        </p>
      </div>
    </div>

    <h3 class="sub" data-reveal>{nl.colors.length} {plural(nl.colors.length, 'цвет', 'цвета', 'цветов')} {nl.name}</h3>
    <SwatchGrid series="perel-nl" />
    <SwatchNote />
  </Section>

  <Section id={mc11.id} kicker="Основит" title="Брикформ МС11 — и для клинкера, и для кирпича до 12 %" bg="base">
    <div class="ser">
      <div class="ser__intro" data-reveal>
        <blockquote class="quote quote--plain">
          <p>{F['osnovit-mc11'].purpose}</p>
          <footer>Назначение раствора — <a href={F['osnovit-mc11'].purposeSrc} rel="nofollow noopener" target="_blank">osnovit.ru</a></footer>
        </blockquote>
        <ul class="facts">
          <li><b>{mc11.colors.length}</b><span>{plural(mc11.colors.length, 'цвет', 'цвета', 'цветов')} у нас</span></li>
          <li><b>{mc11.packKg} кг</b><span>мешок</span></li>
          <li><b>{mc11Abs[0]}</b><span>водопоглощение кирпича, а также клинкер</span></li>
        </ul>
        <p class="aside-note">
          Не перепутайте с {mc111.name}: рекомендуемые основания у него другие —
          «{F['osnovit-mc11-1'].forBrick}» (<a href={F['osnovit-mc11-1'].forBrickSrc} rel="nofollow noopener" target="_blank">техническая карта, osnovit.ru</a>).
        </p>
        <button class="btn btn--primary" type="button" data-ask={`${mc11.name} — цвет подберём`}>Узнать цену</button>
      </div>
      <div class="ser__specs" data-reveal>
        <SpecTable rows={mc11Specs.rows} />
        <p class="src">
          По данным производителя:{' '}
          {mc11Specs.srcs.map((h, i) => (
            <Fragment>{i > 0 && ', '}<a href={h} rel="nofollow noopener" target="_blank">страница раствора на {srcName(h)}</a></Fragment>
          ))}
        </p>
      </div>
    </div>

    <h3 class="sub" data-reveal>{mc11.colors.length} {plural(mc11.colors.length, 'цвет', 'цвета', 'цветов')} Брикформ МС11</h3>
    <SwatchGrid series="osnovit-mc11" />
    <SwatchNote />
  </Section>

