---
// Страница 404. Без неё Vercel отдаёт служебную заглушку на английском.
// Показываем те же входы, что и в меню, и телефон офиса.
import Page from '../layouts/Page.astro';
import Container from '../components/layout/Container.astro';
import { PAGES } from '../data/nav';
import { getSite } from '../lib/sites';

const seller = getSite('smesi');
const входы = [
  { ...PAGES.katalog, note: 'все цвета Perel и Основит' },
  { ...PAGES.podbor, note: 'как будет выглядеть шов на вашем кирпиче' },
  { ...PAGES.kalkulyator, note: 'сколько мешков нужно' },
  { ...PAGES.perel, note: 'серии SL, VL, NL и затирка RL' },
  { ...PAGES.osnovit, note: 'Брикформ МС11, МС11/1 и Бриксэйв ХС30' },
  { ...PAGES.dostavka, note: 'офисы продаж и телефоны' },
];
---

<Page
  title="Страница не найдена — Кирпичный трест"
  description="Такой страницы нет. Выберите раздел: каталог цветных кладочных смесей, подбор шва, калькулятор расхода."
  slug="404"
  priceModal={false}
>
  <Container>
    <section class="nf">
      <p class="nf__code">404</p>
      <h1 class="display nf__title">Такой страницы здесь нет</h1>
      <p class="nf__text">
        Возможно, в адресе опечатка или страницу переименовали. Вот куда можно пойти отсюда.
      </p>
      <ul class="nf__list">
        {входы.map((в) => (
          <li>
            <a href={в.href}>
              <span class="nf__label">{в.label}</span>
              <span class="nf__note">{в.note}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="nf__phone">
        Или позвоните: <a href={seller.phone.href}>{seller.phone.display}</a>, {seller.hours}
      </p>
    </section>
  </Container>
</Page>

<style>
  .nf { padding: clamp(48px, 10vh, 120px) 0 clamp(56px, 12vh, 140px); }
  .nf__code {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--fs-h3);
    color: var(--color-brand);
    letter-spacing: 0.12em;
  }
  .nf__title { margin: var(--space-3) 0 var(--space-4); }
  .nf__text { color: var(--color-text-soft); max-width: 52ch; font-size: var(--fs-lead); }

  .nf__list {
    list-style: none;
    margin: clamp(28px, 5vh, 48px) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1fr;
  }
  .nf__list a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border-soft);
    color: inherit;
    text-decoration: none;
    transition: padding-left 380ms var(--ease), border-color 380ms var(--ease);
  }
  .nf__list a:hover { padding-left: 10px; border-bottom-color: var(--color-brand); }
  .nf__label { font-family: var(--font-head); font-weight: 500; font-size: var(--fs-h4); }
  .nf__note { color: var(--color-muted); font-size: var(--fs-small); }
  .nf__phone { margin-top: clamp(28px, 5vh, 48px); color: var(--color-text-soft); }
  .nf__phone a { color: inherit; }

  @media (min-width: 760px) {
    .nf__list { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--space-6); }
  }
</style>
