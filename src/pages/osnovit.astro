---
// Страница бренда Основит (план, волна 1, № 4): брендовый спрос «основит брикформ мс11 …».
// Угол страницы — Брикформ под тип кирпича (МС11 или МС11/1), зимние версии и расшивка Бриксэйв ХС30.
//
// Редизайн 11.10 (Влад: «шаблон не нужно использовать тот же, ещё и везде кирпич»): язык «палитры шва».
// Кадра кирпичной кладки на первом экране больше нет — вместо него полосы оттенков Брикформ и ХС30
// (цвет раствора и есть товар); шов на кирпиче смотрят в подборе шва (/podbor-shva/). Плашки, карточки
// и тёмные врезки переведены в строки через тонкие линии, сравнение растворов — таблица через линии.
//
// ФАКТЫ — только из данных (src/data):
//   назначение и «для какого кирпича» — ДОСЛОВНО из SERIES_FACTS (purpose / forBrick);
//   характеристики, шаги, оговорки о цвете, зимние версии — SERIES_FACTS, у каждой строки свой адрес;
//   расход — CONSUMPTION.osnovit (50 кг/м²) и CONSUMPTION.osnovitXc30 (5,0 кг/м²);
//   о производителе и его инструментах — BRAND_FACTS.osnovit;
//   ассортимент (22 цвета, фасовка) — catalog.ts; оттенки плашек — swatches.ts (приближённый замер).
// ⚠️ Число цветов Основит как факт производителя НЕ пишем (у производителя 34 / 32 / 23 / 22 в разных
//   местах) — только «у нас 22 цвета» (ассортимент дилера, OSNOVIT_COLORS).
// ⚠️ Зимних МС11 F и МС11/1 F в ассортименте дилера нет — описаны как факт производителя,
//   наличие — «уточняйте у менеджера»; цвета зимних версий не пишем (у производителя расходятся).
// ⚠️ В «Подборе дизайна фасада» у производителя названо число цветов шва — не переносим: читалось бы
//   как число цветов Основит.
// Цен нет: действие позиции — «Узнать цену» (атрибут data-ask, окно есть на странице через Page).
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import SpecTable from '../components/content/SpecTable.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import Collapse from '../components/ui/Collapse.astro';
import { seriesById, OSNOVIT_COLORS, POSITIONS, type SeriesId, type Tone } from '../data/catalog';
import { SERIES_FACTS, CONSUMPTION, BRAND_FACTS, type SeriesFacts } from '../data/series-facts';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { liveUrl } from '../lib/sites';
import { nb as typoNb } from '../lib/typo';
// Пробел перед «—» — неразрывный: тире не начинает строку (сквозная проверка дизайна 11.10).
const nb = (t: string) => typoNb(t).replace(/ — /g, '\u00a0— ');
import type { FaqItem, SpecRow } from '../lib/types';

const MC11 = SERIES_FACTS['osnovit-mc11'];
const MC111 = SERIES_FACTS['osnovit-mc11-1'];
const XC30 = SERIES_FACTS['osnovit-xc30'];
const sMc11 = seriesById('osnovit-mc11');
const sMc111 = seriesById('osnovit-mc11-1');
const sXc30 = seriesById('osnovit-xc30');
const SERIES_HERE: SeriesId[] = ['osnovit-mc11', 'osnovit-mc11-1', 'osnovit-xc30'];

const colorsCount = OSNOVIT_COLORS.length;
const positionsCount = POSITIONS.filter((p) => SERIES_HERE.includes(p.series)).length;

/* ── помощники ─────────────────────────────────────────────────────────────── */

const spec = (f: SeriesFacts, label: string) => {
  const x = f.specs.find((s) => s.label === label);
  if (!x) throw new Error(`osnovit.astro: нет показателя «${label}»`);
  return x;
};
const rowsOf = (f: SeriesFacts): SpecRow[] => [...f.specs, ...f.packaging].map((x) => ({ label: x.label, value: x.value }));
const plural = (n: number, forms: [string, string, string]) => {
  const a = Math.abs(n) % 100;
  const b = a % 10;
  if (a > 10 && a < 20) return forms[2];
  if (b === 1) return forms[0];
  if (b >= 2 && b <= 4) return forms[1];
  return forms[2];
};
const colorsWord = (n: number) => plural(n, ['цвет', 'цвета', 'цветов']);

/** Подпись источника по адресу (адреса — из данных, здесь только название ссылки). */
const SRC_NAMES: [RegExp, string][] = [
  [/Brikform-MC11-F\.pdf$/, 'техническая карта МС11 F'],
  [/Brikform-MC11\.1-F\.pdf$/, 'техническая карта МС11/1 F'],
  [/Brikform-MC11\.1\.pdf$/, 'техническая карта МС11/1'],
  [/Brikform-MC11\.pdf$/, 'техническая карта МС11'],
  [/Brikseyv-KHS30.*\.pdf$/, 'техническая карта ХС30'],
  [/brikform-ms11-1\/$/, 'страница МС11/1 на osnovit.ru'],
  [/brikform-ms11\/$/, 'страница МС11 на osnovit.ru'],
  [/brikseyv-xc30\/$/, 'страница ХС30 на osnovit.ru'],
  [/put-k-idealnoy-rasshivke/, 'статья производителя о расшивке'],
  [/ROSS-RU/, 'декларация соответствия'],
  [/o-kompanii/, 'раздел «О компании» на osnovit.ru'],
];
const srcName = (url: string) => SRC_NAMES.find(([re]) => re.test(url))?.[1] ?? 'osnovit.ru';
const sources = (urls: string[]) => [...new Set(urls)].map((url) => ({ url, name: srcName(url) }));
const factSources = (f: SeriesFacts) => sources([f.purposeSrc, f.forBrickSrc, ...f.specs.map((x) => x.src), ...f.packaging.map((x) => x.src)]);

const about = (needle: string) => {
  const x = BRAND_FACTS.osnovit.about.find((f) => f.text.includes(needle));
  if (!x) throw new Error(`osnovit.astro: нет факта о производителе «${needle}»`);
  return x;
};
const tool = (needle: string) => {
  const x = BRAND_FACTS.osnovit.tools.find((f) => f.text.includes(needle));
  if (!x) throw new Error(`osnovit.astro: нет инструмента «${needle}»`);
  return x;
};

/* ── первый экран: полосы оттенков ─────────────────────────────────────────── */

// Порядок плашек — по тонам (белые → бежевые → жёлтые → коричневые → цветные → серые → чёрные),
// внутри тона от светлого к тёмному. У ХС30 тот же порядок кодов, что у Брикформ: коды общие,
// плашки сняты с разных образцов — полосы можно сравнить столбец в столбец.
const TONE_FLOW: Tone[] = ['white', 'beige', 'yellow', 'brown', 'red', 'accent', 'grey', 'black'];
const luma = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  return 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
};
const codeOrder = [...sMc11.colors]
  .sort(
    (a, b) =>
      TONE_FLOW.indexOf(a.tone) - TONE_FLOW.indexOf(b.tone) ||
      luma(swatchFor(sMc11.id, b.code)) - luma(swatchFor(sMc11.id, a.code)),
  )
  .map((c) => c.code);
const stripOf = (id: SeriesId) => {
  const s = seriesById(id);
  return codeOrder
    .map((code) => s.colors.find((c) => c.code === code))
    .filter((c): c is NonNullable<typeof c> => Boolean(c))
    .map((c) => ({ title: `${c.name}, ${c.code}`, hex: swatchFor(id, c.code) }));
};
const strips = [
  { key: 'lg', label: 'Брикформ МС11 и МС11/1', count: sMc11.colors.length, href: `#${sMc11.id}-cveta`, colors: stripOf(sMc11.id) },
  { key: 'sm', label: 'Бриксэйв ХС30', count: sXc30.colors.length, href: `#${sXc30.id}-cveta`, colors: stripOf(sXc30.id) },
];

const jump = [
  { href: '#vybor', label: 'МС11 или МС11/1' },
  { href: `#${sMc11.id}`, label: 'Брикформ МС11' },
  { href: `#${sMc111.id}`, label: 'Брикформ МС11/1' },
  { href: '#zima', label: 'Зимние версии' },
  { href: `#${sXc30.id}`, label: 'Расшивка ХС30' },
  { href: '#rashod', label: 'Расход' },
];

/* ── 1. о производителе ───────────────────────────────────────────────────── */

const maker = [
  { title: 'Производство', text: 'Смеси выпускает ООО «Седрус». В декларации соответствия адрес места деятельности — Московская область, г. Коломна, Пирочинское шоссе, 13.', src: about('Коломна').src },
  { title: 'Документы', text: 'Декларация соответствия РОСС RU Д-RU.РА01.В.32635/25 по ГОСТ Р 58272-2018 действует до 11.02.2030. В перечне — колерованные Брикформ МС11, МС11/1 и Бриксэйв ХС30.', src: about('Декларация').src },
];
// Номер декларации и ГОСТ не должны рваться по дефису на две строки («Д-» / «RU…»).
const KEEP = ['РОСС RU Д-RU.РА01.В.32635/25', 'ГОСТ Р 58272-2018', 'Пирочинское шоссе, 13', 'г. Коломна'];
// После неразрывной группы — обычный пробел: иначе nb() склеивает «…/25 по ГОСТ … 2018 действует» в одну
// неразрывную строку шириной 530 px и рвёт телефон.
const keepTogether = (text: string) =>
  KEEP.reduce((acc, k) => acc.replace(k, `<span class="os-nowrap">${k}</span>`), nb(text)).replace(/<\/span>\u00a0/g, '</span> ');
const objectsSrc = about('Зиларт').src;
const objects = [
  { name: 'ЖК «Зиларт»', place: 'Москва, ул. Автозаводская, вл. 23' },
  { name: 'ЖК «Коммунарка»', place: 'Москва' },
  { name: 'Микрорайон «Царицыно»', place: 'Москва' },
  { name: 'КП «Академия парк»', place: 'Москва' },
  { name: 'КП «Шервудский Лес»', place: 'Московская область' },
];

/* ── 2. МС11 или МС11/1 ───────────────────────────────────────────────────── */

type Cmp = { label: string; a: string; b: string; wide?: boolean };
const cmpLabels = ['Прочность на сжатие', 'Морозостойкость', 'Вода затворения', 'Жизнеспособность раствора', 'Толщина шва'];
const cmp: Cmp[] = [
  { label: 'Для какого кирпича', a: MC11.forBrick, b: MC111.forBrick, wide: true },
  ...cmpLabels.map((l) => ({ label: l, a: spec(MC11, l).value, b: spec(MC111, l).value })),
  { label: 'Мешок у нас', a: `${sMc11.packKg} кг`, b: `${sMc111.packKg} кг` },
  { label: 'Цветов у нас', a: String(sMc11.colors.length), b: String(sMc111.colors.length) },
];
const cmpSources = sources([
  MC11.forBrickSrc,
  MC111.forBrickSrc,
  ...cmpLabels.flatMap((l) => [spec(MC11, l).src, spec(MC111, l).src]),
]);

const hints = [
  { title: 'Клинкер — к МС11.', text: 'Клинкерный кирпич производитель называет в назначении МС11; у МС11/1 его в назначении нет.' },
  { title: 'Ручная формовка — к МС11/1.', text: 'Для кирпича ручной формовки производитель рекомендует МС11/1.' },
  { title: 'Расшивка — сразу при кладке.', text: 'У МС11 и у МС11/1 производитель указывает возможность расшивки швов в момент укладки.' },
];

/* ── 3–4. серии Брикформ ─────────────────────────────────────────────────── */

const joint = (f: SeriesFacts, label: string) => spec(f, label).value.replace(' (рекомендуемая)', '');
type Fact = [dt: string, dd: string];
const brikform = [
  {
    s: sMc11,
    f: MC11,
    bg: 'base' as const,
    kicker: 'Брикформ МС11',
    title: 'Брикформ МС11 — для кирпича до 12 % и клинкера',
    facts: [
      ['Мешок', `${sMc11.packKg} кг`],
      ['Цветов у нас', String(sMc11.colors.length)],
      ['Толщина шва', joint(MC11, 'Толщина шва')],
    ] as Fact[],
  },
  {
    s: sMc111,
    f: MC111,
    bg: 'alt' as const,
    kicker: 'Брикформ МС11/1',
    title: 'Брикформ МС11/1 — для кирпича более 12 % и ручной формовки',
    facts: [
      ['Мешок', `${sMc111.packKg} кг`],
      ['Цветов у нас', String(sMc111.colors.length)],
      ['Толщина шва', joint(MC111, 'Толщина шва')],
    ] as Fact[],
  },
];

/* ── 5. зимние версии ─────────────────────────────────────────────────────── */

// Пересказ brikformWinter() из series-facts.ts по пунктам — числа и запреты производителя без добавлений.
const winterRules = [
  'Температура воздуха и основания при нанесении — от −10 до +5 °C.',
  'Жизнеспособность раствора — 1 час.',
  'Мешки перед работой 24 часа выдерживают в тепле, воду для затворения подогревают до +10…+30 °C.',
  'Противоморозные и любые другие добавки вводить запрещено; количество воды особенно важно соблюдать.',
  'После работ 3 суток не допускать похолодания ниже −10 °C; при более сильном морозе работают только в тепловом контуре.',
];
const winterSources = sources([MC11.winter?.src ?? '', MC111.winter?.src ?? ''].filter(Boolean));

/* ── 6. ХС30 ──────────────────────────────────────────────────────────────── */

const xcRate = CONSUMPTION.osnovitXc30;
const xcRateText = xcRate.kgPerM2.toFixed(1).replace('.', ',');
const xcSources = sources([...factSources(XC30).map((x) => x.url), xcRate.src]);
const xcNewOrOld = XC30.notes?.find((n) => n.text.includes('нового строительства'));
const xcFacts: Fact[] = [
  ['Мешок', `${sXc30.packKg} кг`],
  ['Цветов у нас', String(sXc30.colors.length)],
  ['Ширина шва', joint(XC30, 'Ширина шва')],
];

/* ── 7. как работать ──────────────────────────────────────────────────────── */

// Шаги 2–8 у МС11 и МС11/1 совпадают слово в слово (технические карты 07.26); первый шаг — вода,
// у двух растворов норма разная, поэтому он собран из обоих.
const waterStep = {
  text: `Содержимое мешка при постоянном перемешивании высыпать в ёмкость с чистой водой: для МС11 — ${spec(MC11, 'Вода затворения').value} (2,5–3,75 л на мешок 25 кг), для МС11/1 — ${spec(MC111, 'Вода затворения').value}. Воду лить строго по норме производителя.`,
  src: MC11.steps[0]?.src ?? '',
};
const brikformSteps = [waterStep, ...MC11.steps.slice(1)];
const stepsSources = sources([...brikformSteps.map((s) => s.src), MC111.steps[0]?.src ?? '', ...XC30.steps.map((s) => s.src)].filter(Boolean));

// От чего зависит цвет шва: оговорки Брикформ (страница и техкарта) + совет из статьи о расшивке ХС30.
const colorNotes = [
  ...(MC11.notes ?? []),
  ...(XC30.notes ?? []).filter((n) => n.text.startsWith('Цвет проверяют')),
];

/* ── 8. расход ─────────────────────────────────────────────────────────────── */

const rate = CONSUMPTION.osnovit;
const wall = rate.wall.replace('1/2', '½');
const exampleM2 = 10;
const exampleKg = rate.kgPerM2 * exampleM2;
const exampleBags = Math.ceil(exampleKg / sMc11.packKg);
const bagsPerM2 = rate.kgPerM2 / sMc11.packKg;

/* ── 9. инструменты производителя ─────────────────────────────────────────── */

const tools = [
  {
    title: 'Кирпичный калькулятор',
    text: 'Выберите вид кирпича — калькулятор сам подберёт МС11 или МС11/1. Дальше формат кирпича, швы и количество: результат в мешках по 25 кг и общем весе. Швы по умолчанию — 10 мм вертикальный и 12 мм горизонтальный, по СП 70.13330.2012.',
    href: tool('Кирпичный калькулятор').src,
    cta: 'Открыть на osnovit.ru',
  },
  {
    title: 'Подбор дизайна фасада',
    text: 'Тип дома, часть здания, цвет кирпича и цвет шва кладки — вариант фасада можно распечатать.',
    href: tool('Подбор дизайна фасада').src,
    cta: 'Открыть на osnovit.ru',
  },
  {
    title: 'Видео о Брикформ МС11',
    text: 'Ролик производителя «Цветной кладочный раствор ОСНОВИТ БРИКФОРМ МС11».',
    href: tool('БРИКФОРМ МС11').src,
    cta: 'Смотреть на YouTube',
  },
  {
    title: 'Видео о Бриксэйв ХС30',
    text: 'Ролик производителя «Раствор для расшивки швов ОСНОВИТ БРИКСЭЙВ ХС 30».',
    href: tool('БРИКСЭЙВ ХС 30').src,
    cta: 'Смотреть на YouTube',
  },
];

/* ── 10. вопросы ──────────────────────────────────────────────────────────── */

const faq: FaqItem[] = [
  {
    q: 'Чем Брикформ МС11 отличается от МС11/1?',
    a: `<p>Кирпичом, под который рассчитан раствор. МС11: ${MC11.forBrick} МС11/1: ${MC111.forBrick}</p><p>Прочность на сжатие у обоих — ${spec(MC11, 'Прочность на сжатие').value}, морозостойкость — ${spec(MC11, 'Морозостойкость').value}. Отличается норма воды: ${spec(MC11, 'Вода затворения').value} у МС11 и ${spec(MC111, 'Вода затворения').value} у МС11/1.</p>`,
  },
  {
    q: 'Какой раствор Основит подходит для клинкерного кирпича?',
    a: '<p>Брикформ МС11: клинкерный кирпич производитель называет в его назначении. МС11/1 рассчитан на кирпич с водопоглощением более 12 % и кирпич ручной формовки.</p>',
  },
  {
    q: 'Сколько Брикформ нужно на 1 м² кладки?',
    a: `<p>По норме производителя — ${rate.kgPerM2} кг на 1 м² (${rate.joint}, ${wall}), то есть ${bagsPerM2} мешка по ${sMc11.packKg} кг. Норма одна для МС11 и МС11/1. На свою площадь посчитайте в <a href="${PAGES.kalkulyator.href}">калькуляторе расхода</a>.</p>`,
  },
  {
    q: 'Можно ли класть Основит зимой?',
    a: '<p>Для холодной погоды у производителя есть зимние версии — Брикформ МС11 F и МС11/1 F: нанесение при температуре воздуха и основания от −10 до +5 °C, жизнеспособность раствора 1 час, противоморозные и любые другие добавки вводить запрещено. Наличие зимних версий уточняйте у менеджера.</p>',
  },
  {
    q: 'Когда нужен Бриксэйв ХС30, а не Брикформ?',
    a: `<p>Брикформ — цветной кладочный раствор: шов можно расшить сразу при укладке. ХС30 — для отделки швов уже готовой кладки: новой или той, где швы обновляют. Кладка должна выстояться не менее 3–4 недель, швы расчищают на глубину не менее 1,5–2 см. Расход ХС30 — ${xcRateText} кг на 1 м² (${xcRate.condition}).</p>`,
  },
  {
    q: 'Почему шов может выглядеть не так, как образец?',
    a: '<p>По словам производителя, на цвет шва влияют количество воды, способ и время расшивки, условия твердения и инструмент. Заявленный цвет появляется только после полного высыхания, а небольшие отклонения от демонстрационного образца допускаются — поэтому перед началом работ производитель советует сделать пробную кладку и согласовать оттенок.</p>',
  },
];

/* ── микроразметка ─────────────────────────────────────────────────────────── */

const pageUrl = liveUrl('smesi', 'osnovit');
const itemList = {
  '@type': 'ItemList',
  name: 'Растворы Основит: Брикформ МС11, Брикформ МС11/1, Бриксэйв ХС30',
  numberOfItems: SERIES_HERE.length,
  itemListElement: SERIES_HERE.map((id, i) => ({ '@type': 'ListItem', position: i + 1, name: seriesById(id).name, url: `${pageUrl}#${id}` })),
};
---

<Page
  title="Основит Брикформ МС11 и МС11/1, расшивка Бриксэйв ХС30 — Москва"
  description={`Цветные кладочные растворы Основит Брикформ МС11 и МС11/1 под тип кирпича и расшивка Бриксэйв ХС30: у нас ${colorsCount} цвета, характеристики, нормы расхода.`}
  slug="osnovit"
  current="osnovit"
  source="osnovit"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Производитель Основит"
    h1="Цветные кладочные растворы Основит Брикформ"
    crumb="Основит"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={`Раствор Основит подбирают по кирпичу: МС11 — для облицовочного кирпича с водопоглощением до 12 % и клинкера, МС11/1 — для кирпича более 12 % и ручной формовки. Готовые швы отделывают Бриксэйв ХС30. У нас ${colorsCount} ${colorsWord(colorsCount)} каждого раствора — ${positionsCount} позиций.`}
  >
    <nav class="os-jump" aria-label="Разделы страницы" data-reveal>
      <ol>
        {jump.map((j) => <li><a href={j.href}>{j.label}</a></li>)}
      </ol>
    </nav>
    <Fragment slot="aside">
      <div class="os-pal">
        {strips.map((st) => (
          <div class:list={['os-pal__item', `os-pal__item--${st.key}`]}>
            <a class="os-pal__strip strip" href={st.href} tabindex="-1" aria-hidden="true">
              {st.colors.map((c) => <span class="mortar" style={`--c:${c.hex}`} title={c.title}></span>)}
            </a>
            <p class="os-pal__cap">
              <a href={st.href}>{st.label}</a>
              <span class="num">{st.count}&nbsp;{colorsWord(st.count)} у&nbsp;нас</span>
            </p>
          </div>
        ))}
        <p class="os-pal__note">
          Цвет на экране приблизительный: плашки Брикформ сняты с палитры производителя, плашки ХС30&nbsp;— с&nbsp;фотографии образцов.
        </p>
        <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
      </div>
    </Fragment>
  </PageHead>

  <Section id="proizvoditel" kicker="Производитель" title="Основит — растворы из Коломны" bg="base">
    <div class="os-maker">
      <dl class="os-maker__facts" data-reveal>
        {maker.map((m) => (
          <div class="os-maker__row">
            <dt class="label">{m.title}</dt>
            <dd>
              <p set:html={keepTogether(m.text)} />
              <a class="os-srclink" href={m.src} rel="nofollow noopener" target="_blank">{srcName(m.src)}</a>
            </dd>
          </div>
        ))}
      </dl>
      <div class="os-objects" data-reveal>
        <p class="label">Объекты на Брикформ МС11</p>
        <ol class="os-objects__list">
          {objects.map((o) => (
            <li><b>{o.name}</b><span>{o.place}</span></li>
          ))}
        </ol>
        <p class="os-src">
          Список объектов — <a href={objectsSrc} rel="nofollow noopener" target="_blank">{srcName(objectsSrc)}</a>
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="vybor"
    kicker="Выбор раствора"
    title="МС11 или МС11/1: решает кирпич"
    subtitle="Прочность, морозостойкость и толщина шва у двух растворов одинаковые. Главное различие — кирпич, под который рассчитан раствор; норма воды у каждого своя."
    bg="alt"
  >
    <table class="os-cmp" data-reveal>
      <caption class="os-vh">Сравнение Брикформ МС11 и МС11/1</caption>
      <thead>
        <tr>
          <th scope="col"><span class="os-vh">Показатель</span></th>
          <th scope="col"><a href={`#${sMc11.id}`}>Брикформ МС11</a><span class="os-cmp__abs">{spec(MC11, 'Водопоглощение кирпича').value}</span></th>
          <th scope="col"><a href={`#${sMc111.id}`}>Брикформ МС11/1</a><span class="os-cmp__abs">{spec(MC111, 'Водопоглощение кирпича').value}</span></th>
        </tr>
      </thead>
      <tbody>
        {cmp.map((r) =>
          r.a === r.b ? (
            <tr class="os-cmp__row os-cmp__row--same">
              <th scope="row">{r.label}</th>
              <td colspan="2">{nb(r.a)} <span class="os-cmp__same">одинаково</span></td>
            </tr>
          ) : (
            <tr class:list={['os-cmp__row', r.wide && 'os-cmp__row--wide']}>
              <th scope="row">{r.label}</th>
              <td data-col="МС11">{nb(r.a)}</td>
              <td data-col="МС11/1">{nb(r.b)}</td>
            </tr>
          ),
        )}
      </tbody>
    </table>
    <p class="os-src">
      По данным производителя:
      {cmpSources.map((s, i) => (
        <Fragment>{i > 0 && ' · '}<a href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></Fragment>
      ))}
    </p>
    <div class="os-hints" data-reveal>
      <p class="label">Коротко о выборе</p>
      <ol class="os-hints__list">
        {hints.map((h) => (
          <li><b>{nb(h.title)}</b><span>{nb(h.text)}</span></li>
        ))}
      </ol>
    </div>
  </Section>

  {brikform.map(({ s, f, bg, kicker, title, facts }) => (
    <Section id={s.id} kicker={kicker} title={title} bg={bg}>
      <div class="os-ser">
        <div class="os-ser__about" data-reveal>
          <p class="label">Назначение — слова производителя</p>
          <blockquote class="os-quote" cite={f.purposeSrc}>«{nb(f.purpose)}»</blockquote>
          <p class="os-quote__src">— <a href={f.purposeSrc} rel="nofollow noopener" target="_blank">{srcName(f.purposeSrc)}</a></p>
          <div class="os-ser__brick">
            <p class="label">Для какого кирпича</p>
            <p>«{nb(f.forBrick)}»</p>
          </div>
          <dl class="os-dl">
            {facts.map(([dt, dd]) => <div><dt>{dt}</dt><dd class="num">{nb(dd)}</dd></div>)}
          </dl>
          <div class="os-ser__actions">
            <button class="btn btn--primary" type="button" data-ask={`${s.name} — цвет подберём`}>Узнать цену</button>
            <a class="arrow-link" href={`#${s.id}-cveta`}>Смотреть цвета <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="os-ser__specs" data-reveal>
          <Collapse max={560} fade={bg} label="Все характеристики">
            <SpecTable rows={rowsOf(f)} caption={`Характеристики ${s.name}`} />
          </Collapse>
          <p class="os-src">
            По данным производителя:
            {factSources(f).map((x, i) => (
              <Fragment>{i > 0 && ' · '}<a href={x.url} rel="nofollow noopener" target="_blank">{x.name}</a></Fragment>
            ))}
          </p>
        </div>
      </div>
      <div class="os-colors-head">
        <h3 class="os-sub" id={`${s.id}-cveta`}>{nb(`Цвета ${s.name.replace('Основит ', '')} у нас — ${s.colors.length}`)}</h3>
        <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
      </div>
      <SwatchGrid series={s.id} />
      <SwatchNote />
    </Section>
  ))}

  <Section id="zima" kicker="Зимняя кладка" title="Зимние версии: МС11 F и МС11/1 F" bg="dark" class="os-zima">
    <div class="os-winter">
      <div class="os-winter__main" data-reveal>
        <p class="os-winter__lead">
          У производителя есть зимние версии растворов Брикформ&nbsp;— МС11&nbsp;F и&nbsp;МС11/1&nbsp;F.
          Условия работы с ними по техническим картам производителя:
        </p>
        <ol class="os-winter__list">
          {winterRules.map((r) => <li>{nb(r)}</li>)}
        </ol>
        <p class="os-src">
          По данным производителя:
          {winterSources.map((x, i) => (
            <Fragment>{i > 0 && ' · '}<a href={x.url} rel="nofollow noopener" target="_blank">{x.name}</a></Fragment>
          ))}
        </p>
      </div>
      <aside class="os-winter__aside" data-reveal>
        <p class="os-winter__big num">−10…+5&nbsp;°C</p>
        <p class="os-winter__cap">температура воздуха и основания при нанесении зимней версии</p>
        <p class="os-winter__stock">Наличие зимних версий уточняйте у менеджера.</p>
        <div class="os-winter__actions">
          <button class="btn btn--primary btn--sm" type="button" data-ask="Основит Брикформ МС11 F, зимняя версия — наличие">Спросить о МС11 F</button>
          <button class="btn btn--ghost-inv btn--sm" type="button" data-ask="Основит Брикформ МС11/1 F, зимняя версия — наличие">Спросить о МС11/1 F</button>
        </div>
      </aside>
    </div>
  </Section>

  <Section id={sXc30.id} kicker="Расшивка швов" title={'Бриксэйв ХС30 — раствор для расшивки'} bg="base">
    <div class="os-ser">
      <div class="os-ser__about" data-reveal>
        <p class="label">Назначение — слова производителя</p>
        <blockquote class="os-quote" cite={XC30.purposeSrc}>«{nb(XC30.purpose)}»</blockquote>
        <p class="os-quote__src">— <a href={XC30.purposeSrc} rel="nofollow noopener" target="_blank">{srcName(XC30.purposeSrc)}</a></p>
        <div class="os-ser__brick">
          <p class="label">Для каких материалов</p>
          <p>«{nb(XC30.forBrick)}»</p>
          {xcNewOrOld && <p>{nb(xcNewOrOld.text)}</p>}
        </div>
        <div class="os-rate">
          <p class="os-rate__num num"><b>{xcRateText}</b> кг/м²</p>
          <p class="os-rate__text">расход на 1&nbsp;м² кладки: {xcRate.condition}</p>
        </div>
        <dl class="os-dl">
          {xcFacts.map(([dt, dd]) => <div><dt>{dt}</dt><dd class="num">{nb(dd)}</dd></div>)}
        </dl>
        <div class="os-ser__actions">
          <button class="btn btn--primary" type="button" data-ask={`${sXc30.name} — цвет подберём`}>Узнать цену</button>
          <a class="arrow-link" href={`#${sXc30.id}-cveta`}>Смотреть цвета <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="os-ser__specs" data-reveal>
        <Collapse max={560} fade="base" label="Все характеристики">
          <SpecTable rows={rowsOf(XC30)} caption={`Характеристики ${sXc30.name}`} />
        </Collapse>
        <p class="os-src">
          По данным производителя:
          {xcSources.map((x, i) => (
            <Fragment>{i > 0 && ' · '}<a href={x.url} rel="nofollow noopener" target="_blank">{x.name}</a></Fragment>
          ))}
        </p>
      </div>
    </div>
    <div class="os-colors-head">
      <h3 class="os-sub" id={`${sXc30.id}-cveta`}>{nb(`Цвета Бриксэйв ХС30 у нас — ${sXc30.colors.length}`)}</h3>
      <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
    </div>
    <p class="os-xc-note">
      Коды цветов у ХС30 те же, что у Брикформ; плашки показаны по палитре Брикформ производителя —
      у готовой расшивки оттенок может отличаться от кладочного раствора того же кода.
    </p>
    <SwatchGrid series={sXc30.id} />
    <SwatchNote />
  </Section>

  <Section id="kak-rabotat" kicker="Как работать" title="Кладка и расшивка по шагам" bg="alt" clamp={1150} clampLabel="Все шаги">
    <div class="os-steps">
      <div class="os-steps__col" data-reveal>
        <h3 class="os-steps__title">Кладка на Брикформ МС11 и&nbsp;МС11/1</h3>
        <ol class="os-steps__list">
          {brikformSteps.map((s) => <li>{nb(s.text)}</li>)}
        </ol>
      </div>
      <div class="os-steps__col" data-reveal>
        <h3 class="os-steps__title">Расшивка Бриксэйв ХС30</h3>
        <ol class="os-steps__list">
          {XC30.steps.map((s) => <li>{nb(s.text)}</li>)}
        </ol>
      </div>
    </div>
    <div class="os-color" data-reveal>
      <h3 class="os-color__title">От чего зависит цвет шва</h3>
      <ul class="os-color__list">
        {colorNotes.map((n) => <li>{nb(n.text)}</li>)}
      </ul>
    </div>
    <p class="os-src">
      По данным производителя:
      {sources([...stepsSources.map((x) => x.url), ...colorNotes.map((n) => n.src)]).map((x, i) => (
        <Fragment>{i > 0 && ' · '}<a href={x.url} rel="nofollow noopener" target="_blank">{x.name}</a></Fragment>
      ))}
    </p>
  </Section>

  <Section id="rashod" kicker="Расход" title={`Брикформ: ${rate.kgPerM2} кг на 1 м² кладки`} bg="base">
    <div class="os-calc">
      <div class="os-calc__norm" data-reveal>
        <p class="label">Норма производителя</p>
        <p class="os-calc__big num"><b>{rate.kgPerM2}</b> кг/м²</p>
        <p class="os-calc__cap">{rate.joint}, {wall} — норма одна для МС11 и МС11/1</p>
        <p class="os-src">
          По данным производителя: <a href={rate.src} rel="nofollow noopener" target="_blank">{srcName(rate.src)}</a>
        </p>
      </div>
      <div class="os-calc__example" data-reveal>
        <p class="label">Пример по этой норме</p>
        <dl class="os-calc__sum num">
          <div><dt>Площадь кладки</dt><dd>{exampleM2}&nbsp;м²</dd></div>
          <div><dt>Норма</dt><dd>× {rate.kgPerM2}&nbsp;кг/м²</dd></div>
          <div><dt>Сухой смеси</dt><dd>{exampleKg}&nbsp;кг</dd></div>
          <div class="os-calc__total"><dt>Мешков по {sMc11.packKg}&nbsp;кг</dt><dd>{exampleBags}</dd></div>
        </dl>
        <p class="os-calc__hint">
          Норма дана для шва 10&nbsp;мм и кладки в&nbsp;½&nbsp;кирпича. Для своей площади откройте калькулятор — Брикформ он считает по этой же норме.
        </p>
        <a class="btn btn--primary" href={PAGES.kalkulyator.href}>Открыть калькулятор расхода</a>
      </div>
    </div>
  </Section>

  <Section id="instrumenty" kicker="Инструменты производителя" title="Калькуляторы и видео Основит" bg="alt" clamp={900} clampLabel="Все инструменты">
    <ol class="os-tools" data-reveal-stagger>
      {tools.map((t) => (
        <li class="os-tool">
          <h3 class="os-tool__title">{t.title}</h3>
          <p class="os-tool__text">{nb(t.text)}</p>
          <a class="arrow-link os-tool__link" href={t.href} rel="nofollow noopener" target="_blank">{t.cta} <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ol>
  </Section>

  <Section id="voprosy" kicker="Вопросы" title="Частые вопросы об Основит" bg="base">
    <FaqAccordion items={faq} site="smesi" slug="osnovit" />
  </Section>

  <CtaBand
    source="osnovit"
    title={nb('Подберём Основит под ваш кирпич')}
    text={nb('Назовите кирпич и площадь кладки — подскажем, МС11 или МС11/1, поможем с цветом шва и посчитаем мешки.')}
  />
</Page>

<style is:global>
  /* Подпись секции на тёмной полосе: общий .section__kicker красит её --color-muted (#625d55),
     на туши это 2,6:1. Только для своей полосы «Зимние версии» (класс os-zima). */
  html[data-site='smesi'] .os-zima .section__kicker { color: rgb(247 244 238 / 0.66); }
</style>

<style>
  .os-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── первый экран: оглавление строками через линии ───────────────────────── */
  .os-jump { margin-top: var(--space-7); }
  .os-jump ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair-strong);
    counter-reset: os-jump;
  }
  .os-jump li { counter-increment: os-jump; border-bottom: 1px solid var(--hair); }
  .os-jump a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-height: 44px;
    padding: 12px 0 10px;
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
  }
  .os-jump a::before {
    content: counter(os-jump, decimal-leading-zero);
    flex: none;
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }
  .os-jump a::after {
    content: '↓';
    margin-left: auto;
    color: var(--color-muted);
    opacity: 0;
    translate: 0 -4px;
    transition: opacity var(--dur) var(--ease), translate var(--dur) var(--ease);
  }
  .os-jump a:hover::after, .os-jump a:focus-visible::after { opacity: 1; translate: 0 0; }

  /* ── первый экран: полосы оттенков вместо кадра кладки ───────────────────── */
  .os-pal { display: grid; gap: var(--space-5); justify-items: start; }
  .os-pal__item { width: 100%; }
  .os-pal__strip { height: clamp(160px, 24vw, 360px); }
  .os-pal__item--sm .os-pal__strip { height: clamp(44px, 4.6vw, 68px); }
  .os-pal__strip span { transition: flex-grow 0.5s var(--ease); }
  .os-pal__strip:hover span:hover { flex-grow: 3; }
  .os-pal__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    margin: 10px 0 0;
    font-size: var(--fs-tiny);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .os-pal__cap a { color: var(--ink); font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--hair-strong); }
  .os-pal__cap a:hover { border-color: var(--ink); }
  .os-pal__note { max-width: 46ch; margin: 0; font-size: var(--fs-small); color: var(--color-muted); }

  /* ── общее ──────────────────────────────────────────────────────────────── */
  .label { margin: 0 0 var(--space-3); }
  .os-src { max-width: 90ch; margin: var(--space-5) 0 0; font-size: var(--fs-tiny); line-height: 1.6; color: var(--color-muted); }
  .os-src a, .os-srclink { color: var(--color-text-soft); }
  .os-srclink { font-size: var(--fs-tiny); }
  .os-colors-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin: clamp(56px, 7vw, 104px) 0 var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair-strong);
  }
  .os-sub { margin: 0; font-size: var(--fs-h3); line-height: 1.05; letter-spacing: -0.01em; }

  /* ── 1. производитель: факты строками, объекты списком через линии ──────── */
  .os-maker { display: grid; gap: var(--space-8); }
  .os-maker__facts { margin: 0; border-top: 1px solid var(--hair-strong); }
  .os-maker__row { display: grid; gap: var(--space-2) var(--space-6); padding: var(--space-5) 0; border-bottom: 1px solid var(--hair); }
  .os-maker__row dt { margin: 0; padding-top: 5px; }
  .os-maker__row dd { margin: 0; }
  .os-maker__row :global(.os-nowrap) { white-space: nowrap; }
  .os-maker__row p { max-width: 58ch; margin: 0 0 var(--space-3); color: var(--color-text-soft); }
  @media (min-width: 760px) { .os-maker__row { grid-template-columns: 150px minmax(0, 1fr); } }

  .os-objects__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); counter-reset: os-obj; }
  .os-objects__list li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    column-gap: var(--space-3);
    padding: 14px 0 13px;
    border-bottom: 1px solid var(--hair);
    counter-increment: os-obj;
  }
  .os-objects__list li::before {
    content: counter(os-obj, decimal-leading-zero);
    grid-row: 1 / span 2;
    padding-top: 9px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }
  .os-objects__list b { font-family: var(--font-head); font-weight: 500; font-size: clamp(23px, 2vw, 28px); line-height: 1.1; }
