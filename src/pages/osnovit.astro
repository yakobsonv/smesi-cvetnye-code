---
// Страница бренда Основит (план, волна 1, № 4): брендовый спрос «основит брикформ мс11 …».
// Угол страницы — Брикформ под тип кирпича (МС11 или МС11/1), зимние версии и расшивка Бриксэйв ХС30.
//
// ФАКТЫ — только из данных (src/data):
//   назначение и «для какого кирпича» — ДОСЛОВНО из SERIES_FACTS (purpose / forBrick);
//   характеристики, шаги, оговорки о цвете, зимние версии — SERIES_FACTS, у каждой строки свой адрес;
//   расход — CONSUMPTION.osnovit (50 кг/м²) и CONSUMPTION.osnovitXc30 (5,0 кг/м²);
//   о производителе и его инструментах — BRAND_FACTS.osnovit;
//   ассортимент (22 цвета, фасовка) — catalog.ts.
// ⚠️ Число цветов Основит как факт производителя НЕ пишем (у производителя 34 / 32 / 23 / 22 в разных
//   местах) — только «у нас 22 цвета» (ассортимент дилера, OSNOVIT_COLORS).
// ⚠️ Зимних МС11 F и МС11/1 F в ассортименте дилера нет — описаны как факт производителя,
//   наличие — «уточняйте у менеджера»; цвета зимних версий не пишем (у производителя расходятся).
// ⚠️ В «Подборе дизайна фасада» у производителя названо число цветов шва — не переносим: читалось бы
//   как число цветов Основит.
// Цен нет: действие позиции — «Узнать цену» (атрибут data-ask, окно есть на странице через Page).
// Картинка — визуализация кладки из материалов клиента (kladka.ts); бренда у кадра нет, поэтому
// в подписи — оттенок шва, а не позиция Основит.
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import SpecTable from '../components/content/SpecTable.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import Collapse from '../components/ui/Collapse.astro';
import { seriesById, OSNOVIT_COLORS, POSITIONS, type SeriesId } from '../data/catalog';
import { SERIES_FACTS, CONSUMPTION, BRAND_FACTS, type SeriesFacts } from '../data/series-facts';
import { KLADKA } from '../data/kladka';
import { PAGES } from '../data/nav';
import { liveUrl } from '../lib/sites';
import type { FaqItem, SpecRow } from '../lib/types';

const MC11 = SERIES_FACTS['osnovit-mc11'];
const MC111 = SERIES_FACTS['osnovit-mc11-1'];
const XC30 = SERIES_FACTS['osnovit-xc30'];
const sMc11 = seriesById('osnovit-mc11');
const sMc111 = seriesById('osnovit-mc11-1');
const sXc30 = seriesById('osnovit-xc30');
const SERIES_HERE: SeriesId[] = ['osnovit-mc11', 'osnovit-mc11-1', 'osnovit-xc30'];

const colorsCount = OSNOVIT_COLORS.length;
const positionsCount = POSITIONS.filter((p) => SERIES_HERE.includes(p.series)).length;

/* ── помощники ─────────────────────────────────────────────────────────────── */

const spec = (f: SeriesFacts, label: string) => {
  const x = f.specs.find((s) => s.label === label);
  if (!x) throw new Error(`osnovit.astro: нет показателя «${label}»`);
  return x;
};
const rowsOf = (f: SeriesFacts): SpecRow[] => [...f.specs, ...f.packaging].map((x) => ({ label: x.label, value: x.value }));

/** Подпись источника по адресу (адреса — из данных, здесь только название ссылки). */
const SRC_NAMES: [RegExp, string][] = [
  [/Brikform-MC11-F\.pdf$/, 'техническая карта МС11 F'],
  [/Brikform-MC11\.1-F\.pdf$/, 'техническая карта МС11/1 F'],
  [/Brikform-MC11\.1\.pdf$/, 'техническая карта МС11/1'],
  [/Brikform-MC11\.pdf$/, 'техническая карта МС11'],
  [/Brikseyv-KHS30.*\.pdf$/, 'техническая карта ХС30'],
  [/brikform-ms11-1\/$/, 'страница МС11/1 на osnovit.ru'],
  [/brikform-ms11\/$/, 'страница МС11 на osnovit.ru'],
  [/brikseyv-xc30\/$/, 'страница ХС30 на osnovit.ru'],
  [/put-k-idealnoy-rasshivke/, 'статья производителя о расшивке'],
  [/ROSS-RU/, 'декларация соответствия'],
  [/o-kompanii/, 'раздел «О компании» на osnovit.ru'],
];
const srcName = (url: string) => SRC_NAMES.find(([re]) => re.test(url))?.[1] ?? 'osnovit.ru';
const sources = (urls: string[]) => [...new Set(urls)].map((url) => ({ url, name: srcName(url) }));
const factSources = (f: SeriesFacts) => sources([f.purposeSrc, f.forBrickSrc, ...f.specs.map((x) => x.src), ...f.packaging.map((x) => x.src)]);

const about = (needle: string) => {
  const x = BRAND_FACTS.osnovit.about.find((f) => f.text.includes(needle));
  if (!x) throw new Error(`osnovit.astro: нет факта о производителе «${needle}»`);
  return x;
};
const tool = (needle: string) => {
  const x = BRAND_FACTS.osnovit.tools.find((f) => f.text.includes(needle));
  if (!x) throw new Error(`osnovit.astro: нет инструмента «${needle}»`);
  return x;
};

/* ── первый экран ─────────────────────────────────────────────────────────── */

// Кадр кладки клиента: светлый кирпич с тёмным швом — контраст, который хорошо видно на превью.
const frameBrick = KLADKA.find((b) => b.id === 'osmibt-slonovaya-kost') ?? KLADKA[0];
const frame = frameBrick?.seams.find((s) => s.id === 'darkgrey') ?? frameBrick?.seams[0];

const jump = [
  { href: '#vybor', label: 'МС11 или МС11/1' },
  { href: `#${sMc11.id}`, label: 'Брикформ МС11' },
  { href: `#${sMc111.id}`, label: 'Брикформ МС11/1' },
  { href: '#zima', label: 'Зимние версии' },
  { href: `#${sXc30.id}`, label: 'Расшивка ХС30' },
  { href: '#rashod', label: 'Расход' },
];

/* ── 1. о производителе ───────────────────────────────────────────────────── */

const maker = [
  { title: 'Производство', text: 'Смеси выпускает ООО «Седрус». В декларации соответствия адрес места деятельности — Московская область, г. Коломна, Пирочинское шоссе, 13.', src: about('Коломна').src },
  { title: 'Документы', text: 'Декларация соответствия РОСС RU Д-RU.РА01.В.32635/25 по ГОСТ Р 58272-2018 действует до 11.02.2030. В перечне — колерованные Брикформ МС11, МС11/1 и Бриксэйв ХС30.', src: about('Декларация').src },
];
const objectsSrc = about('Зиларт').src;
const objects = [
  { name: 'ЖК «Зиларт»', place: 'Москва, ул. Автозаводская, вл. 23' },
  { name: 'ЖК «Коммунарка»', place: 'Москва' },
  { name: 'Микрорайон «Царицыно»', place: 'Москва' },
  { name: 'КП «Академия парк»', place: 'Москва' },
  { name: 'КП «Шервудский Лес»', place: 'Московская область' },
];

/* ── 2. МС11 или МС11/1 ───────────────────────────────────────────────────── */

type Cmp = { label: string; a: string; b: string; wide?: boolean };
const cmpLabels = ['Прочность на сжатие', 'Морозостойкость', 'Вода затворения', 'Жизнеспособность раствора', 'Толщина шва'];
const cmp: Cmp[] = [
  { label: 'Для какого кирпича', a: MC11.forBrick, b: MC111.forBrick, wide: true },
  ...cmpLabels.map((l) => ({ label: l, a: spec(MC11, l).value, b: spec(MC111, l).value })),
  { label: 'Мешок у нас', a: `${sMc11.packKg} кг`, b: `${sMc111.packKg} кг` },
  { label: 'Цветов у нас', a: String(sMc11.colors.length), b: String(sMc111.colors.length) },
];
const cmpSources = sources([
  MC11.forBrickSrc,
  MC111.forBrickSrc,
  ...cmpLabels.flatMap((l) => [spec(MC11, l).src, spec(MC111, l).src]),
]);

/* ── 3–4. серии Брикформ ─────────────────────────────────────────────────── */

const brikform = [
  {
    s: sMc11,
    f: MC11,
    bg: 'base' as const,
    kicker: 'Брикформ МС11',
    title: 'Брикформ МС11\u00a0— для кирпича до 12\u00a0% и клинкера',
    chips: [`мешок ${sMc11.packKg} кг`, `${sMc11.colors.length} цвета у нас`, `шов ${spec(MC11, 'Толщина шва').value.replace(' (рекомендуемая)', '')}`],
  },
  {
    s: sMc111,
    f: MC111,
    bg: 'alt' as const,
    kicker: 'Брикформ МС11/1',
    title: 'Брикформ МС11/1\u00a0— для кирпича более 12\u00a0% и ручной формовки',
    chips: [`мешок ${sMc111.packKg} кг`, `${sMc111.colors.length} цвета у нас`, `шов ${spec(MC111, 'Толщина шва').value.replace(' (рекомендуемая)', '')}`],
  },
];

/* ── 5. зимние версии ─────────────────────────────────────────────────────── */

// Пересказ brikformWinter() из series-facts.ts по пунктам — числа и запреты производителя без добавлений.
const winterRules = [
  'Температура воздуха и основания при нанесении — от −10 до +5 °C.',
  'Жизнеспособность раствора — 1 час.',
  'Мешки перед работой 24 часа выдерживают в тепле, воду для затворения подогревают до +10…+30 °C.',
  'Противоморозные и любые другие добавки вводить запрещено; количество воды особенно важно соблюдать.',
  'После работ 3 суток не допускать похолодания ниже −10 °C; при более сильном морозе работают только в тепловом контуре.',
];
const winterSources = sources([MC11.winter?.src ?? '', MC111.winter?.src ?? ''].filter(Boolean));

/* ── 6. ХС30 ──────────────────────────────────────────────────────────────── */

const xcRate = CONSUMPTION.osnovitXc30;
const xcRateText = xcRate.kgPerM2.toFixed(1).replace('.', ',');
const xcSources = sources([...factSources(XC30).map((x) => x.url), xcRate.src]);
const xcNewOrOld = XC30.notes?.find((n) => n.text.includes('нового строительства'));

/* ── 7. как работать ──────────────────────────────────────────────────────── */

// Шаги 2–8 у МС11 и МС11/1 совпадают слово в слово (технические карты 07.26); первый шаг — вода,
// у двух растворов норма разная, поэтому он собран из обоих.
const waterStep = {
  text: `Содержимое мешка при постоянном перемешивании высыпать в ёмкость с чистой водой: для МС11\u00a0— ${spec(MC11, 'Вода затворения').value} (2,5–3,75 л на мешок 25 кг), для МС11/1\u00a0— ${spec(MC111, 'Вода затворения').value}. Воду лить строго по норме производителя.`,
  src: MC11.steps[0]?.src ?? '',
};
const brikformSteps = [waterStep, ...MC11.steps.slice(1)];
const stepsSources = sources([...brikformSteps.map((s) => s.src), MC111.steps[0]?.src ?? '', ...XC30.steps.map((s) => s.src)].filter(Boolean));

// От чего зависит цвет шва: оговорки Брикформ (страница и техкарта) + совет из статьи о расшивке ХС30.
const colorNotes = [
  ...(MC11.notes ?? []),
  ...(XC30.notes ?? []).filter((n) => n.text.startsWith('Цвет проверяют')),
];

/* ── 8. расход ─────────────────────────────────────────────────────────────── */

const rate = CONSUMPTION.osnovit;
const wall = rate.wall.replace('1/2', '½');
const exampleM2 = 10;
const exampleKg = rate.kgPerM2 * exampleM2;
const exampleBags = Math.ceil(exampleKg / sMc11.packKg);
const bagsPerM2 = rate.kgPerM2 / sMc11.packKg;

/* ── 9. инструменты производителя ─────────────────────────────────────────── */

const tools = [
  {
    title: 'Кирпичный калькулятор',
    text: 'Выберите вид кирпича — калькулятор сам подберёт МС11 или МС11/1. Дальше формат кирпича, швы и количество: результат в мешках по 25\u00a0кг и общем весе. Швы по умолчанию — 10\u00a0мм вертикальный и 12\u00a0мм горизонтальный, по СП 70.13330.2012.',
    href: tool('Кирпичный калькулятор').src,
    cta: 'Открыть на osnovit.ru',
  },
  {
    title: 'Подбор дизайна фасада',
    text: 'Тип дома, часть здания, цвет кирпича и цвет шва кладки — вариант фасада можно распечатать.',
    href: tool('Подбор дизайна фасада').src,
    cta: 'Открыть на osnovit.ru',
  },
  {
    video: true,
    title: 'Видео о Брикформ МС11',
    text: 'Ролик производителя «Цветной кладочный раствор ОСНОВИТ БРИКФОРМ МС11».',
    href: tool('БРИКФОРМ МС11').src,
    cta: 'Смотреть на YouTube',
  },
  {
    video: true,
    title: 'Видео о Бриксэйв ХС30',
    text: 'Ролик производителя «Раствор для расшивки швов ОСНОВИТ БРИКСЭЙВ ХС 30».',
    href: tool('БРИКСЭЙВ ХС 30').src,
    cta: 'Смотреть на YouTube',
  },
];

/* ── 10. вопросы ──────────────────────────────────────────────────────────── */

const faq: FaqItem[] = [
  {
    q: 'Чем Брикформ МС11 отличается от МС11/1?',
    a: `<p>Кирпичом, под который рассчитан раствор. МС11: ${MC11.forBrick} МС11/1: ${MC111.forBrick}</p><p>Прочность на сжатие у обоих — ${spec(MC11, 'Прочность на сжатие').value}, морозостойкость — ${spec(MC11, 'Морозостойкость').value}. Отличается норма воды: ${spec(MC11, 'Вода затворения').value} у МС11 и ${spec(MC111, 'Вода затворения').value} у МС11/1.</p>`,
  },
  {
    q: 'Какой раствор Основит подходит для клинкерного кирпича?',
    a: '<p>Брикформ МС11: клинкерный кирпич производитель называет в его назначении. МС11/1 рассчитан на кирпич с водопоглощением более 12 % и кирпич ручной формовки.</p>',
  },
  {
    q: 'Сколько Брикформ нужно на 1 м² кладки?',
    a: `<p>По норме производителя — ${rate.kgPerM2} кг на 1 м² (${rate.joint}, ${wall}), то есть ${bagsPerM2} мешка по ${sMc11.packKg} кг. Норма одна для МС11 и МС11/1. На свою площадь посчитайте в <a href="${PAGES.kalkulyator.href}">калькуляторе расхода</a>.</p>`,
  },
  {
    q: 'Можно ли класть Основит зимой?',
    a: '<p>Для холодной погоды у производителя есть зимние версии — Брикформ МС11 F и МС11/1 F: нанесение при температуре воздуха и основания от −10 до +5 °C, жизнеспособность раствора 1 час, противоморозные и любые другие добавки вводить запрещено. Наличие зимних версий уточняйте у менеджера.</p>',
  },
  {
    q: 'Когда нужен Бриксэйв ХС30, а не Брикформ?',
    a: `<p>Брикформ — цветной кладочный раствор: шов можно расшить сразу при укладке. ХС30 — для отделки швов уже готовой кладки: новой или той, где швы обновляют. Кладка должна выстояться не менее 3–4 недель, швы расчищают на глубину не менее 1,5–2 см. Расход ХС30 — ${xcRateText} кг на 1 м² (${xcRate.condition}).</p>`,
  },
  {
    q: 'Почему шов может выглядеть не так, как образец?',
    a: '<p>По словам производителя, на цвет шва влияют количество воды, способ и время расшивки, условия твердения и инструмент. Заявленный цвет появляется только после полного высыхания, а небольшие отклонения от демонстрационного образца допускаются — поэтому перед началом работ производитель советует сделать пробную кладку и согласовать оттенок.</p>',
  },
];

/* ── микроразметка ─────────────────────────────────────────────────────────── */

const pageUrl = liveUrl('smesi', 'osnovit');
const itemList = {
  '@type': 'ItemList',
  name: 'Растворы Основит: Брикформ МС11, Брикформ МС11/1, Бриксэйв ХС30',
  numberOfItems: SERIES_HERE.length,
  itemListElement: SERIES_HERE.map((id, i) => ({ '@type': 'ListItem', position: i + 1, name: seriesById(id).name, url: `${pageUrl}#${id}` })),
};
---

<Page
  title="Основит Брикформ МС11 и МС11/1, расшивка Бриксэйв ХС30 — Москва"
  description={`Цветные кладочные растворы Основит Брикформ МС11 и МС11/1 под тип кирпича и расшивка Бриксэйв ХС30: у нас ${colorsCount} цвета, характеристики, нормы расхода.`}
  slug="osnovit"
  current="osnovit"
  source="osnovit"
  ogImage={frame?.src}
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Производитель Основит"
    h1="Цветные кладочные растворы Основит Брикформ"
    crumb="Основит"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={`Раствор Основит подбирают по кирпичу: МС11 — для облицовочного кирпича с водопоглощением до 12\u00a0% и клинкера, МС11/1 — для кирпича более 12\u00a0% и ручной формовки. Готовые швы отделывают Бриксэйв ХС30. У нас ${colorsCount}\u00a0цвета каждого раствора — ${positionsCount}\u00a0позиций.`}
  >
    <nav class="os-jump" aria-label="Разделы страницы" data-reveal>
      {jump.map((j) => <a href={j.href}>{j.label}</a>)}
    </nav>
    <Fragment slot="aside">
    {frame && frameBrick && (
      <figure class="os-frame">
        <img
          src={frame.src}
          srcset={`${frame.srcSm} 320w, ${frame.src} ${frame.w}w`}
          sizes="(min-width: 960px) 44vw, 92vw"
          width={frame.w}
          height={frame.h}
          alt={`Визуализация кладки: кирпич «${frameBrick.brick}», ${frame.label} шов`}
          fetchpriority="high"
        />
        <figcaption>
          Визуализация кладки: кирпич «{frameBrick.brick}», шов {frame.label}.
          <span>Кадр показывает оттенок шва, а не конкретный раствор.</span>
        </figcaption>
      </figure>
    )}
    </Fragment>
  </PageHead>

  <Section id="proizvoditel" kicker="Производитель" title="Основит — растворы из Коломны" bg="base">
    <div class="os-maker">
      <ul class="os-maker__facts" data-reveal-stagger>
        {maker.map((m) => (
          <li>
            <h3 class="os-maker__title">{m.title}</h3>
            <p>{m.text}</p>
            <a class="os-src-link" href={m.src} rel="nofollow noopener" target="_blank">{srcName(m.src)}</a>
          </li>
        ))}
      </ul>
      <aside class="os-objects" data-reveal>
        <p class="os-label">Объекты на Брикформ МС11</p>
        <ul class="os-objects__list">
          {objects.map((o) => (
            <li><b>{o.name}</b><span>{o.place}</span></li>
          ))}
        </ul>
        <p class="os-objects__src">
          Список объектов — <a href={objectsSrc} rel="nofollow noopener" target="_blank">{srcName(objectsSrc)}</a>
        </p>
      </aside>
    </div>
  </Section>

  <Section
    id="vybor"
    kicker="Выбор раствора"
    title="МС11 или МС11/1: решает кирпич"
    subtitle="Прочность, морозостойкость и толщина шва у двух растворов одинаковые. Главное различие — кирпич, под который рассчитан раствор; норма воды у каждого своя."
    bg="alt"
  >
    <div class="os-cmp" data-reveal>
      <table class="os-cmp__table">
        <thead>
          <tr>
            <th scope="col"><span class="os-visually-hidden">Показатель</span></th>
            <th scope="col"><a href={`#${sMc11.id}`}>Брикформ МС11</a><span>{spec(MC11, 'Водопоглощение кирпича').value}</span></th>
            <th scope="col"><a href={`#${sMc111.id}`}>Брикформ МС11/1</a><span>{spec(MC111, 'Водопоглощение кирпича').value}</span></th>
          </tr>
