---
// Белая кладочная смесь (план, волна 1): самый частый запрос по цвету — белый и супер-белый шов.
// Угол страницы: какая белая смесь под какой кирпич, белый шов на готовой кладке (расшивка),
// все белые оттенки Perel и Основит рядом и почему светлый шов пачкается.
// С 23.10 в композиции белых оттенков и в «Под ваш кирпич» — и Promix, и Стройбриг (catalog.ts): у них только
// ассортимент дилера, поэтому без цитат производителя и без ссылки на характеристики — ссылка на их цвета в каталоге.
//
// Редизайн 11.10 (Влад: «шаблон не нужно использовать тот же, ещё и везде кирпич»): кадров кладки на странице
// больше нет — цвет дают только образцы раствора. Как белый шов смотрится на кирпиче, показывает инструмент
// /podbor-shva/ (ссылка из композиции оттенков). Блоки — линиями и колонками, без карточек-коробок.
//
// ФАКТЫ — только из src/data:
//   • позиции, коды и артикулы белых цветов — catalog.ts (ассортимент дилера), оттенки плашек — swatches.ts;
//   • «для какого кирпича» и назначение — ДОСЛОВНО из series-facts.ts (forBrick / purpose) со ссылкой на источник;
//   • белый шов и загрязнение — LIGHT_JOINT_FACTS; советы при работе — шаги и оговорки серий (series-facts.ts);
//     в тексте страницы они пересказаны короче, источник каждого — ссылкой рядом;
//   • расход — CONSUMPTION.
// Чем супер-белый отличается от белого по составу — у производителей фактов нет, на странице не пишем.
// Цен нет намеренно (см. catalog.ts): действие позиции — окно «Узнать цену».
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import SpecTable from '../components/content/SpecTable.astro';
import { BRICK_TYPES, POSITIONS, SERIES, BRANDS, BRAND_LIST, seriesById, seriesFor, seriesHref, type Brand, type BrickType, type FactSeriesId, type Position, type SeriesId } from '../data/catalog';
import { swatchFor } from '../data/swatches';
import { SERIES_FACTS, LIGHT_JOINT_FACTS, CONSUMPTION, hasFacts, type SeriesFacts } from '../data/series-facts';
import { PAGES } from '../data/nav';
import { plural } from '../lib/format';
import { nb as typo } from '../lib/typo';
import type { FaqItem, SpecRow } from '../lib/types';

/* ── Позиции ─────────────────────────────────────────────────────────────── */

const isWhite = (id: string) => POSITIONS.filter((p) => p.series === id && p.color.tone === 'white');
const kladkaSeries = SERIES.filter((s) => s.purpose === 'kladka');
const rasshivkaSeries = SERIES.filter((s) => s.purpose === 'rasshivka');
const whiteKladka = kladkaSeries.flatMap((s) => isWhite(s.id));
const whiteRasshivka = rasshivkaSeries.flatMap((s) => isWhite(s.id));
const whites = [...whiteKladka, ...whiteRasshivka];

// Лид обещает «белый и супер-белый в каждой кладочной серии» — проверяем на данных при сборке.
for (const s of kladkaSeries) {
  if (isWhite(s.id).length < 2) throw new Error(`belaya: у ${s.name} меньше двух белых цветов — поправьте лид страницы`);
}

/* ── Помощники ───────────────────────────────────────────────────────────── */

/** Какие серии ссылаются на адрес источника — чтобы подпись ссылки называла товар, а не только домен. */
const URL_SERIES = new Map<string, Set<SeriesId>>();
for (const [id, f] of Object.entries(SERIES_FACTS) as [FactSeriesId, SeriesFacts][]) {
  const urls = [f.purposeSrc, f.forBrickSrc, ...f.specs.map((x) => x.src), ...f.packaging.map((x) => x.src), ...f.steps.map((x) => x.src), ...(f.notes ?? []).map((x) => x.src), f.winter?.src];
  for (const u of urls) {
    if (!u) continue;
    if (!URL_SERIES.has(u)) URL_SERIES.set(u, new Set());
    URL_SERIES.get(u)!.add(id);
  }
}

/** Подпись ссылки на источник: домен и что это за страница. */
function srcLabel(url: string): string {
  const u = new URL(url);
  const host = u.hostname.replace(/^www\./, '');
  const path = u.pathname.toLowerCase();
  if (host.includes('youtube')) return 'видео производителя';
  if (host === 'tekato.ru') return 'каталог Perel, PDF';
  if (path.includes('/articles/')) return `${host}, статья`;
  // разделы td-perel.ru, на которые ссылаются сразу три серии: без пометки подпись была голым доменом
  if (path.endsWith('/belaya-kladochnaya-smes/')) return `${host}, белая кладочная смесь`;
  if (path.endsWith('/catalog/tsvetnaya-kladochnaya-smes/')) return `${host}, цветные кладочные смеси`;
  const ids = [...(URL_SERIES.get(url) ?? [])];
  const name = ids.length === 1 ? seriesById(ids[0]).name.replace(/^Основит /, '') : '';
  if (path.endsWith('.pdf')) return name ? `${host}, техкарта ${name}` : `${host}, PDF`;
  if (name && /-kg\/?$/.test(path)) return `${host}, карточка ${name}`;
  if (name) return `${host}, ${name}`;
  return host;
}
const uniq = <T,>(list: T[]) => [...new Set(list)];

function pick<T extends { text: string }>(list: T[] | undefined, needle: string, where: string): T {
  const f = list?.find((x) => x.text.includes(needle));
  if (!f) throw new Error(`belaya: в ${where} нет факта «${needle}»`);
  return f;
}
const ljf = (needle: string) => pick(LIGHT_JOINT_FACTS, needle, 'LIGHT_JOINT_FACTS');
const step = (id: FactSeriesId, needle: string) => pick(SERIES_FACTS[id].steps, needle, `${id}.steps`);
const note = (id: FactSeriesId, needle: string) => pick(SERIES_FACTS[id].notes, needle, `${id}.notes`);
const num = (n: number | string) => String(n).replace('.', ',');
/** диапазон «3–4» не рвём на строки: по краям тире — невидимая «склейка» (U+2060);
 *  число не отрываем от единицы (то же делает typo), короткий предлог — от следующего слова;
 *  тире (и дефис-тире в цитатах производителя «SL - для…») не начинает строку */
const nb = (t: string) =>
  typo(t.replace(/(\d)–(\d)/g, '$1\u2060–\u2060$2').replace(/ ([-–—]) /g, '\u00a0$1 '));
const andList = (xs: string[]) => (xs.length > 1 ? `${xs.slice(0, -1).join(', ')} и ${xs[xs.length - 1]}` : xs.join(''));
const brandHref = (id: SeriesId) => seriesHref(seriesById(id));
const pad2 = (i: number) => String(i + 1).padStart(2, '0');

/* ── 1. Все белые оттенки: композиция образцов ───────────────────────────── */

// Колонка — белый цвет производителя: крупная плашка — кладочные серии этого цвета, под ней мелкая —
// раствор для расшивки с тем же названием цвета (если он есть). Плашка — оттенок с палитры производителя
// (swatches.ts); у расшивочных RL и ХС30 оттенок снят с фотографий образцов, поэтому своя плашка.
// Клик по плашке — окно «Узнать цену» с названием цвета и артикулами.
const brandOf = (p: Position) => seriesById(p.series).brand;
const short = (id: SeriesId) => seriesById(id).name.replace(/^Perel /, '').replace(/^Основит (Брикформ )?/, '');
const isSuper = (n: string) => n.startsWith('супер');
/** «супер-белый» не рвём по дефису: на телефоне строка ломалась «супер-/белого» */
const nbHyph = (t: string) => t.replace(/-/g, '\u2011');
const GENITIVE: Record<string, string> = { 'супер-белый': 'супер-белого', супербелый: 'супербелого', белый: 'белого' };
const RS_NAME: Partial<Record<SeriesId, string>> = { 'perel-rl': 'затирки Perel RL', 'osnovit-xc30': 'раствора Бриксэйв ХС30' };

// все марки каталога, в порядке BRANDS (Perel, Основит, Promix, Стройбриг)
const brandOrder = Object.keys(BRANDS) as Brand[];
const palette = brandOrder.map((b) => {
  const kl = whiteKladka.filter((p) => brandOf(p) === b);
  const names = uniq(kl.map((p) => p.color.name)).sort((x, y) => Number(isSuper(y)) - Number(isSuper(x)));
  const rsSeries = rasshivkaSeries.filter((s) => s.brand === b);
  return {
    b,
    name: BRANDS[b].name,
    cols: names.map((n) => {
      const top = kl.filter((p) => p.color.name === n);
      const bottom = whiteRasshivka.filter((p) => brandOf(p) === b && p.color.name === n);
      const missing = rsSeries
        .filter((s) => !bottom.some((p) => p.series === s.id))
        .map((s) => {
          if (!RS_NAME[s.id] || !GENITIVE[n]) throw new Error(`belaya: нет подписи «у ${s.name} нет ${n}»`);
          return nb(`У ${RS_NAME[s.id]} ${nbHyph(GENITIVE[n])} нет`);
        });
      return {
        n,
        top,
        bottom,
        hex: swatchFor(top[0].series, top[0].color.code),
        ask: `${BRANDS[b].name}, ${n} — ${top.map((p) => `${short(p.series)} ${p.article}`).join(', ')}`,
        missing,
      };
    }),
  };
});
// каждая белая позиция попадает в композицию ровно один раз — иначе цифры шапки и плашки разойдутся
if (palette.flatMap((g) => g.cols.flatMap((c) => [...c.top, ...c.bottom])).length !== whites.length) {
  throw new Error('belaya: не все белые позиции попали в композицию оттенков');
}

// Полоса первого экрана: все разные плашки белых позиций, от самой светлой к самой тёмной.
const lum = (hex: string) => {
  const v = parseInt(hex.slice(1), 16);
  return 0.2126 * ((v >> 16) & 255) + 0.7152 * ((v >> 8) & 255) + 0.0722 * (v & 255);
};
const heroStrip = uniq(whites.map((p) => swatchFor(p.series, p.color.code))).sort((a, b) => lum(b) - lum(a));

/* ── 2. Белые смеси под кирпич ───────────────────────────────────────────── */

const typeOrder: BrickType[] = ['obychnyj', 'ruchnoj', 'klinker'];
const byBrick = typeOrder.map((t) => ({
  t,
  info: BRICK_TYPES[t],
  // у Promix и Стройбриг данных производителя нет — f: null, цитату не показываем
  series: seriesFor(t).map((s) => ({ s, f: hasFacts(s.id) ? SERIES_FACTS[s.id] : null })),
}));
const pickRule = ljf('подбирают так же');

/* ── 3. Расшивка ─────────────────────────────────────────────────────────── */

function rasshivkaRows(id: FactSeriesId): { rows: SpecRow[]; srcs: string[] } {
  const f = SERIES_FACTS[id];
  const width = f.specs.find((x) => x.label === 'Ширина шва');
  const bag = f.packaging.find((x) => x.label === 'Мешок');
  const rows: SpecRow[] = [];
  const srcs: string[] = [];
  if (width) { rows.push({ label: 'Ширина шва', value: width.value }); srcs.push(width.src); }
  if (bag) { rows.push({ label: 'Мешок', value: bag.value }); srcs.push(bag.src); }
  if (id === 'perel-rl') {
    const c = CONSUMPTION.perelRl;
    rows.push({ label: 'Расход', value: `${num(c.kgPerM2Min)}–${num(c.kgPerM2Max)} кг/м²`, note: 'в зависимости от ширины швов и формата облицовочного материала' });
    srcs.push(c.src);
  }
  if (id === 'osnovit-xc30') {
    const c = CONSUMPTION.osnovitXc30;
    rows.push({ label: 'Расход', value: `${num(c.kgPerM2.toFixed(1))} кг/м²`, note: c.condition });
    srcs.push(c.src);
  }
  return { rows, srcs: uniq([f.purposeSrc, ...srcs]) };
}
const rasshivka = rasshivkaSeries.flatMap((s) => (hasFacts(s.id) ? [{ s, f: SERIES_FACTS[s.id], ...rasshivkaRows(s.id) }] : []));

// Как делают белый шов на готовой кладке — пересказ технической карты Бриксэйв ХС30 и карточки Perel RL.
const xc = {
  wait: step('osnovit-xc30', 'выстояться'),
  fill: step('osnovit-xc30', 'вдавить раствор'),
  cure: step('osnovit-xc30', 'увлажнить швы пульверизатором'),
  renew: note('osnovit-xc30', 'обновления швов'),
};
const rlShape = step('perel-rl', 'мокрого песка');
// порядок — по технической карте Бриксэйв ХС30 (все шаги из одного источника)
const howTo = [
  'Расшивать начинают, когда кладка простоит не меньше 3–4 недель и раствор в ней наберёт марочную прочность.',
  'Швы расчищают на одну глубину по всей стене — не меньше 1,5–2 см, чистят щёткой с жёстким ворсом и увлажняют; во время расшивки воды в швах быть не должно.',
  'Раствор вдавливают в шов с избытком, лишнее снимают кельмой вровень с кладкой и придают шву форму.',
  'Сразу после работ швы увлажняют пульверизатором и держат влажными, пока раствор твердеет; не меньше 5–7 дней свежие швы закрывают плёнкой от прямого солнца, сильного ветра и дождя.',
];
const howToSrc = uniq([xc.wait.src, xc.fill.src, xc.cure.src]);

/* ── 4. Почему светлый шов пачкается ─────────────────────────────────────── */

const why = [
  { title: 'Пыль и органика из воздуха', text: 'Со временем они дают фасаду грязные оттенки, и больше всего этому подвержены материалы светлых тонов.', srcs: [ljf('Пыль').src] },
  {
    title: 'Инструмент из чёрных металлов',
    text: 'Он может изменить цвет шва, поэтому Основит не рекомендует им работать, а ржавым инструментом расшивать запрещает.',
    srcs: uniq([step('osnovit-xc30', 'чёрных металлов').src, step('osnovit-mc11', 'ржавым').src]),
  },
];
const choose = [
  { text: 'Для белого шва Perel называет оптимальным вариантом готовую белую кладочную смесь.', src: ljf('оптимальный вариант').src },
  { text: 'В белой смеси Perel — европейские пигменты и компоненты: по словам производителя, они дают шву высокую стабильность цвета и невосприимчивость к осадкам и солнцу.', src: ljf('Белый раствор применяется').src },
  { text: 'Perel пишет о годичных испытаниях в своей лаборатории: диоксид титана в кладочных растворах и расшивках помогает светлым оттенкам несколько лет оставаться чистыми и яркими.', src: ljf('диоксид титана').src },
];
const work = [
  { text: 'Сначала расшить на пробу небольшой участок — так видно, не меняет ли инструмент цвет шва.', src: step('osnovit-mc11', 'пробную расшивку').src },
  { text: 'Раствор с кирпича снимать сразу — ветошью или поролоновой губкой, не заливая кладку водой.', src: step('osnovit-mc11', 'ветошью').src },
  { text: 'Первые 5–7 суток закрывать свежую кладку от прямого солнца и осадков — иначе на цветном растворе может проступить разница в цвете.', src: step('osnovit-mc11', '5–7 суток').src },
  { text: 'Замешивать всё время на одном количестве воды: если оно изменится по ходу работ, может измениться и оттенок шва.', src: note('osnovit-xc30', 'количеством воды').src },
];

/* ── 5. Вопросы ──────────────────────────────────────────────────────────── */

const perelKladka = kladkaSeries.filter((s) => s.brand === 'perel');
const articlesOf = (series: typeof SERIES, colorName: string) =>
  series.flatMap((s) => isWhite(s.id).filter((p) => p.color.name === colorName).map((p) => p.article));
const rlWhite = isWhite('perel-rl');
const osnovitWhite = isWhite('osnovit-mc11');
const perel1nf = CONSUMPTION.perel.perBrick.find((x) => x.format === '1-НФ');
const fNl = SERIES_FACTS['perel-nl'];
const fMc11 = SERIES_FACTS['osnovit-mc11'];
const groutNote = note('perel-rl', 'нельзя заменять');
const colorNote = note('osnovit-mc11', 'полного высыхания');
const trialNote = note('osnovit-mc11', 'пробную кладку');
/** ссылка на источник внутри ответа (в FAQPage уходит только текст) */
const aSrc = (url: string, label = srcLabel(url)) => `<a href="${url}" rel="nofollow noopener" target="_blank">${label}</a>`;

const faq: FaqItem[] = [
  {
    q: 'Какие белые цвета есть у Perel и Основит?',
    a: `<p>У Perel в кладочных сериях ${andList(perelKladka.map((s) => s.name.replace('Perel ', '')))} — супер-белый (артикулы ${articlesOf(perelKladka, 'супер-белый').join(', ')}) и белый (${articlesOf(perelKladka, 'белый').join(', ')}). У затирки Perel RL супер-белого нет, белый — ${rlWhite.map((p) => p.article).join(', ')}.</p><p>У Основит в Брикформ МС11, МС11/1 и в растворе для расшивки Бриксэйв ХС30 — ${osnovitWhite.map((p) => `${p.color.name} (цвет ${p.article})`).join(' и ')}.</p>`,
  },
  {
    q: 'Какая белая смесь нужна для клинкерного кирпича?',
    a: `<p>Perel NL — производитель относит эту серию к клинкерному кирпичу с низким водопоглощением, 0–5 % (${aSrc(fNl.forBrickSrc)}). Подходит и Основит Брикформ МС11: в его назначении клинкерный кирпич назван отдельно (${aSrc(fMc11.forBrickSrc)}). В обеих сериях есть белый и супер-белый.</p>`,
  },
  {
    q: 'Можно ли вместо затирки взять белый кладочный раствор?',
    a: `<p>Perel против такой замены: цветную декоративную затирку цветным кладочным раствором не заменяют — производитель посвятил этому ${aSrc(groutNote.src, 'отдельное видео')}. Для белого шва на готовой кладке есть затирка Perel RL и раствор для расшивки Основит Бриксэйв ХС30.</p>`,
  },
  {
    q: 'Сколько нужно белой смеси?',
    a: `<p>Perel считает расход на кирпич${perel1nf ? `: для формата 1-НФ (${perel1nf.size} мм) — ${num(perel1nf.kgMin)}–${num(perel1nf.kgMax)} кг сухой смеси на штуку` : ''}; у SL, VL и NL норма общая (${aSrc(CONSUMPTION.perel.src)}). У Основит Брикформ — ${CONSUMPTION.osnovit.kgPerM2} кг на 1 м² кладки, ${CONSUMPTION.osnovit.joint}, ${CONSUMPTION.osnovit.wall} (${aSrc(CONSUMPTION.osnovit.src)}). Для расшивки: Perel RL — ${num(CONSUMPTION.perelRl.kgPerM2Min)}–${num(CONSUMPTION.perelRl.kgPerM2Max)} кг/м², Основит ХС30 — ${num(CONSUMPTION.osnovitXc30.kgPerM2.toFixed(1))} кг/м² (${CONSUMPTION.osnovitXc30.condition}).</p><p>Точное число мешков для вашей стены — в <a href="${PAGES.kalkulyator.href}">калькуляторе расхода</a>.</p>`,
  },
  {
    q: 'Почему шов на стене выглядит не так, как образец?',
    a: `<p>Оттенок шва зависит не только от смеси. Основит называет количество воды затворения, способ и время расшивки, условия, в которых твердеет раствор, и инструмент; свой цвет раствор набирает, лишь когда полностью высохнет, а восприятие меняют свет и время суток (${aSrc(colorNote.src)}). Поэтому производитель советует начать с пробной кладки и согласовать по ней оттенок (${aSrc(trialNote.src)}).</p>`,
  },
];

/* ── Микроразметка ───────────────────────────────────────────────────────── */

const kladkaWord = plural(whiteKladka.length, 'позиция', 'позиции', 'позиций');

const itemList = {
  '@type': 'ItemList',
  name: 'Белые кладочные смеси и растворы для расшивки швов',
  numberOfItems: whites.length,
  itemListElement: whites.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title })),
};
---

<Page
  title={`Белая кладочная смесь для облицовочного кирпича — ${BRAND_LIST}`}
  description={`Белая и супербелая кладочная смесь ${BRAND_LIST}: ${whiteKladka.length} ${kladkaWord} для обычного кирпича, ручной формовки и клинкера, белые растворы для расшивки швов.`}
  slug="belaya-kladochnaya-smes"
  current="belaya"
  source="belaya"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Белый шов"
    h1="Белая кладочная смесь для облицовочного кирпича"
    crumb="Белая кладочная смесь"
    trail={[{ label: PAGES.katalog.label, href: PAGES.katalog.href }]}
    lead={`Белый и супербелый цвет есть в каждой кладочной серии ${BRAND_LIST} — под обычный облицовочный кирпич, ручную формовку и клинкер. Для уже уложенной кладки — белые растворы для расшивки швов.`}
  >
    <div class="bh__actions" data-reveal>
      <a class="btn btn--primary" href="#pod-kirpich">Выбрать под свой кирпич</a>
      <button class="btn btn--ghost" type="button" data-ask="Белая кладочная смесь — серию подберём под кирпич">Узнать цену</button>
    </div>
    <div class="bh__aside" slot="aside">
      <a class="bh__strip strip" href="#galereya" aria-label={`Все белые оттенки ${BRAND_LIST}`}>
        {heroStrip.map((c) => <span class="mortar" style={`--c:${c}`}></span>)}
      </a>
      <p class="bh__cap label">Белые оттенки {BRAND_LIST}</p>
      <dl class="bh__stats">
        <div><dt>{plural(whiteKladka.length, 'позиция', 'позиции', 'позиций')} для кладки</dt><dd class="num">{whiteKladka.length}</dd></div>
        <div><dt>{plural(whiteRasshivka.length, 'позиция', 'позиции', 'позиций')} для расшивки</dt><dd class="num">{whiteRasshivka.length}</dd></div>
        <div><dt>{plural(kladkaSeries.length, 'кладочная серия', 'кладочные серии', 'кладочных серий')} с белым</dt><dd class="num">{kladkaSeries.length}</dd></div>
      </dl>
    </div>
  </PageHead>

  <Section
    id="galereya"
    kicker="Все белые оттенки"
    title={`Супербелый и белый у ${BRAND_LIST}`}
    subtitle="Крупные образцы — кладочные смеси, под ними — белые растворы для расшивки готовой кладки. Нажмите на образец, чтобы узнать цену и наличие."
    bg="dark"
  >
    <div class="wh" data-reveal>
      {palette.map((g) => (
        <div class:list={['wh__brand', `wh__brand--${g.b}`]} role="group" aria-label={`Белые оттенки ${g.name}`}>
          <p class="wh__bname">{g.name}</p>
          <ul class="wh__cols">
            {g.cols.map((c) => (
              <li class="wh__col">
                <button class="wh__plate wh__plate--top mortar" type="button" style={`--c:${c.hex}`} data-ask={c.ask} aria-label={`${c.ask} — узнать цену`}></button>
                <p class="wh__name">{nbHyph(c.n)}</p>
                <p class="wh__codes num">
                  {c.top.map((p) => <span>{short(p.series)} <b>{p.article}</b></span>)}
                </p>
                {c.bottom.map((p) => (
                  <Fragment>
                    <button class="wh__plate wh__plate--sub mortar" type="button" style={`--c:${swatchFor(p.series, p.color.code)}`} data-ask={p.title} aria-label={`${p.title} — узнать цену`}></button>
                    <p class="wh__subcap"><span class="wh__kind">расшивка</span> <span class="num">{short(p.series)} <b>{p.article}</b></span></p>
                  </Fragment>
                ))}
                {c.missing.map((t) => <p class="wh__miss">{t}</p>)}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <div class="wh__foot">
      <div class="wh__podbor" data-reveal>
        <p>{nb('Как белый шов выглядит в кладке из разного кирпича — в подборе шва.')}</p>
        <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
      </div>
      <SwatchNote series={whites.map((p) => p.series)} />
    </div>
  </Section>

  <Section
    id="pod-kirpich"
    kicker="Под ваш кирпич"
    title="Белые смеси под ваш кирпич"
    subtitle="Белый и супербелый есть в каждой кладочной серии, поэтому выбирают не цвет, а серию — под водопоглощение кирпича. Чтобы узнать цену и наличие, нажмите на нужный образец."
    bg="alt"
  >
    <p class="rule" data-reveal>
      {nb('Белую смесь подбирают так же, как цветную: у Perel водопоглощению 5–12 % соответствует серия SL, 0–5 % — NL, 5–17 % — VL.')}
      <a class="src-link" href={pickRule.src} rel="nofollow noopener" target="_blank">{srcLabel(pickRule.src)}</a>
    </p>

    <ol class="bw-list">
      {byBrick.map((row, i) => (
        <li class="bw" id={`belaya-${row.t}`} data-reveal>
          <header class="bw__head">
            <p class="bw__num label num">{pad2(i)}</p>
            <h3 class="bw__title">{nb(row.info.label)}</h3>
            <p class="bw__abs">
              <span class="bw__range num">{nb(row.info.absorption)}</span>
              <span class="label">{row.info.note}</span>
            </p>
            <div class="bw__links">
              <a class="arrow-link" href={`${PAGES.katalog.href}?kirpich=${row.t}`}>Все цвета для этого кирпича <span aria-hidden="true">→</span></a>
              {row.t === 'klinker' && (
                <a class="arrow-link" href={PAGES.klinker.href}>Смеси для клинкера подробно <span aria-hidden="true">→</span></a>
              )}
            </div>
          </header>
          <div class="bw__series">
            {row.series.map(({ s, f }) => (
              <div class="bw__ser">
                <div class="bw__shead">
                  <h4 class="bw__sname">{s.name}</h4>
                  <p class="bw__pack label num">мешок {s.packKg}{'\u00a0'}кг</p>
                </div>
                <SwatchGrid series={s.id} tones={['white']} showSeries />
                {f && (
                  <figure class="bw__quote">
                    <blockquote><p>«{nb(f.forBrick)}»</p></blockquote>
                    <figcaption class="src">По данным производителя: <a href={f.forBrickSrc} rel="nofollow noopener" target="_blank">{srcLabel(f.forBrickSrc)}</a></figcaption>
                  </figure>
                )}
                <p class="bw__specp"><a class="arrow-link bw__spec" href={brandHref(s.id)}>{f ? 'Характеристики' : 'Все цвета'} {s.name}{'\u00a0'}<span aria-hidden="true">→</span></a></p>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>
    <SwatchNote series={byBrick.flatMap((row) => row.series.map(({ s }) => s.id))} />
  </Section>

  <Section
    id="rasshivka"
    kicker="Готовая кладка"
    title="Белый шов расшивкой"
    subtitle="Если кирпич уже уложен или старые швы пора обновить, белый шов делают раствором для расшивки: швы расчищают и заполняют заново."
    bg="base"
  >
    <div class="rs">
      {rasshivka.map(({ s, f, rows, srcs }) => (
        <article class="rs__col" data-reveal>
          <p class="label">Для расшивки швов · {BRANDS[s.brand].name}</p>
          <h3 class="rs__title"><a href={brandHref(s.id)}>{s.name}</a></h3>
          <blockquote class="rs__quote"><p>«{nb(f.purpose)}»</p></blockquote>
          <SwatchGrid series={s.id} tones={['white']} showSeries />
          <SpecTable rows={rows} class="rs__specs" />
          <p class="src">
            По данным производителя:{' '}
            {srcs.map((u, k) => (
              <Fragment>{k > 0 && ' · '}<a href={u} rel="nofollow noopener" target="_blank">{srcLabel(u)}</a></Fragment>
            ))}
          </p>
        </article>
      ))}
    </div>

    <div class="how" data-reveal>
      <div class="how__head">
        <p class="label">Порядок работ</p>
        <h3 class="how__title">{nb('Как делают белый шов на готовой кладке')}</h3>
        <p class="how__lead">
          Порядок — по технической карте Основит Бриксэйв ХС30. Производитель пишет, что этот раствор подходит
          и для нового строительства, и для обновления швов кладки.
        </p>
      </div>
      <div class="how__body">
        <ol class="how__list">
          {howTo.map((t, i) => (
            <li><span class="how__n num" aria-hidden="true">{pad2(i)}</span><p>{nb(t)}</p></li>
          ))}
        </ol>
        <p class="how__note">
          {nb('У затирки Perel RL свой порядок: её подают в шов пистолетом или из пакета, а рельеф шва формируют через 30–60 минут, когда затирка станет похожа на мокрый песок.')}
        </p>
        <p class="src">
          По данным производителей:{' '}
          {uniq([...howToSrc, xc.renew.src, rlShape.src]).map((u, k) => (
            <Fragment>{k > 0 && ' · '}<a href={u} rel="nofollow noopener" target="_blank">{srcLabel(u)}</a></Fragment>
          ))}
        </p>
      </div>
    </div>
  </Section>

  <Section
    id="chistyj-shov"
    kicker="Чистый белый шов"
    title="Почему светлый шов пачкается и что с этим делать"
    subtitle="Что пишут производители: откуда берётся грязь на светлом шве и как сохранить его белым."
    bg="alt"
  >
    <div class="cl">
      <div class="cl__group" data-reveal>
        <h3 class="cl__h">Что портит цвет шва</h3>
        <ol class="cl__list">
          {why.map((w, i) => (
            <li>
              <span class="cl__n num" aria-hidden="true">{pad2(i)}</span>
              <div>
                <p class="cl__t">{nb(w.title)}</p>
                <p>{nb(w.text)}</p>
                <p class="src">
                  Источник:{' '}
                  {w.srcs.map((u, k) => (
                    <Fragment>{k > 0 && ' · '}<a href={u} rel="nofollow noopener" target="_blank">{srcLabel(u)}</a></Fragment>
                  ))}
                </p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <div class="cl__group" data-reveal>
        <h3 class="cl__h">Какую смесь выбрать</h3>
        <ol class="cl__list">
          {choose.map((c, i) => (
            <li>
              <span class="cl__n num" aria-hidden="true">{pad2(i)}</span>
              <p>
                {nb(c.text)}{' '}
                <a class="src-link" href={c.src} rel="nofollow noopener" target="_blank">{srcLabel(c.src)}</a>
              </p>
            </li>
          ))}
        </ol>
      </div>
      <div class="cl__group" data-reveal>
        <h3 class="cl__h">Как работать</h3>
        <ol class="cl__list">
          {work.map((c, i) => (
            <li>
              <span class="cl__n num" aria-hidden="true">{pad2(i)}</span>
              <p>
                {nb(c.text)}{' '}
                <a class="src-link" href={c.src} rel="nofollow noopener" target="_blank">{srcLabel(c.src)}</a>
              </p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </Section>

  <Section id="voprosy" kicker="Вопросы" title="Коротко о белой смеси" bg="base">
    <FaqAccordion items={faq} site="smesi" slug="belaya-kladochnaya-smes" />
  </Section>

  <CtaBand
    source="belaya"
    title={nb('Подберём белую смесь под ваш кирпич')}
    text={nb('Назовите свой кирпич и метраж стены — подберём серию, белый или супербелый тон и посчитаем мешки.')}
  />
</Page>

<style is:global>
  /* Только эта страница. H1 «…для облицовочного кирпича»: PageHead склеивает «для облицовочного»
     неразрывным пробелом, фраза ≈ 7,3 em — на 116 px она не влезала в колонку 7/12 на десктопе
     и в 288 px на телефоне 320 (страница была шире экрана: 353 px). Кегль — от ширины колонки текста. */
  html[data-site='smesi'] .mh__text { container-type: inline-size; }
  html[data-site='smesi'] .mh__title { max-width: none; font-size: min(var(--fs-h1), 12.6cqi); }
</style>

<style>
  /* ── шапка: действия, полоса белых оттенков, цифры ── */
  .bh__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4); margin-top: var(--space-7); }

  .bh__aside { min-width: 0; }
  .bh__strip { display: flex; height: clamp(120px, 13vw, 190px); }
  .bh__strip span { transition: flex-grow 0.5s var(--ease); }
  .bh__strip:hover span:hover { flex-grow: 2.2; }
  .bh__cap { margin: var(--space-3) 0 0; }
  .bh__stats { margin: var(--space-6) 0 0; border-top: 1px solid var(--hair-strong); }
  .bh__stats div { display: grid; grid-template-columns: minmax(64px, auto) minmax(0, 1fr); align-items: baseline; gap: var(--space-4); padding: 12px 0; border-bottom: 1px solid var(--hair); }
  .bh__stats dd { order: -1; margin: 0; font-family: var(--font-head); font-size: clamp(44px, 4.2vw, 64px); line-height: 1; letter-spacing: -0.02em; }
  .bh__stats dt { font-size: var(--fs-small); color: var(--color-text-soft); }

  /* ── ссылки на источники ── */
  .src { margin: 0; font-size: var(--fs-tiny); line-height: 1.5; color: var(--color-muted); }
  .src a,
  .src-link { color: var(--color-muted); text-decoration: underline; text-underline-offset: 2px; font-size: var(--fs-tiny); overflow-wrap: anywhere; }
  .src a:hover,
  .src-link:hover { color: var(--ink); }

  /* ── 1. композиция белых оттенков (тушь) ──
     Одна сетка на оба бренда: через subgrid плашки, названия и расшивка встают на одни линии.
     Телефон: Perel над Основит, по две колонки 4:3. Десктоп: 4:3 | 3:2 — асимметрия 7/5. */
  .wh { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 3fr); column-gap: 10px; row-gap: 0; }
  .wh__brand { grid-column: 1 / -1; grid-row: span 6; display: grid; grid-template-columns: subgrid; grid-template-rows: subgrid; min-width: 0; }
  .wh__bname {
    grid-column: 1 / -1;
    margin: 0 0 var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid rgb(247 244 238 / 0.28);
    font-size: var(--fs-tiny);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .wh__brand + .wh__brand .wh__bname { margin-top: var(--space-8); }
  .wh__cols { grid-column: 1 / -1; grid-row: 2 / span 5; display: grid; grid-template-columns: subgrid; grid-template-rows: subgrid; margin: 0; padding: 0; list-style: none; }
  .wh__col { grid-row: span 5; display: grid; grid-template-rows: subgrid; min-width: 0; }

  .wh__plate { display: block; width: 100%; padding: 0; border: 0; border-radius: 0; cursor: pointer; transition: translate 0.5s var(--ease); }
  .wh__plate--top { height: clamp(190px, 25vw, 360px); }
  .wh__plate--sub { align-self: end; height: clamp(64px, 7vw, 104px); margin-top: var(--space-6); }
  .wh__plate:hover, .wh__plate:focus-visible { translate: 0 -6px; }
  .wh__plate:focus-visible { outline: 2px solid var(--paper); outline-offset: 4px; }

  .wh__name { margin: var(--space-4) 0 0; font-family: var(--font-head); font-size: clamp(25px, 2.5vw, 36px); line-height: 1; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .wh__codes { display: flex; flex-wrap: wrap; gap: 2px 12px; margin: var(--space-2) 0 0; font-size: 13px; letter-spacing: 0.02em; color: rgb(247 244 238 / 0.66); }
  .wh__codes b, .wh__subcap b { font-weight: 500; color: var(--paper); }
  .wh__subcap { margin: var(--space-2) 0 0; font-size: 13px; color: rgb(247 244 238 / 0.66); }
  .wh__kind { display: block; margin-bottom: 2px; font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sand); }
  .wh__miss {
    align-self: end;
    margin: var(--space-6) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid rgb(247 244 238 / 0.2);
    max-width: 24ch;
    font-family: var(--font-head);
    font-style: italic;
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.2;
    color: rgb(247 244 238 / 0.72);
  }

  @media (min-width: 900px) {
    .wh { grid-template-columns: minmax(0, 4fr) minmax(0, 3fr) clamp(12px, 2.4vw, 40px) minmax(0, 3fr) minmax(0, 2fr); column-gap: 14px; }
    /* по две марки в ряд: Perel | Основит, Promix | Стройбриг */
    .wh__brand:nth-child(odd) { grid-column: 1 / span 2; }
    .wh__brand:nth-child(even) { grid-column: 4 / span 2; }
    .wh__brand:nth-child(-n + 2) { grid-row: 1 / span 6; }
    .wh__brand:nth-child(n + 3):nth-child(-n + 4) { grid-row: 7 / span 6; }
    /* вес выше, чем у «.wh__brand + .wh__brand .wh__bname» (QA 23.10: подпись второй марки уезжала на 64 px) */
    .wh__brand + .wh__brand:nth-child(-n + 2) .wh__bname { margin-top: 0; }
  }

  .wh__foot { display: grid; gap: var(--space-6); margin-top: clamp(48px, 6vw, 88px); padding-top: var(--space-5); border-top: 1px solid rgb(247 244 238 / 0.28); }
  .wh__podbor p { max-width: 30ch; margin: 0 0 var(--space-5); font-family: var(--font-head); font-size: clamp(24px, 2.3vw, 32px); line-height: 1.12; letter-spacing: -0.01em; }
  .wh__podbor .arrow-link { color: var(--paper); border-bottom-color: rgb(247 244 238 / 0.45); font-size: 17px; }
  .wh__podbor .arrow-link:hover { border-bottom-color: var(--paper); }
  .wh__foot :global(.note) { margin: 0; padding-top: 0; border-top: 0; color: rgb(247 244 238 / 0.7); }
  .wh__foot :global(.note .label) { color: var(--sand); }
  @media (min-width: 1000px) {
    .wh__foot { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 5vw, 80px); align-items: start; }
  }

  /* ── 2. под кирпич: строки через линии, слева тип кирпича, справа серии ── */
  .rule { max-width: 68ch; margin: 0 0 clamp(36px, 4vw, 56px); font-size: var(--fs-lead); color: var(--color-text-soft); }
  .rule .src-link { margin-left: var(--space-1); }

  .bw-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .bw { display: grid; gap: var(--space-6); padding: clamp(32px, 4vw, 56px) 0; border-bottom: 1px solid var(--hair); scroll-margin-top: var(--space-9); }
  .bw__head { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-2); min-width: 0; }
  .bw__num { margin: 0; }
  .bw__title { margin: 0; font-size: var(--fs-h3); line-height: 1.05; letter-spacing: -0.01em; }
  .bw__abs { display: flex; flex-direction: column; gap: 4px; margin: var(--space-4) 0 0; }
  .bw__range { font-family: var(--font-head); font-size: clamp(54px, 6vw, 92px); line-height: 0.9; letter-spacing: -0.03em; white-space: nowrap; }
  .bw__links { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-3); margin-top: var(--space-5); }

  .bw__series { display: grid; gap: var(--space-7); min-width: 0; }
  .bw__ser { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .bw__shead { padding-bottom: var(--space-3); border-bottom: 1px solid var(--hair); }
  .bw__sname { margin: 0; font-family: var(--font-head); font-weight: 500; font-size: clamp(24px, 2vw, 30px); line-height: 1.05; letter-spacing: -0.01em; }
  .bw__pack { margin: 6px 0 0; }
  .bw-list + :global(.note) { border-top: 0; padding-top: 0; }
  .bw__ser :global(.chips) { grid-template-columns: repeat(2, minmax(0, 150px)); gap: 14px; }
  .bw__quote { margin: 0; }
  .bw__quote blockquote { margin: 0; }
  .bw__quote blockquote p { margin: 0 0 var(--space-2); font-family: var(--font-head); font-style: italic; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.3; color: var(--color-text-soft); }
  .bw__specp { margin: auto 0 0; padding-top: var(--space-2); }
  .bw__specp .bw__spec { display: inline; padding-bottom: 2px; line-height: 1.6; }

  @media (min-width: 760px) {
    .bw__series { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-7) 0; }
    .bw__ser { padding-right: clamp(20px, 2.5vw, 40px); }
    .bw__ser:nth-child(even) { padding-right: 0; padding-left: clamp(20px, 2.5vw, 40px); border-left: 1px solid var(--hair); }
  }
