---
// Главная (редизайн 11.10; Влад: «шаблон не нужно использовать тот же, ещё и везде кирпич»).
// Входная страница под общий запрос «цветная кладочная смесь (для облицовочного кирпича)».
// Главный материал — цвет раствора: объёмная волна образцов на первом экране (бриф 20.10, вместо стены оттенков),
// полосы тонов, палитры серий. Факты — только из src/data (ассортимент дилера, данные производителей).
// Под первым экраном — оттенок волны швом на кадре кладки и карусель сочетаний: кирпич вне /podbor-shva/
// по брифу 20.10, решение Влада — ожидается.
//
// «Швы — до 15–20 % площади фасада» — утверждение самого дилера (вопросы и ответы на его сайтах
// кирпича Старого Оскола и Железногорска: «Швы составляют до 15-20% площади фасада»).
import Page from '../layouts/Page.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import MortarWave from '../components/smesi/MortarWave.astro';
import SeamStudio from '../components/smesi/SeamStudio.astro';
import SeamCarousel from '../components/smesi/SeamCarousel.astro';
import BrickTypes from '../components/smesi/BrickTypes.astro';
import SeriesCard from '../components/smesi/SeriesCard.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import { POSITIONS, SERIES, TONES, PEREL_COLORS, OSNOVIT_COLORS, PEREL_RL_COLORS, seriesById, type Tone } from '../data/catalog';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { OFFICES } from '../lib/sites';

// «супер-белый» (Perel) и «супербелый» (Основит) — один оттенок: считаем и пишем одним словом.
const sameName = (n: string) => n.replace('супер-', 'супер');
const uniqueColors = new Set([...PEREL_COLORS, ...PEREL_RL_COLORS, ...OSNOVIT_COLORS].map((c) => sameName(c.name))).size;

// Тона: все оттенки группы полосой; плашка — с кладочной палитры (у расшивочных RL и ХС30
// оттенки сняты с фотографий образцов и темнее).
const toneOrder: Tone[] = ['white', 'grey', 'black', 'beige', 'yellow', 'brown', 'red', 'accent'];
const tones = toneOrder
  .map((t) => {
    const ps = POSITIONS.filter((p) => p.color.tone === t);
    const byName = new Map<string, string>();
    for (const p of [...ps].sort((a, b) => Number(seriesById(a.series).purpose === 'rasshivka') - Number(seriesById(b.series).purpose === 'rasshivka'))) {
      const n = sameName(p.color.name);
      if (!byName.has(n)) byName.set(n, swatchFor(p.series, p.color.code));
    }
    return { t, label: TONES[t], count: ps.length, names: [...byName.keys()], colors: [...byName.values()] };
  })
  .filter((x) => x.count > 0);

const kladka = SERIES.filter((s) => s.purpose === 'kladka');
const rasshivka = SERIES.filter((s) => s.purpose === 'rasshivka');

const index = [
  { href: PAGES.belaya.href, title: 'Белая кладочная смесь', note: 'белый и супербелый шов' },
  { href: PAGES.chernaya.href, title: 'Чёрная и графитовая', note: 'тёмный шов у Perel и Основит' },
  { href: PAGES.klinker.href, title: 'Для клинкерного кирпича', note: 'низкое водопоглощение — своя смесь' },
  { href: PAGES.kalkulyator.href, title: 'Сколько нужно мешков', note: 'калькулятор по нормам производителей' },
  { href: PAGES.podbor.href, title: 'Шов на вашем кирпиче', note: 'как оттенок смотрится в кладке' },
];
---

<Page
  title="Цветные кладочные смеси для облицовочного кирпича в Москве"
  description={`Perel и Основит: ${POSITIONS.length} позиций для клинкера, обычного кирпича и ручной формовки, растворы для расшивки. Подбор цвета шва и расчёт мешков.`}
  current="home"
  source="home"
>
  <section class="hero">
    <Container>
      <div class="hero__grid">
        <div class="hero__head">
          <p class="label" data-reveal>Москва и Московская область</p>
          <h1 class="hero__title" data-reveal="head">Цвет шва меняет всё</h1>
        </div>
        <div class="hero__body">
          <p class="hero__lead" data-reveal>
            Цветные кладочные смеси Perel и Основит — для клинкера, обычного кирпича и кирпича ручной формовки,
            плюс растворы для расшивки швов. Поможем выбрать оттенок и посчитаем мешки.
          </p>
          <div class="hero__actions" data-reveal>
            <a class="btn btn--primary btn--lg" href={PAGES.katalog.href}>Подобрать оттенок</a>
            <a class="arrow-link" href="#shov-na-kladke">Посмотреть на кладке <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        {/* волна после текста в DOM: порядок Tab и чтения совпадает с видимым и на телефоне, и на компьютере */}
        <div class="hero__wave"><MortarWave /></div>
        <dl class="hero__facts num" data-reveal>
          <div><dt>позиций</dt><dd>{POSITIONS.length}</dd></div>
          <div><dt>оттенков шва</dt><dd>{uniqueColors}</dd></div>
          <div><dt>офиса в Москве</dt><dd>{OFFICES.length}</dd></div>
        </dl>
      </div>
    </Container>
  </section>

  <SeamStudio />
  <SeamCarousel />

  <section class="claim">
    <Container>
      <div class="claim__grid">
        <p class="claim__big num" data-reveal="head"><span class="claim__pre">до</span>15–20&nbsp;%</p>
        <div class="claim__text" data-reveal>
          <p>Столько площади фасада занимают швы. Цвет раствора меняет дом почти так же сильно, как цвет самого кирпича — в тон он успокаивает стену, в контраст делает рисунок кладки графичным.</p>
          <a class="arrow-link" href={PAGES.podbor.href}>Сравнить швы на кирпиче <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </Container>
  </section>

  <Section
    id="vybor"
    kicker="01 — Сначала кирпич"
    title="Смесь подбирают по водопоглощению кирпича"
    subtitle="Так делят цветные смеси и Perel, и Основит: клинкеру, обычному облицовочному кирпичу и кирпичу ручной формовки нужен разный раствор. Водопоглощение указано в паспорте кирпича."
    bg="base"
  >
    <BrickTypes />
  </Section>

  <Section id="serii" kicker="02 — Серии" title={'Пять кладочных серий и две — для расшивки'} bg="alt">
    <ul class="cards" data-reveal-stagger>
      {kladka.map((s) => <li><SeriesCard id={s.id} /></li>)}
    </ul>
    <p class="label sub">Для расшивки и заполнения швов готовой кладки</p>
    <ul class="cards cards--2" data-reveal-stagger>
      {rasshivka.map((s) => <li><SeriesCard id={s.id} /></li>)}
    </ul>
  </Section>

  <Section id="ottenki" kicker="03 — Оттенки" title="Выберите тон шва" subtitle="Все оттенки обеих марок по тонам. Нажмите на тон — каталог покажет только его." bg="base">
    <ul class="tones">
      {tones.map((x) => (
        <li>
          <a class="tone" href={`${PAGES.katalog.href}?ton=${x.t}`}>
            <span class="tone__label">{x.label}</span>
            <span class="tone__strip strip" aria-hidden="true">{x.colors.map((c) => <span class="mortar" style={`--c:${c}`}></span>)}</span>
            <span class="tone__meta"><span class="num">{x.count} поз.</span><span class="tone__names">{x.names.slice(0, 5).join(', ')}{x.names.length > 5 ? '…' : ''}</span></span>
          </a>
        </li>
      ))}
    </ul>
    <p class="tones__note">Цвет на экране приблизительный: плашки сняты с палитр производителей.</p>
  </Section>

  <Section id="chasto" kicker="04 — Часто ищут" title="С чего обычно начинают" bg="alt">
    <ol class="idx">
      {index.map((x, i) => (
        <li>
          <a href={x.href}>
            <span class="idx__n num">0{i + 1}</span>
            <span class="idx__t">{x.title}</span>
            <span class="idx__note">{x.note}</span>
            <span class="idx__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </Section>

  <CtaBand source="home" />
</Page>

<style>
  .hero { padding: clamp(28px, 4vw, 56px) 0 clamp(56px, 7vw, 112px); overflow-x: clip; }
  /* Узкий экран (до 999 px): заголовок → сцена → пояснение и кнопка каталога → панель волны → факты.
     Обёртки волны «растворяются» (display: contents), сцена и панель встают в свои области сетки;
     корень [data-mw] остаётся в DOM — его скрипт работает как обычно. */
  .hero__grid { display: grid; grid-template-areas: 'head' 'wave' 'body' 'panel' 'facts'; gap: clamp(20px, 4vw, 36px); }
  .hero__head { grid-area: head; }
  .hero__wave { grid-area: wave; min-width: 0; }
  .hero__body { grid-area: body; }
  /* ссылка под кнопкой — зона нажатия 44 px без сдвига линии: поле сверху компенсировано отступом (QA 20.10) */
  .hero__actions .arrow-link { padding-top: 16px; margin-top: -16px; padding-bottom: 6px; margin-bottom: -3px; }
  .hero__facts { grid-area: facts; }
  @media (max-width: 999px) {
    .hero__wave, .hero__wave :global(.mw) { display: contents; }
    .hero__wave :global(.mw__stage) { grid-area: wave; }
    .hero__wave :global(.mw__panel) { grid-area: panel; }
  }
  .hero__title {
    margin: var(--space-4) 0 0;
    font-size: clamp(50px, 7.2vw, 112px);
    line-height: 0.92;
    letter-spacing: -0.03em;
    max-width: 9ch;
  }
  .hero__lead { max-width: 44ch; margin: 0; font-size: var(--fs-lead); color: var(--color-text-soft); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-4) var(--space-6); margin-top: clamp(20px, 3vw, 48px); }
  .hero__facts { display: flex; flex-wrap: wrap; gap: 16px clamp(24px, 4vw, 56px); margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--hair); }
  .hero__facts div { display: flex; flex-direction: column-reverse; justify-content: flex-end; }
  .hero__facts dd { margin: 0; font-family: var(--font-head); font-size: clamp(40px, 4vw, 60px); line-height: 1; }
  .hero__facts dt { font-size: var(--fs-tiny); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }
  @media (min-width: 1000px) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-areas: 'head wave' 'body wave' 'facts wave';
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(32px, 4vw, 64px);
      row-gap: var(--space-6);
      align-items: start;
    }
    .hero__head { align-self: end; }
    .hero__facts { align-self: start; margin-top: clamp(8px, 2vw, 28px); }
  }

  .claim { padding: clamp(56px, 8vw, 128px) 0; background: var(--ink); color: var(--paper); }
  .claim__grid { display: grid; gap: var(--space-6); align-items: end; }
  .claim__big { margin: 0; font-family: var(--font-head); font-size: clamp(76px, 12.5vw, 196px); line-height: 0.85; letter-spacing: -0.04em; color: var(--sand); white-space: nowrap; }
  .claim__pre { display: block; margin-bottom: 0.1em; font-size: 0.22em; font-style: italic; letter-spacing: 0; color: rgb(247 244 238 / 0.7); }
  .claim__text p { max-width: 42ch; margin: 0 0 var(--space-6); font-size: var(--fs-lead); color: rgb(247 244 238 / 0.82); }
  .claim .arrow-link { color: var(--paper); border-bottom-color: rgb(247 244 238 / 0.4); }
  @media (min-width: 1000px) { .claim__grid { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); } }

  .cards { display: grid; gap: clamp(40px, 4vw, 56px) clamp(24px, 3vw, 44px); margin: 0; padding: 0; list-style: none; }
  .sub { margin: clamp(56px, 6vw, 88px) 0 var(--space-5); padding-top: var(--space-4); border-top: 1px solid var(--hair); }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1080px) {
    .cards { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .cards > li { grid-column: span 2; }
    .cards > li:nth-child(4):nth-last-child(2), .cards > li:nth-child(5):last-child { grid-column: span 3; }
    .cards--2 > li { grid-column: span 3; }
  }

  .tones { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .tone { display: grid; gap: 10px 32px; align-items: center; padding: 20px 0; border-bottom: 1px solid var(--hair); color: var(--ink); text-decoration: none; }
  .tone__label { font-family: var(--font-head); font-size: clamp(28px, 2.6vw, 40px); line-height: 1; transition: font-style 0s; }
  .tone:hover .tone__label { font-style: italic; }
  .tone__strip { height: 54px; }
  .tone__meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: var(--fs-small); color: var(--color-muted); }
  .tone__names { color: var(--color-text-soft); }
  @media (min-width: 900px) {
    .tone { grid-template-columns: minmax(0, 3fr) minmax(0, 6fr) minmax(0, 3fr); }
    .tone__meta { flex-direction: column; }
  }
  .tones__note { margin: var(--space-5) 0 0; font-size: var(--fs-small); color: var(--color-muted); }

  .idx { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .idx a { display: grid; grid-template-columns: auto 1fr auto; gap: 4px 20px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--hair); color: var(--ink); text-decoration: none; }
  .idx__n { font-size: 12px; color: var(--color-muted); }
  .idx__t { font-family: var(--font-head); font-size: clamp(30px, 3.4vw, 52px); line-height: 1; letter-spacing: -0.015em; }
  .idx__note { grid-column: 2; color: var(--color-muted); font-size: var(--fs-small); }
  .idx__arrow { grid-row: 1; grid-column: 3; font-size: 28px; transition: translate 0.4s var(--ease); }
  .idx a:hover .idx__t { font-style: italic; }
  .idx a:hover .idx__arrow { translate: 8px 0; }
  @media (min-width: 900px) {
    .idx a { grid-template-columns: 60px minmax(0, 7fr) minmax(0, 4fr) auto; }
    .idx__note { grid-column: 3; }
    .idx__arrow { grid-column: 4; }
  }
</style>
