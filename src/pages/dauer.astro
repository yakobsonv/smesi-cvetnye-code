            <a class="arrow-link os-tool__link" href={t.href} rel="nofollow noopener" target="_blank">{t.cta} <span aria-hidden="true">↗</span></a>
            {t.href2 && <a class="arrow-link os-tool__link" href={t.href2} rel="nofollow noopener" target="_blank">{t.cta2} <span aria-hidden="true">↗</span></a>}
