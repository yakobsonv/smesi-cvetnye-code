  <Section id="rashod" kicker="Расход" title="Примерный расчёт по формату кирпича" bg="base">
    <div class="os-calc">
      <div class="os-calc__norm" data-reveal>
        <table class="os-rate-table">
          <caption class="os-vh">Расход BRICK.COLOR по формату кирпича</caption>
          <thead>
            <tr><th scope="col">Формат кирпича</th><th scope="col">Размер, мм</th><th scope="col">На 1&nbsp;м²</th><th scope="col">На 1&nbsp;кирпич</th></tr>
          </thead>
          <tbody>
            {rate.perFormat.map((r) => (
              <tr><th scope="row">{r.format}</th><td class="num">{r.size}</td><td class="num">≈{r.kgPerM2}&nbsp;кг</td><td class="num">≈{num(r.kgPerBrick)}&nbsp;кг</td></tr>
            ))}
          </tbody>
        </table>
        <p class="os-calc__cap">{nb(rate.basis)}</p>
        <p class="os-src">
          По данным производителя: <a href={rate.src} rel="nofollow noopener" target="_blank">{srcName(rate.src)}</a>
        </p>
      </div>
      <div class="os-calc__example" data-reveal>
        <p class="label">Пример по этой таблице</p>
        <dl class="os-calc__sum num">
          <div><dt>Площадь кладки</dt><dd>{exampleM2}&nbsp;м²</dd></div>
          <div><dt>Формат {ex.format}</dt><dd>× ≈{ex.kgPerM2}&nbsp;кг/м²</dd></div>
          <div><dt>Сухой смеси</dt><dd>≈{exampleKg}&nbsp;кг</dd></div>
