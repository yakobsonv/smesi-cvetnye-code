---
// Страница бренда Dauer (добавлена 24.10.2026 по просьбе Паши «нужен Dauer производитель»): цветные кладочные
// смеси BRICK.COLOR 250 / 251 / 252 — три смеси под водопоглощение кирпича, одна палитра из 25 цветов.
// Вид — как у /osnovit/ (редизайн 11.10, язык «палитра шва»): полосы оттенков вместо кадра кладки, строки
// через тонкие линии, цитаты производителя курсивом антиквы, сравнение смесей — таблица через линии.
//
// ФАКТЫ — только из данных (src/data):
//   назначение и «для какого кирпича» — ДОСЛОВНО из SERIES_FACTS (purpose / forBrick);
//   характеристики, шаги, оговорки о цвете, зимняя версия — SERIES_FACTS, у каждой строки свой адрес;
//   расход — CONSUMPTION.dauer (таблица «Примерный расчёт количества материала» из технической карты);
//   о производителе и его материалах — BRAND_FACTS.dauer;
//   ассортимент (25 цветов, фасовка) — catalog.ts; оттенки плашек — swatches.ts (замер по фото палитры производителя).
// ⚠️ Кодов цвета у Dauer нет — под плашкой «№ N на палитре» (catalog.ts → codeText); артикулы чужих дилеров не берём.
// ⚠️ В магазине дилера tk-sm.ru позиций Dauer нет: какие серии, цвета и мешки есть в наличии — «уточняйте у менеджера»
//   (вопрос Владу). Зимняя версия — факт производителя, наличие не знаем.
// ⚠️ dauer.ru на 24.10.2026 недоступен (таймаут): данные — со снимков 09.10.2026 (Обсидиан Влада).
// Цен нет: действие позиции — «Узнать цену» (атрибут data-ask, окно есть на странице через Page).
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import SpecTable from '../components/content/SpecTable.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import Collapse from '../components/ui/Collapse.astro';
import { seriesById, DAUER_COLORS, POSITIONS, type SeriesId, type Tone } from '../data/catalog';
import { SERIES_FACTS, CONSUMPTION, BRAND_FACTS, type SeriesFacts } from '../data/series-facts';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { liveUrl } from '../lib/sites';
import { nb as typoNb } from '../lib/typo';
// Пробел перед «—» — неразрывный: тире не начинает строку (сквозная проверка дизайна 11.10).
const nb = (t: string) => typoNb(t).replace(/ — /g, ' — ');
import type { FaqItem, SpecRow } from '../lib/types';

const SERIES_HERE: SeriesId[] = ['dauer-250', 'dauer-251', 'dauer-252'];
const s250 = seriesById('dauer-250');
const s251 = seriesById('dauer-251');
const s252 = seriesById('dauer-252');
const F250 = SERIES_FACTS['dauer-250'];
const F251 = SERIES_FACTS['dauer-251'];
const F252 = SERIES_FACTS['dauer-252'];
const all = [
  { s: s250, f: F250 },
  { s: s251, f: F251 },
  { s: s252, f: F252 },
];
/** «BRICK.COLOR 250» — без имени марки, для подписей */
const shortName = (id: SeriesId) => seriesById(id).name.replace(/^Dauer /, '');

const colorsCount = DAUER_COLORS.length;
const positionsCount = POSITIONS.filter((p) => SERIES_HERE.includes(p.series)).length;

/* ── помощники ─────────────────────────────────────────────────────────────── */

const spec = (f: SeriesFacts, label: string) => {
  const x = f.specs.find((s) => s.label === label);
  if (!x) throw new Error(`dauer.astro: нет показателя «${label}»`);
  return x;
};
const pack = (f: SeriesFacts) => {
  const x = f.packaging.find((s) => s.label === 'Мешок');
  if (!x) throw new Error('dauer.astro: нет строки «Мешок»');
  return x;
};
const rowsOf = (f: SeriesFacts): SpecRow[] => [...f.specs, ...f.packaging].map((x) => ({ label: x.label, value: x.value }));
const plural = (n: number, forms: [string, string, string]) => {
  const a = Math.abs(n) % 100;
  const b = a % 10;
  if (a > 10 && a < 20) return forms[2];
  if (b === 1) return forms[0];
  if (b >= 2 && b <= 4) return forms[1];
  return forms[2];
};
const colorsWord = (n: number) => plural(n, ['цвет', 'цвета', 'цветов']);
const num = (n: number) => String(n).replace('.', ',');

/** Подпись источника по адресу (адреса — из данных, здесь только название ссылки). */
const SRC_NAMES: [RegExp, string][] = [
  [/TK_BRICKCOLOR_250\.pdf$/, 'техническая карта BRICK.COLOR 250'],
  [/TK_BRICKCOLOR_251\.pdf$/, 'техническая карта BRICK.COLOR 251'],
  [/TK_BRICKCOLOR_252\.pdf$/, 'техническая карта BRICK.COLOR 252'],
  [/dauer-brick-color-250\/$/, 'карточка BRICK.COLOR 250 на dauer.ru'],
  [/dauer-brick-color-251\/$/, 'карточка BRICK.COLOR 251 на dauer.ru'],
  [/dauer-brick-color-252\/$/, 'карточка BRICK.COLOR 252 на dauer.ru'],
  [/\/documents\/declarations\//, 'декларации соответствия на dauer.ru'],
  [/\/company\/news\//, 'новость производителя'],
  [/\/media\/articles\//, 'статья производителя'],
  [/\/where\//, 'карта дилеров dauer.ru'],
  [/BRICK_COLOR\.png$/, 'фото палитры на dauer.ru'],
];
const srcName = (url: string) => SRC_NAMES.find(([re]) => re.test(url))?.[1] ?? 'dauer.ru';
const sources = (urls: string[]) => [...new Set(urls)].map((url) => ({ url, name: srcName(url) }));
const factSources = (f: SeriesFacts) => sources([f.purposeSrc, f.forBrickSrc, ...f.specs.map((x) => x.src), ...f.packaging.map((x) => x.src)]);

const about = (needle: string) => {
  const x = BRAND_FACTS.dauer.about.find((f) => f.text.includes(needle));
  if (!x) throw new Error(`dauer.astro: нет факта о производителе «${needle}»`);
  return x;
};
const tool = (needle: string) => {
  const x = BRAND_FACTS.dauer.tools.find((f) => f.text.includes(needle));
  if (!x) throw new Error(`dauer.astro: нет материала производителя «${needle}»`);
  return x;
};

/* ── первый экран: полоса оттенков ────────────────────────────────────────── */

// Порядок плашек — по тонам (белые → бежевые → жёлтые → коричневые → красные → цветные → серые → чёрные),
// внутри тона от светлого к тёмному. Палитра одна на три смеси — полоса одна.
const TONE_FLOW: Tone[] = ['white', 'beige', 'yellow', 'brown', 'red', 'accent', 'grey', 'black'];
const luma = (hex: string) => {
  const n = parseInt(hex.replace('#', ''), 16);
  return 0.2126 * ((n >> 16) & 255) + 0.7152 * ((n >> 8) & 255) + 0.0722 * (n & 255);
};
const strip = [...s250.colors]
  .sort(
    (a, b) =>
      TONE_FLOW.indexOf(a.tone) - TONE_FLOW.indexOf(b.tone) ||
      luma(swatchFor(s250.id, b.code)) - luma(swatchFor(s250.id, a.code)),
  )
  .map((c) => ({ title: `${c.name}, № ${Number(c.code)} на палитре`, hex: swatchFor(s250.id, c.code) }));

const jump = [
  { href: '#vybor', label: '250, 251 или 252' },
  { href: `#${s250.id}`, label: 'BRICK.COLOR 250' },
  { href: `#${s251.id}`, label: 'BRICK.COLOR 251' },
  { href: `#${s252.id}`, label: 'BRICK.COLOR 252' },
  { href: '#zima', label: 'Зимняя версия' },
  { href: '#rashod', label: 'Расход' },
];

/* ── 1. о производителе ───────────────────────────────────────────────────── */

const maker = [
  { title: 'Производство', fact: about('Качественные смеси') },
  { title: 'Линейка', fact: about('представил в июле 2025') },
  { title: 'Три смеси', fact: about('Три смеси') },
  { title: 'Дилеры', fact: about('Кирпичный трест') },
];
// Адрес площадки и ГОСТ не должны рваться по дефису на две строки.
const KEEP = ['проезд Коммунальный, д. 16', 'г. Жуковский', 'BRICK.COLOR', 'Научный проезд, 10'];
const keepTogether = (text: string) =>
  KEEP.reduce((acc, k) => acc.split(k).join(`<span class="os-nowrap">${k}</span>`), nb(text)).replace(/<\/span> /g, '</span> ');

/* ── 2. какая смесь: решает кирпич ───────────────────────────────────────── */

type Cmp = { label: string; v: string[]; wide?: boolean };
const cmpLabels = ['Водопоглощение кирпича', 'Прочность на сжатие', 'Морозостойкость', 'Водоудерживающая способность', 'Жизнеспособность раствора', 'Толщина шва'];
const cmp: Cmp[] = [
  { label: 'Для какого кирпича', v: all.map((x) => x.f.forBrick), wide: true },
  ...cmpLabels.map((l) => ({ label: l, v: all.map((x) => spec(x.f, l).value) })),
  { label: 'Мешок', v: all.map((x) => pack(x.f).value) },
  { label: 'Цветов в палитре', v: all.map((x) => String(x.s.colors.length)) },
];
const same = (v: string[]) => v.every((x) => x === v[0]);
const cmpSources = sources([
  ...all.map((x) => x.f.forBrickSrc),
  ...cmpLabels.flatMap((l) => all.map((x) => spec(x.f, l).src)),
  ...all.map((x) => pack(x.f).src),
]);

const hints = [
  { title: 'Клинкер — 252.', text: `Производитель относит BRICK.COLOR 252 к клинкерному кирпичу с водопоглощением ${spec(F252, 'Водопоглощение кирпича').value}; у неё выше прочность и морозостойкость.` },
  { title: 'Обычный облицовочный кирпич — 250.', text: `BRICK.COLOR 250 рассчитана на кирпич с водопоглощением ${spec(F250, 'Водопоглощение кирпича').value}: керамический облицовочный, рядовой и плотный силикатный.` },
  { title: 'Ручная формовка и «все виды» — 251.', text: `BRICK.COLOR 251 производитель называет смесью для всех видов кирпича с водопоглощением ${spec(F251, 'Водопоглощение кирпича').value}, в том числе ручной формовки; с 250 диапазоны перекрываются.` },
];

/* ── 3–5. серии ───────────────────────────────────────────────────────────── */

const joint = (f: SeriesFacts) => spec(f, 'Толщина шва').value.replace(' (рекомендуемая)', '');
type Fact = [dt: string, dd: string];
const seriesBlocks = [
  { s: s250, f: F250, bg: 'base' as const, kicker: 'BRICK.COLOR 250', title: 'BRICK.COLOR 250 — для кирпича с водопоглощением 6–12 %' },
  { s: s251, f: F251, bg: 'alt' as const, kicker: 'BRICK.COLOR 251', title: 'BRICK.COLOR 251 — для всех видов кирпича, 5–18 %' },
  { s: s252, f: F252, bg: 'base' as const, kicker: 'BRICK.COLOR 252', title: 'BRICK.COLOR 252 — для клинкерного кирпича, 1–5 %' },
].map((b) => ({
  ...b,
  facts: [
    ['Мешок', pack(b.f).value],
    ['Цветов в палитре', String(b.s.colors.length)],
    ['Толщина шва', joint(b.f)],
    ['Морозостойкость', spec(b.f, 'Морозостойкость').value],
  ] as Fact[],
}));

/* ── 6. зимняя версия ─────────────────────────────────────────────────────── */

// Пересказ dauerWinter() из series-facts.ts по пунктам — числа производителя без добавлений.
const winterRules = [
  'Работы — при температуре воздуха не ниже −10 °C.',
  'Жизнеспособность раствора — 1 час.',
  'Смесь затворяют подогретой водой +25…+27 °C.',
  'Снег и наледь с кирпича удаляют; учитывают замедленный набор прочности.',
  'Срок годности зимней версии — 6 месяцев.',
];
const winterSources = sources(all.map((x) => x.f.winter?.src ?? '').filter(Boolean));

/* ── 7. как работать ──────────────────────────────────────────────────────── */

// Шаги у трёх смесей совпадают (у 252 — из технической карты); показываем по 250.
const steps = F250.steps;
const colorNotes = F250.notes ?? [];
const stepsSources = sources([...steps.map((s) => s.src), ...colorNotes.map((n) => n.src)]);

/* ── 8. расход ─────────────────────────────────────────────────────────────── */

const rate = CONSUMPTION.dauer;
const ex = rate.perFormat.find((r) => r.format === '1 НФ') ?? rate.perFormat[0];
const exampleM2 = 10;
const exampleKg = ex.kgPerM2 * exampleM2;
const exampleBags = Math.ceil(exampleKg / s250.packKg);
const kgMin = Math.min(...rate.perFormat.map((r) => r.kgPerM2));
const kgMax = Math.max(...rate.perFormat.map((r) => r.kgPerM2));

/* ── 9. материалы производителя ───────────────────────────────────────────── */

const tools = [
  { title: 'Техническая карта BRICK.COLOR 250', text: 'Характеристики с оговорками, примерный расчёт количества материала по форматам кирпича, зимняя версия.', href: tool('BRICK.COLOR 250 (PDF)').src, cta: 'Открыть PDF' },
  { title: 'Технические карты 251 и 252', text: 'Те же разделы для смеси под все виды кирпича и для смеси под клинкер.', href: tool('BRICK.COLOR 251 (PDF)').src, cta: 'Открыть PDF 251', href2: tool('BRICK.COLOR 252 (PDF)').src, cta2: 'PDF 252' },
  { title: 'Палитра BRICK.COLOR', text: 'Фото 25 полос затвердевшего раствора с названиями цветов — с него сняты плашки на этой странице.', href: tool('Фото палитры').src, cta: 'Открыть на dauer.ru' },
  { title: 'Карта дилеров «Где купить»', text: 'Продавцы смесей Dauer по регионам; «Кирпичный трест» в Москве — в их числе.', href: tool('Карта дилеров').src, cta: 'Открыть на dauer.ru' },
  { title: 'Статья производителя о цветных смесях', text: 'Как Dauer делает цветные кладочные смеси надёжными и удобными (14.04.2026).', href: tool('Статья производителя').src, cta: 'Читать на dauer.ru' },
];

/* ── 10. вопросы ──────────────────────────────────────────────────────────── */

const faq: FaqItem[] = [
  {
    q: 'Чем отличаются BRICK.COLOR 250, 251 и 252?',
    a: `<p>Кирпичом, под который рассчитана смесь. 250: «${F250.forBrick}». 251: «${F251.forBrick}». 252: «${F252.forBrick}».</p><p>Прочность на сжатие у 250 и 251 — ${spec(F250, 'Прочность на сжатие').value}, у 252 — ${spec(F252, 'Прочность на сжатие').value}; морозостойкость — ${spec(F250, 'Морозостойкость').value} у 250 и 251 и ${spec(F252, 'Морозостойкость').value} у 252. Палитра у трёх смесей одна — ${colorsCount} ${colorsWord(colorsCount)}.</p>`,
  },
  {
    q: 'Какая смесь Dauer подходит для клинкерного кирпича?',
    a: `<p>BRICK.COLOR 252 — производитель называет её смесью для клинкерного кирпича с водопоглощением ${spec(F252, 'Водопоглощение кирпича').value}. Смеси 250 и 251 рассчитаны на кирпич с водопоглощением от 5–6 % и выше.</p>`,
  },
  {
    q: 'Сколько цветов у Dauer и есть ли у них коды?',
    a: `<p>${colorsCount} ${colorsWord(colorsCount)} — от ультра-белого до шоколадного, с жёлтым, зелёным и синим. Кодов цвета производитель не публикует: на сайте мы показываем номер полосы на его палитре, а при заказе называем цвет словами.</p>`,
  },
  {
    q: 'Сколько смеси нужно на кладку?',
    a: `<p>По таблице примерного расчёта в технической карте — от ${kgMin} до ${kgMax} кг на 1 м² в зависимости от формата кирпича; для формата ${ex.format} (${ex.size} мм) — около ${ex.kgPerM2} кг на 1 м² и около ${num(ex.kgPerBrick)} кг на 1 кирпич. Толщину шва и вид кладки, для которых посчитано, производитель не указывает — расчёт примерный.</p>`,
  },
  {
    q: 'Можно ли класть Dauer зимой?',
    a: `<p>У производителя есть зимняя версия: работы при температуре воздуха не ниже −10 °C, жизнеспособность раствора 1 час, вода для затворения +25…+27 °C, срок годности 6 месяцев. Наличие зимней версии уточняйте у менеджера.</p>`,
  },
  {
    q: 'Почему шов может выглядеть не так, как образец?',
    a: `<p>По словам производителя, оттенок затвердевшего шва зависит от погодных условий, способа применения на объекте и способа формирования шва, поэтому перед выбором цвета он рекомендует сделать пробную кладку. Плашки на сайте сняты с фото палитры — цвет на экране приблизительный.</p>`,
  },
];

/* ── микроразметка ─────────────────────────────────────────────────────────── */

const pageUrl = liveUrl('smesi', 'dauer');
const itemList = {
  '@type': 'ItemList',
  name: 'Цветные кладочные смеси Dauer BRICK.COLOR 250, 251, 252',
  numberOfItems: SERIES_HERE.length,
  itemListElement: SERIES_HERE.map((id, i) => ({ '@type': 'ListItem', position: i + 1, name: seriesById(id).name, url: `${pageUrl}#${id}` })),
};
---

<Page
  title="Dauer BRICK.COLOR 250, 251 и 252 — цветные кладочные смеси, Москва"
  description={`Цветные кладочные смеси Dauer BRICK.COLOR под водопоглощение кирпича: 250 — 6–12 %, 251 — 5–18 %, 252 — клинкер 1–5 %. ${colorsCount} ${colorsWord(colorsCount)}, характеристики, расход по форматам кирпича.`}
  slug="dauer"
  current="dauer"
  source="dauer"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Производитель Dauer"
    h1="Цветные кладочные смеси Dauer BRICK.COLOR"
    crumb="Dauer"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={`Смесь Dauer подбирают по кирпичу: BRICK.COLOR 250 — для кирпича с водопоглощением 6–12 %, 251 — для всех видов кирпича 5–18 %, в том числе ручной формовки, 252 — для клинкера 1–5 %. Палитра одна на три смеси — ${colorsCount} ${colorsWord(colorsCount)}, ${positionsCount} позиций; наличие цветов и мешков уточняйте у менеджера.`}
  >
    <nav class="os-jump" aria-label="Разделы страницы" data-reveal>
      <ol>
        {jump.map((j) => <li><a href={j.href}>{j.label}</a></li>)}
      </ol>
    </nav>
    <Fragment slot="aside">
      <div class="os-pal">
        <div class="os-pal__item os-pal__item--lg">
          <a class="os-pal__strip strip" href={`#${s250.id}-cveta`} tabindex="-1" aria-hidden="true">
            {strip.map((c) => <span class="mortar" style={`--c:${c.hex}`} title={c.title}></span>)}
          </a>
          <p class="os-pal__cap">
            <a href={`#${s250.id}-cveta`}>Палитра BRICK.COLOR</a>
            <span class="num">{colorsCount}&nbsp;{colorsWord(colorsCount)} в&nbsp;палитре</span>
          </p>
        </div>
        <p class="os-pal__note">
          Цвет на экране приблизительный: плашки сняты с фото палитры производителя. Кодов цвета у Dauer нет&nbsp;— под плашкой номер полосы на палитре.
        </p>
        <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
      </div>
    </Fragment>
  </PageHead>

  <Section id="proizvoditel" kicker="Производитель" title="Dauer — смеси из Жуковского" bg="base">
    <dl class="os-maker__facts" data-reveal>
      {maker.map((m) => (
        <div class="os-maker__row">
          <dt class="label">{m.title}</dt>
          <dd>
            <p set:html={keepTogether(m.fact.text)} />
            <a class="os-srclink" href={m.fact.src} rel="nofollow noopener" target="_blank">{srcName(m.fact.src)}</a>
          </dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section
    id="vybor"
    kicker="Выбор смеси"
    title="250, 251 или 252: решает кирпич"
    subtitle="Палитра, толщина шва и норма воды у трёх смесей одинаковые. Различаются кирпич, под который рассчитана смесь, прочность и морозостойкость."
    bg="alt"
  >
    <table class="os-cmp" data-reveal>
      <caption class="os-vh">Сравнение BRICK.COLOR 250, 251 и 252</caption>
      <thead>
        <tr>
          <th scope="col"><span class="os-vh">Показатель</span></th>
