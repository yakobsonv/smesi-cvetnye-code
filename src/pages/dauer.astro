  <Section id="voprosy" kicker="Вопросы" title="Частые вопросы о Dauer" bg="base">
    <FaqAccordion items={faq} site="smesi" slug="dauer" />
  </Section>

  <CtaBand
    source="dauer"
    title={nb('Подберём Dauer под ваш кирпич')}
    text={nb('Назовите кирпич и площадь кладки — подскажем, 250, 251 или 252, поможем с цветом шва и посчитаем мешки.')}
  />
</Page>

<style is:global>
  /* Подпись секции на тёмной полосе: общий .section__kicker красит её --color-muted (#625d55),
     на туши это 2,6:1. Только для своей полосы «Зимняя версия» (класс os-zima). */
  html[data-site='smesi'] .os-zima .section__kicker { color: rgb(247 244 238 / 0.66); }
  /* Только эта страница: слово «BRICK.COLOR» в H1 на 320 px не влезало в 288 px (прокрутка вбок на 2 px) —
     на узких экранах кегль от ширины колонки текста, как на странице белой смеси. */
  html[data-site='smesi'] .mh__text { container-type: inline-size; }
  @media (max-width: 419px) {
    html[data-site='smesi'] .mh__title { max-width: none; font-size: min(var(--fs-h1), 12cqi); }
  }
</style>

<style>
  .os-vh {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ── первый экран: оглавление строками через линии ───────────────────────── */
  .os-jump { margin-top: var(--space-7); }
  .os-jump ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair-strong);
    counter-reset: os-jump;
  }
  .os-jump li { counter-increment: os-jump; border-bottom: 1px solid var(--hair); }
  .os-jump a {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-height: 44px;
    padding: 12px 0 10px;
    color: var(--ink);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
  }
  .os-jump a::before {
    content: counter(os-jump, decimal-leading-zero);
    flex: none;
    font-size: 12px;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }
  .os-jump a::after {
    content: '↓';
    margin-left: auto;
    color: var(--color-muted);
    opacity: 0;
    translate: 0 -4px;
    transition: opacity var(--dur) var(--ease), translate var(--dur) var(--ease);
  }
  .os-jump a:hover::after, .os-jump a:focus-visible::after { opacity: 1; translate: 0 0; }
  /* «BRICK.COLOR 250» не влезает в полколонки на 320 px (давало прокрутку вбок на 2 px) — на узких экранах одна колонка */
  @media (max-width: 419px) { .os-jump ol { grid-template-columns: 1fr; } }

  /* ── первый экран: полоса оттенков вместо кадра кладки ───────────────────── */
  .os-pal { display: grid; gap: var(--space-5); justify-items: start; }
  .os-pal__item { width: 100%; }
  .os-pal__strip { height: clamp(160px, 24vw, 360px); }
  .os-pal__strip span { transition: flex-grow 0.5s var(--ease); }
  .os-pal__strip:hover span:hover { flex-grow: 3; }
  .os-pal__cap {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 4px 16px;
    margin: 10px 0 0;
    font-size: var(--fs-tiny);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .os-pal__cap a { color: var(--ink); font-weight: 500; text-decoration: none; border-bottom: 1px solid var(--hair-strong); }
  .os-pal__cap a:hover { border-color: var(--ink); }
  .os-pal__note { max-width: 46ch; margin: 0; font-size: var(--fs-small); color: var(--color-muted); }

  /* ── общее ──────────────────────────────────────────────────────────────── */
  .label { margin: 0 0 var(--space-3); }
  .os-src { max-width: 90ch; margin: var(--space-5) 0 0; font-size: var(--fs-tiny); line-height: 1.6; color: var(--color-muted); }
  .os-src a, .os-srclink { color: var(--color-text-soft); }
  .os-srclink { font-size: var(--fs-tiny); }
  .os-colors-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    margin: clamp(56px, 7vw, 104px) 0 var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair-strong);
  }
  .os-sub { margin: 0; font-size: var(--fs-h3); line-height: 1.05; letter-spacing: -0.01em; }

  /* ── 1. производитель: факты строками ───────────────────────────────────── */
  .os-maker__facts { max-width: 92ch; margin: 0; border-top: 1px solid var(--hair-strong); }
  .os-maker__row { display: grid; gap: var(--space-2) var(--space-6); padding: var(--space-5) 0; border-bottom: 1px solid var(--hair); }
  .os-maker__row dt { margin: 0; padding-top: 5px; }
  .os-maker__row dd { margin: 0; }
  .os-maker__row :global(.os-nowrap) { white-space: nowrap; }
  .os-maker__row p { max-width: 62ch; margin: 0 0 var(--space-3); color: var(--color-text-soft); }
  @media (min-width: 760px) { .os-maker__row { grid-template-columns: 150px minmax(0, 1fr); } }

  /* ── 2. сравнение: таблица через линии, три смеси ───────────────────────── */
  /* table-layout: fixed — три колонки значений держат свои проценты, таблица не шире контейнера (на 768 вылезала на 25 px) */
  .os-cmp { width: 100%; border-collapse: collapse; table-layout: fixed; }
  .os-cmp th, .os-cmp td { padding: 16px 20px 16px 0; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
  .os-cmp thead th { padding-bottom: 18px; border-bottom: 1px solid var(--ink); vertical-align: bottom; }
  .os-cmp thead a {
    display: block;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(28px, 2.8vw, 40px);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
  }
  .os-cmp thead a:hover { font-style: italic; }
  .os-cmp__abs {
    display: block;
    margin-top: 8px;
    font-size: var(--fs-tiny);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .os-cmp__row { border-bottom: 1px solid var(--hair); }
  .os-cmp__row th { width: 22%; font-weight: 400; font-size: var(--fs-small); color: var(--color-muted); }
  .os-cmp__row td { width: 26%; font-weight: 500; }
  .os-cmp__row--wide td { font-weight: 400; color: var(--color-text-soft); }
  .os-cmp__same {
    margin-left: 12px;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
  }

  /* на телефоне строка таблицы — показатель сверху, значения трёх смесей столбиком */
  @media (max-width: 699px) {
    .os-cmp thead tr { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: var(--space-3); }
    .os-cmp thead th:first-child { display: none; }
    .os-cmp thead th { align-self: end; padding: 0 0 14px; }
    .os-cmp thead a { font-size: 24px; }
    .os-cmp tbody tr { display: grid; grid-template-columns: repeat(3, 1fr); column-gap: var(--space-3); padding: 14px 0; }
    .os-cmp tbody th { grid-column: 1 / -1; width: auto; padding: 0 0 6px; font-size: var(--fs-tiny); letter-spacing: 0.12em; text-transform: uppercase; }
    .os-cmp tbody td { width: auto; padding: 0; font-size: var(--fs-small); }
    .os-cmp tbody td[colspan] { grid-column: 1 / -1; }
    .os-cmp__row--wide td { grid-column: 1 / -1; }
    .os-cmp tbody td[data-col]::before {
      content: attr(data-col);
      display: block;
      margin-bottom: 2px;
      font-size: 11.5px;
      letter-spacing: 0.08em;
      color: var(--color-muted);
    }
  }

  .os-hints { display: grid; gap: 0 var(--space-6); margin-top: clamp(56px, 7vw, 96px); }
  .os-hints__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); counter-reset: os-hint; }
  .os-hints__list li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    gap: 4px var(--space-3);
    padding: 18px 0;
    border-bottom: 1px solid var(--hair);
    counter-increment: os-hint;
  }
  .os-hints__list li::before {
    content: counter(os-hint, decimal-leading-zero);
    grid-row: 1 / span 2;
    padding-top: 9px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }
  .os-hints__list b { font-family: var(--font-head); font-weight: 500; font-size: clamp(23px, 2vw, 28px); line-height: 1.1; }
  .os-hints__list span { color: var(--color-text-soft); }
  @media (min-width: 900px) {
    .os-hints__list li { grid-template-columns: 34px minmax(0, 5fr) minmax(0, 6fr); column-gap: var(--space-5); align-items: baseline; }
    .os-hints__list li::before { grid-row: auto; padding-top: 0; }
  }
  @media (min-width: 1000px) {
    .os-hints { grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); align-items: start; }
    .os-hints > .label { padding-top: var(--space-4); }
  }

  /* ── 3–5. серии ─────────────────────────────────────────────────────────── */
  .os-ser { display: grid; gap: var(--space-7); }
  .os-ser__about { display: flex; flex-direction: column; align-items: stretch; }
  .os-quote {
    max-width: 30ch;
    margin: 0;
    font-family: var(--font-head);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(24px, 2.3vw, 32px);
    line-height: 1.18;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .os-quote__src { margin: var(--space-3) 0 0; font-size: var(--fs-tiny); color: var(--color-muted); }
  .os-quote__src a { color: var(--color-text-soft); }
  .os-ser__brick { margin-top: var(--space-7); }
  .os-ser__brick p:not(.label) { max-width: 52ch; margin: 0 0 var(--space-2); color: var(--color-text-soft); }
  .os-dl { margin: var(--space-6) 0 0; border-top: 1px solid var(--hair-strong); }
  .os-dl div { display: flex; justify-content: space-between; gap: var(--space-4); padding: 11px 0; border-bottom: 1px solid var(--hair); font-size: var(--fs-small); }
  .os-dl dt { color: var(--color-muted); }
  .os-dl dd { margin: 0; font-weight: 500; text-align: right; }
  .os-ser__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5) var(--space-6); margin-top: var(--space-6); }
  @media (min-width: 1000px) {
    .os-ser { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(48px, 7vw, 112px); align-items: start; }
    /* характеристики длиннее описания — описание с кнопкой едет рядом с таблицей */
    .os-ser__about { position: sticky; top: 96px; }
  }

  /* ── 6. зима: тушь, строки через линии ──────────────────────────────────── */
  .os-winter { display: grid; gap: var(--space-8); }
  .os-winter__lead { max-width: 56ch; margin: 0 0 var(--space-6); font-size: var(--fs-lead); color: rgb(247 244 238 / 0.82); }
  .os-winter__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid rgb(247 244 238 / 0.32); counter-reset: os-win; }
  .os-winter__list li {
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    column-gap: var(--space-3);
    padding: 14px 0;
    border-bottom: 1px solid rgb(247 244 238 / 0.16);
    counter-increment: os-win;
  }
  .os-winter__list li::before {
    content: counter(os-win, decimal-leading-zero);
    padding-top: 3px;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
    color: rgb(247 244 238 / 0.6);
  }
