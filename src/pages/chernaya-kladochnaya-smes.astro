---
// Чёрная и графитовая кладочная смесь (план страниц, волна 1). Угол страницы — тёмный шов:
// «чёрный» у Perel, «графит» у Основит; как тёмный шов выглядит на светлом и красном кирпиче;
// чем заменить чёрный, если он слишком резкий; тёмное для расшивки готовых швов.
//
// Факты — только из данных:
//   позиции, серии, типы кирпича — src/data/catalog.ts;
//   «для какого кирпича» и назначение — ДОСЛОВНО из SERIES_FACTS (src/data/series-facts.ts);
//   морозостойкость, прочность, ширина шва — SERIES_FACTS, с адресом источника;
//   о тёмном шве — DARK_JOINT_FACTS;
//   кадры кладки — src/data/kladka.ts (визуализации из материалов клиента; шов на кадре — видимый
//   цвет, к позиции Perel или Основит НЕ привязан, поэтому подписи без названий смесей).
// Цен нет намеренно (см. src/data/catalog.ts) — у позиции кнопка «Узнать цену».
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import {
  BRICK_TYPES,
  POSITIONS,
  seriesById,
  seriesFor,
  positionsByTone,
  type BrickType,
  type Color,
  type SeriesId,
} from '../data/catalog';
import { SERIES_FACTS, DARK_JOINT_FACTS, PEREL_BLACK_FROST_SRC } from '../data/series-facts';
import { KLADKA, type KladkaBrick, type KladkaSeam } from '../data/kladka';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { plural } from '../lib/format';
import type { FaqItem } from '../lib/types';

const SLUG = 'chernaya-kladochnaya-smes';
const ext = { rel: 'nofollow noopener', target: '_blank' } as const;

/** Подпись источника по адресу: «td-perel.ru», «osnovit.ru», «видео производителя». */
const host = (url: string) => {
  const h = new URL(url).hostname.replace(/^www\./, '');
  return h.includes('youtube') ? 'видео производителя' : h;
};

/* ── Позиции тёмного тона ─────────────────────────────────────────────────────── */

const darkKladka = positionsByTone(['black'], 'kladka');
const darkRasshivka = positionsByTone(['black'], 'rasshivka');
const darkAll = [...darkKladka, ...darkRasshivka];

const positionOf = (id: SeriesId) => POSITIONS.find((p) => p.series === id && p.color.tone === 'black');

// Тёмный цвет каждого производителя — по палитрам каталога (группа «Чёрные и графит»).
const perelBlack = darkKladka.find((p) => seriesById(p.series).brand === 'perel')?.color;
const osnovitBlack = darkKladka.find((p) => seriesById(p.series).brand === 'osnovit')?.color;

/* ── Первый экран: кадр кладки ────────────────────────────────────────────────── */

const frame = (brickId: string, seamId: string): { b: KladkaBrick; s: KladkaSeam } | null => {
  const b = KLADKA.find((x) => x.id === brickId);
  const s = b?.seams.find((x) => x.id === seamId);
  return b && s ? { b, s } : null;
};
const brickLabel = (b: KladkaBrick) => `Кирпич «${b.brick}»`;
const frameAlt = (f: { b: KladkaBrick; s: KladkaSeam }) =>
  `Кладка из кирпича «${f.b.brick}», ${f.b.factoryName}, со швом цвета «${f.s.label}» — визуализация`;

const heroFrame = frame('osmibt-seryj-bezh', 'black');

/* ── Галерея: тёмный шов на светлом и на красном кирпиче ──────────────────────── */

const galleryGroups = [
  {
    title: 'На светлом кирпиче',
    frames: [frame('osmibt-belyj', 'black'), frame('osmibt-belyj', 'darkgrey'), frame('osmibt-slonovaya-kost', 'blackbrown')],
  },
  {
    title: 'На красном и красно-коричневом кирпиче',
    frames: [frame('osmibt-krasnyj', 'black'), frame('osmibt-krasnyj', 'darkgrey'), frame('osmibt-terrakot', 'blackbrown')],
  },
].map((g) => ({ ...g, frames: g.frames.filter((f): f is NonNullable<typeof f> => Boolean(f)) }));

/* ── Кладочные: по типу кирпича ───────────────────────────────────────────────── */

const typeOrder: BrickType[] = ['obychnyj', 'ruchnoj', 'klinker'];
const brickGroups = typeOrder.map((t) => ({
  t,
  info: BRICK_TYPES[t],
  series: seriesFor(t).filter((s) => positionOf(s.id)),
}));

/* ── Расшивка ─────────────────────────────────────────────────────────────────── */

const specOf = (id: SeriesId, label: string) => SERIES_FACTS[id].specs.find((f) => f.label === label);

const rlNote = SERIES_FACTS['perel-rl'].notes?.find((n) => n.text.startsWith('Цветную декоративную затирку'));
const xcRenew = SERIES_FACTS['osnovit-xc30'].notes?.find((n) => n.text.startsWith('Подходит как для нового'));

const rasshivka = [
  {
    id: 'perel-rl' as SeriesId,
    // у RL назначение по кирпичной кладке — в forBrick (описание карточек RL)
    what: SERIES_FACTS['perel-rl'].forBrick,
    whatSrc: SERIES_FACTS['perel-rl'].forBrickSrc,
    extra: rlNote ? { text: 'Perel отдельно предупреждает: цветной кладочный раствор не заменяет декоративную затирку.', src: rlNote.src } : null,
  },
  {
    id: 'osnovit-xc30' as SeriesId,
    what: SERIES_FACTS['osnovit-xc30'].purpose,
    whatSrc: SERIES_FACTS['osnovit-xc30'].purposeSrc,
    // пересказ заметки технической карты ХС30 «Подходит как для нового строительства, так и для обновления швов кладки»
    extra: xcRenew ? { text: 'По технической карте Основит, ХС30 подходит и для нового строительства, и для обновления швов кладки.', src: xcRenew.src } : null,
  },
];

/* ── Серые оттенки: «если чёрный слишком резкий» ──────────────────────────────── */

const greyGroups = [
  { title: 'Perel SL, VL, NL', series: 'perel-sl' as SeriesId },
  { title: 'Perel RL — затирка', series: 'perel-rl' as SeriesId },
  { title: 'Основит Брикформ МС11 и МС11/1', series: 'osnovit-mc11' as SeriesId },
  { title: 'Основит Бриксэйв ХС30 — расшивка', series: 'osnovit-xc30' as SeriesId },
].map((g) => ({
  ...g,
  colors: seriesById(g.series).colors.filter((c: Color) => c.tone === 'grey'),
}));
const greyCount = POSITIONS.filter((p) => p.color.tone === 'grey').length;

/* ── Морозостойкость и прочность тёмных позиций ───────────────────────────────── */

/** Морозостойкость именно чёрного цвета: у Perel VL и NL в данных строка вида
 *  «не менее 75 циклов; у красного (…) и чёрного (…) — не менее 50 циклов» — берём часть про чёрный. */
const frostForDark = (id: SeriesId) => {
  const f = specOf(id, 'Морозостойкость');
  if (!f) return null;
  const darkPart = /чёрного[^—]*—\s*(.+)$/.exec(f.value);
  // источник — карточка именно чёрной смеси, где стоит это число (у «серой» карточки — 75 циклов)
  return { value: darkPart ? darkPart[1] : f.value, other: darkPart ? f.value.split(';')[0] : null, src: (darkPart && PEREL_BLACK_FROST_SRC[id]) || f.src };
};

const specRows = darkAll.map((p) => {
  const s = seriesById(p.series);
  const frost = frostForDark(p.series);
  const strength = specOf(p.series, 'Прочность на сжатие');
  return {
    id: p.id,
    name: s.name,
    color: `${p.color.name}, ${s.brand === 'perel' ? 'арт.' : 'цвет'} ${p.article}`,
    frost,
    strength,
  };
});
const specSources = [...new Map(specRows.flatMap((r) => [r.frost, r.strength]).filter(Boolean).map((f) => [f!.src, f!.src])).values()];
// Подписи источников различимы: у Perel VL и NL морозостойкость чёрного взята с карточки чёрной
// смеси, остальное — с карточки серии; одинаковые «Perel VL, Perel VL» путали (сквозная проверка 11.10).
const blackFrostSrcs = new Set(Object.values(PEREL_BLACK_FROST_SRC));
const sourceLabel = (src: string) => {
  const row = specRows.find((r) => r.frost?.src === src || r.strength?.src === src);
  if (!row) return host(src);
  return blackFrostSrcs.has(src) ? `${row.name}, чёрная смесь` : row.name;
};

/* ── Вопросы ──────────────────────────────────────────────────────────────────── */

const perelSl = seriesById('perel-sl');
const nl = positionOf('perel-nl');
const mc11Graphite = positionOf('osnovit-mc11');
const mc111Graphite = positionOf('osnovit-mc11-1');
const vl = positionOf('perel-vl');
/** «5–12 %» не должно рваться перед знаком процента */
const nb = (v?: string) => (v ?? '').replace(/ %/g, '\u00a0%');
const mc11Abs = specOf('osnovit-mc11', 'Водопоглощение кирпича');
const mc111Abs = specOf('osnovit-mc11-1', 'Водопоглощение кирпича');
// «SL — для керамического кирпича, VL — для кирпича ручной формовки, NL — для клинкерного кирпича» (catalog.ts → short)
const perelThree = (['perel-sl', 'perel-vl', 'perel-nl'] as SeriesId[])
  .map((id) => `${seriesById(id).name.replace('Perel ', '')} — ${seriesById(id).short}`)
  .join(', ');
const rl = positionOf('perel-rl');
const xc = positionOf('osnovit-xc30');
const vlFrost = frostForDark('perel-vl');
const slFrost = specOf('perel-sl', 'Морозостойкость');
const mcFrost = specOf('osnovit-mc11', 'Морозостойкость');
const rlWidth = specOf('perel-rl', 'Ширина шва');
const xcWidth = specOf('osnovit-xc30', 'Ширина шва');
// у RL «5–30 мм», у ХС30 «5–30 мм (рекомендуемая)» — если диапазон один, говорим одной фразой
const widthLine = rlWidth && xcWidth && xcWidth.value.startsWith(rlWidth.value)
  ? `Оба рассчитаны на швы шириной ${rlWidth.value}.`
  : `Ширина шва у RL — ${rlWidth?.value}, у ХС30 — ${xcWidth?.value}.`;
const perelBlackRows = (['perel-sl', 'perel-vl', 'perel-nl'] as SeriesId[]).map((id) => ({
  name: seriesById(id).name,
  article: positionOf(id)?.article,
  absorption: specOf(id, 'Водопоглощение кирпича')?.value,
  strength: specOf(id, 'Прочность на сжатие')?.value,
}));

// ⚠️ Общий вопрос «почему шов не такой, как образец» здесь НЕ ставить: он уже есть на страницах
// белой смеси и Основит (повтор между страницами). Вопросы этой страницы — только про тёмный шов.
const faq: FaqItem[] = [
  {
    q: 'Чем чёрный Perel отличается от графита Основит?',
    a: `<p>Это цвета разных производителей: в палитре Perel — «${perelBlack?.name}» (код ${perelBlack?.code}), у Основит — «${osnovitBlack?.name}» (код ${osnovitBlack?.code}). Чёрный Perel у нас есть в сериях SL, VL и NL, мешок ${perelSl.packKg}\u00a0кг; графит Основит — в Брикформ МС11 и МС11/1, мешок ${seriesById('osnovit-mc11').packKg}\u00a0кг.</p><p>Серию в обоих случаях выбирают по кирпичу. У Основит их две: МС11 — ${nb(mc11Abs?.value)}; МС11/1 — ${nb(mc111Abs?.value)}. У Perel три: ${perelThree}.</p>`,
  },
  {
    q: 'Какую тёмную смесь взять для клинкерного кирпича?',
    a: `<p>Perel NL, ${nl?.color.name}, арт. ${nl?.article}. Производитель пишет о серии: «${SERIES_FACTS['perel-nl'].forBrick}».</p><p>У Основит графит (цвет ${mc11Graphite?.color.code}) есть в Брикформ МС11 — клинкер производитель называет среди её оснований: «${SERIES_FACTS['osnovit-mc11'].forBrick}»</p>`,
  },
  {
    q: 'Какую тёмную смесь взять для кирпича ручной формовки?',
    a: `<p>Perel VL, ${vl?.color.name}, арт. ${vl?.article}. О серии производитель пишет: «${SERIES_FACTS['perel-vl'].forBrick}».</p><p>У Основит графит (цвет ${mc111Graphite?.color.code}) есть в Брикформ МС11/1, её основания по технической карте: «${SERIES_FACTS['osnovit-mc11-1'].forBrick}»</p>`,
  },
  {
    q: 'Чёрный Perel SL, VL и NL — это один и тот же цвет?',
    a: `<p>По палитре — да: у трёх серий одна палитра, и чёрный в ней — код ${perelBlack?.code}. Артикулы разные: ${perelBlackRows.map((r) => `${r.name} — ${r.article}`).join(', ')}.</p><p>Серии различаются кирпичом и характеристиками: ${perelBlackRows.map((r) => `${r.name} — для кирпича с водопоглощением ${nb(r.absorption)}, прочность ${r.strength}`).join('; ')}.</p>`,
  },
  {
    q: 'Правда ли, что чёрный раствор менее морозостойкий?',
    a: `<p>У Perel VL и NL — да: у чёрного, как и у красного, морозостойкость ${vlFrost?.value}, у остальных цветов этих серий — ${(vlFrost?.other ?? '').trim()}. У Perel SL все цвета — ${slFrost?.value}. У Основит Брикформ МС11 и МС11/1 производитель указывает для серии ${mcFrost?.value}.</p>`,
  },
  {
    q: 'Можно ли сделать тёмный шов на уже готовой кладке?',
    a: `<p>Да, для этого есть растворы для расшивки: Perel RL ${rl?.color.name} (арт. ${rl?.article}) и Основит Бриксэйв ХС30 ${xc?.color.name} (цвет ${xc?.article}). ${widthLine}</p><p>По технической карте ХС30 перед расшивкой кладка должна выстояться не менее 3–4 недель, а швы расчищают на одинаковую глубину — не менее 1,5–2 см.</p>`,
  },
];

/* ── Разметка ─────────────────────────────────────────────────────────────────── */

const itemList = {
  '@type': 'ItemList',
  name: 'Чёрные и графитовые смеси для кладки и расшивки швов',
  numberOfItems: darkAll.length,
  itemListElement: darkAll.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title })),
};

const lead = `Для тёмного шва у Perel есть цвет «${perelBlack?.name}», у Основит — «${osnovitBlack?.name}». В ассортименте ${darkKladka.length} ${plural(darkKladka.length, 'позиция', 'позиции', 'позиций')} кладочной смеси — для обычного, клинкерного кирпича и кирпича ручной формовки — и ${darkRasshivka.length} ${plural(darkRasshivka.length, 'позиция', 'позиции', 'позиций')} для расшивки готовых швов.`;
---

<Page
  title="Чёрная и графитовая кладочная смесь — Perel и Основит"
  description="Чёрный шов Perel SL, VL, NL и графит Основит Брикформ, тёмные растворы для расшивки RL и ХС30. Как тёмный шов выглядит на светлом и красном кирпиче."
  slug={SLUG}
  current="chernaya"
  source="chernaya"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Цвет шва"
    h1="Чёрная и графитовая кладочная смесь"
    crumb="Чёрная и графитовая"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={lead}
  >
    <div class="ph-actions" data-reveal>
      <a class="btn btn--primary" href="#pozicii">Тёмные позиции</a>
      <a class="btn btn--ghost" href="#kladka">Как смотрится на кирпиче</a>
    </div>
    {heroFrame && (
      <figure class="ph-frame" slot="aside">
        <img
          src={heroFrame.s.src}
          srcset={`${heroFrame.s.srcSm} 320w, ${heroFrame.s.src} ${heroFrame.s.w}w`}
          sizes="(min-width: 960px) 44vw, 92vw"
          width={heroFrame.s.w}
          height={heroFrame.s.h}
          alt={frameAlt(heroFrame)}
          fetchpriority="high"
        />
        <figcaption>{brickLabel(heroFrame.b)}, шов {heroFrame.s.label} · визуализация</figcaption>
      </figure>
    )}
  </PageHead>

  <Section
    id="kladka"
    kicker="Как выглядит"
    title="Тёмный шов на светлом и красном кирпиче"
    subtitle="Три тёмных шва — чёрный, тёмно-серый и чёрно-коричневый — на светлом и на красном кирпиче. Сравните, как меняется рисунок кладки."
    bg="base"
  >
    {galleryGroups.map((g) => (
      <div class="gal">
        <h3 class="gal__title" data-reveal>{g.title}</h3>
        <ul class="gal__grid" data-reveal-stagger>
          {g.frames.map((f, i) => (
            <li>
              <figure class="gal__item">
                <img
                  src={f.s.src}
                  srcset={`${f.s.srcSm} 320w, ${f.s.src} ${f.s.w}w`}
                  sizes={i === 0 ? '(min-width: 640px) 30vw, 92vw' : '(min-width: 640px) 30vw, 46vw'}
                  width={f.s.w}
                  height={f.s.h}
                  loading="lazy"
                  decoding="async"
                  alt={frameAlt(f)}
                />
                <figcaption>
                  <b>Шов {f.s.label}</b>
                  <span>{brickLabel(f.b)}, {f.b.factoryName}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="note">
      Кадры — визуализации кладки, а не фотографии: цвет шва на них — видимый оттенок,
      а не конкретная смесь. Больше сочетаний кирпича и шва — в <a href={PAGES.podbor.href}>подборе шва</a>.
    </p>
  </Section>

  <Section
    id="pozicii"
    kicker="Кладочные смеси"
    title={'Чёрный и графит\u00a0— под ваш кирпич'}
    subtitle="Сначала тип кирпича, потом смесь: для каждого типа — серии Perel и Основит с тёмным цветом. Нажмите на образец или «Узнать цену» — назовём цену и наличие."
    bg="alt"
  >
    <div class="btg-list">
      {brickGroups.map((g, gi) => (
        <section class="btg" aria-labelledby={`btg-${g.t}`}>
          <header class="btg__head" data-reveal>
            <span class="btg__num" aria-hidden="true">0{gi + 1}</span>
            <h3 class="btg__title" id={`btg-${g.t}`}>{g.info.label}</h3>
            <p class="btg__abs">водопоглощение <b>{g.info.absorption}</b></p>
          </header>
          <ul class="btg__cards" data-reveal-stagger>
            {g.series.map((s) => {
              const p = positionOf(s.id)!;
              const f = SERIES_FACTS[s.id];
              return (
                <li class="dk">
                  <div class="dk__sw"><SwatchGrid series={s.id} tones={['black']} showSeries /></div>
                  <div class="dk__body">
                    <p class="dk__label">Для какого кирпича</p>
                    <p class="dk__quote">
                      «{f.forBrick}»{' '}
                      <a class="dk__src" href={f.forBrickSrc} {...ext}>{host(f.forBrickSrc)}</a>
                    </p>
                    <p class="dk__meta">Мешок {s.packKg} кг</p>
                    <div class="dk__foot">
                      <button class="btn btn--primary btn--sm" type="button" data-ask={p.title}>Узнать цену</button>
                      <a class="dk__all" href={`${PAGES.katalog.href}#${s.id}`}>Все цвета {s.name} <span aria-hidden="true">→</span></a>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </Section>

  <Section
    id="rasshivka"
    kicker="Для готовой кладки"
    title="Тёмное для расшивки швов"
    subtitle="Кладочная смесь даёт цветной шов сразу при кладке. Если кладка уже стоит или швы нужно обновить — тёмный цвет есть и у растворов для расшивки."
    bg="base"
  >
    <ul class="rs" data-reveal-stagger>
      {rasshivka.map((r) => {
        const s = seriesById(r.id);
        const p = positionOf(r.id)!;
        const width = specOf(r.id, 'Ширина шва');
        return (
          <li class="dk dk--rs">
            <div class="dk__sw"><SwatchGrid series={r.id} tones={['black']} showSeries /></div>
            <div class="dk__body">
              <p class="dk__label">Назначение</p>
              <p class="dk__quote">
                «{r.what}»{' '}
                <a class="dk__src" href={r.whatSrc} {...ext}>{host(r.whatSrc)}</a>
              </p>
              <ul class="dk__facts">
                {width && <li><span>Ширина шва</span><b>{width.value}</b></li>}
                <li><span>Мешок</span><b>{s.packKg} кг</b></li>
              </ul>
              {r.extra && (
                <p class="dk__extra">
                  {r.extra.text}{' '}
                  <a class="dk__src" href={r.extra.src} {...ext}>{host(r.extra.src)}</a>
                </p>
              )}
              <div class="dk__foot">
                <button class="btn btn--primary btn--sm" type="button" data-ask={p.title}>Узнать цену</button>
                <a class="dk__all" href={`${PAGES.katalog.href}#${s.id}`}>Все цвета {s.name} <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    {/* одна оговорка на обе группы образцов подряд: кладочные (выше) и для расшивки */}
    <SwatchNote />
  </Section>

  <Section
    id="seryj"
    kicker="Серые оттенки"
    title="Если чёрный слишком резкий"
    subtitle="Все серые цвета в ассортименте — по палитрам серий, с кодами производителя."
    bg="alt"
  >
    <div class="gr" data-reveal-stagger>
      {greyGroups.map((g) => (
        <div class="gr__group">
          <h3 class="gr__title">{g.title}</h3>
          <ul class="gr__list">
            {g.colors.map((c) => (
              <li>
                <span class="gr__chip" style={`--c:${swatchFor(g.series, c.code)}`} aria-hidden="true"></span>
                <span class="gr__name">{c.name}</span>
                <span class="gr__code">код {c.code}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="gr__actions" data-reveal>
      <a class="btn btn--ghost" href={`${PAGES.katalog.href}?ton=grey`}>Все серые в каталоге — {greyCount} {plural(greyCount, 'позиция', 'позиции', 'позиций')}</a>
      <a class="gr__back" href="#kladka">Тёмно-серый рядом с чёрным — на кадрах выше <span aria-hidden="true">↑</span></a>
    </p>
    <SwatchNote />
  </Section>

  {DARK_JOINT_FACTS.length > 0 && (
    <Section id="fakty" kicker="Производители о тёмном шве" title={'Что важно знать о\u00a0чёрном растворе'} bg="base">
      <ul class="facts" data-reveal-stagger>
        {DARK_JOINT_FACTS.map((f, i) => (
          <li class="fact">
            <span class="fact__num" aria-hidden="true">0{i + 1}</span>
            <p>{f.text}</p>
            <a class="dk__src" href={f.src} {...ext}>Источник: {host(f.src)}</a>
          </li>
        ))}
      </ul>

      <div class="tbl" data-reveal>
        <h3 class="tbl__title">Морозостойкость и прочность тёмных позиций</h3>
        <table class="tbl__table">
          <thead>
            <tr><th scope="col">Позиция</th><th scope="col">Морозостойкость</th><th scope="col">Прочность на сжатие</th></tr>
          </thead>
          <tbody>
            {specRows.map((r) => (
              <tr>
                <th scope="row"><b>{r.name}</b><span>{r.color}</span></th>
                <td data-label="Морозостойкость">{r.frost?.value ?? '—'}</td>
                <td data-label="Прочность на сжатие">{r.strength?.value ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="tbl__src">
          По данным производителя:{' '}
          {specSources.map((src, i) => (
            <Fragment>{i > 0 && ', '}<a href={src} {...ext}>{sourceLabel(src)}</a></Fragment>
          ))}.
        </p>
      </div>
    </Section>
  )}

  <Section id="voprosy" kicker="Вопросы" title="Частые вопросы о тёмном шве" bg="alt">
    <FaqAccordion items={faq} site="smesi" slug={SLUG} />
  </Section>

  <CtaBand
    source="chernaya"
    title="Подберём тёмный шов под ваш кирпич"
    text="Назовите кирпич и площадь кладки — подскажем, чёрный, графит или серый, нужную серию и количество мешков."
  />
</Page>

<style>
