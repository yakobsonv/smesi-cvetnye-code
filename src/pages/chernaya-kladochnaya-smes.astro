---
// Чёрная и графитовая кладочная смесь (план страниц, волна 1; редизайн 11.10 — язык «палитра шва»).
// Угол страницы — тёмный шов: «чёрный» у Perel, «графит» у Основит; тёмно-серые, если чёрный
// слишком резкий; тёмное для расшивки готовых швов. Кирпича на странице нет (Влад 11.10: «везде
// кирпич») — вместо кадров кладки тёмная палитра плашками раствора и ссылка на подбор шва.
//
// Факты — только из данных:
//   позиции, серии, типы кирпича — src/data/catalog.ts;
//   «для какого кирпича» и назначение — ДОСЛОВНО из SERIES_FACTS (src/data/series-facts.ts);
//   морозостойкость, прочность, ширина шва — SERIES_FACTS, с адресом источника;
//   о тёмном шве — DARK_JOINT_FACTS;
//   оттенки плашек — src/data/swatches.ts (приближение по палитрам производителей → оговорка SwatchNote).
// Цен нет намеренно (см. src/data/catalog.ts) — у позиции кнопка «Узнать цену».
// С 23.10 в «Под ваш кирпич» и в серых — и Promix, и Стройбриг (только ассортимент дилера): без цитат производителя,
// в таблице морозостойкости и прочности их нет — этих данных у нас нет. Тёмная палитра вверху — по-прежнему Perel и Основит.
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import {
  BRANDS,
  BRAND_LIST,
  BRICK_TYPES,
  POSITIONS,
  SERIES,
  andList,
  codeText,
  seriesById,
  seriesFor,
  positionsByTone,
  type BrickType,
  type Color,
  type SeriesId,
} from '../data/catalog';
import { SERIES_FACTS, DARK_JOINT_FACTS, PEREL_BLACK_FROST_SRC, hasFacts } from '../data/series-facts';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { plural } from '../lib/format';
import { nb as typoNb } from '../lib/typo';
// Пробел перед «—» — неразрывный: тире не начинает строку (сквозная проверка дизайна 11.10).
const nb = (t: string) => typoNb(t).replace(/ — /g, '\u00a0— ');
import type { FaqItem } from '../lib/types';

const SLUG = 'chernaya-kladochnaya-smes';
const ext = { rel: 'nofollow noopener', target: '_blank' } as const;

/** Подпись источника по адресу: «td-perel.ru», «osnovit.ru», «видео производителя». */
const host = (url: string) => {
  const h = new URL(url).hostname.replace(/^www\./, '');
  return h.includes('youtube') ? 'видео производителя' : h;
};

/* ── Позиции тёмного тона ─────────────────────────────────────────────────────── */

const darkKladka = positionsByTone(['black'], 'kladka');
const darkRasshivka = positionsByTone(['black'], 'rasshivka');
const darkAll = [...darkKladka, ...darkRasshivka];

const positionOf = (id: SeriesId) => POSITIONS.find((p) => p.series === id && p.color.tone === 'black');

// Тёмный цвет каждого производителя — по палитрам каталога (группа «Чёрные и графит»).
const perelBlack = darkKladka.find((p) => seriesById(p.series).brand === 'perel')?.color;
const osnovitBlack = darkKladka.find((p) => seriesById(p.series).brand === 'osnovit')?.color;
// у Dauer тёмных три — графитовый, антрацитовый, чёрный (палитра одна на 250 / 251 / 252)
const dauerDark = seriesById('dauer-250').colors.filter((c: Color) => c.tone === 'black');
const dauerBlack = dauerDark.find((c: Color) => c.name === 'чёрный');

/* ── Тёмная палитра: плашки раствора вместо кадров кладки ─────────────────────── */

/** Относительная яркость — только чтобы разложить плашки первого экрана от светлой к тёмной. */
const lum = (hex: string) => {
  const n = parseInt(hex.slice(1), 16);
  const [r, g, b] = [(n >> 16) & 255, (n >> 8) & 255, n & 255].map((v) => {
    const c = v / 255;
    return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4;
  });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};

interface Plaque {
  key: string;
  brand: string;
  name: string;
  code: string;
  hex: string;
  /** подпись под названием: «Perel · код 65» или «Perel RL · 0465» */
  meta: string;
  /** в каких кладочных сериях есть этот цвет: «SL, VL, NL» */
  inSeries?: string;
  /** что подставить в окно «Узнать цену» */
  ask: string;
}

/** «Брикформ МС11, Брикформ МС11/1» → «Брикформ МС11, МС11/1»; «SL, VL, NL» — как есть. */
const joinSeries = (names: string[]) => {
  const w = names[0]?.split(' ')[0];
  const shared = names.length > 1 && names.every((n) => n.startsWith(`${w} `));
  return shared ? `${w} ${names.map((n) => n.slice(w.length + 1)).join(', ')}` : names.join(', ');
};

/** Цвет кладочной палитры производителя (без привязки к серии): серию подбирают по кирпичу. */
const kladkaPlaque = (palette: SeriesId, code: string): Plaque | null => {
  const s = seriesById(palette);
  const c = s.colors.find((x: Color) => x.code === code);
  if (!c) return null;
  const brand = BRANDS[s.brand].name;
  const series = SERIES.filter((x) => x.purpose === 'kladka' && x.brand === s.brand && x.colors.some((y) => y.code === code));
  // у Dauer кодов цвета нет — «№ 8 на палитре» (catalog.ts → codeText)
  const codeLine = s.codeKind === 'palette' ? codeText(s, code) : `код ${code}`;
  return {
    key: `${palette}-${code}`,
    brand,
    name: c.name,
    code: s.codeKind === 'palette' ? codeText(s, code, true) : code,
    hex: swatchFor(palette, code),
    meta: `${brand} · ${codeLine}`,
    inSeries: joinSeries(series.map((x) => x.name.replace(`${brand} `, ''))),
    ask: `${brand}, ${c.name} (${codeLine}) — серию подберём под кирпич`,
  };
};

/** Позиция для расшивки — у неё одна серия, в окно идёт полное название позиции. */
const rsPlaque = (id: SeriesId): Plaque | null => {
  const p = positionOf(id);
  if (!p) return null;
  const s = seriesById(id);
  return {
    key: p.id,
    brand: BRANDS[s.brand].name,
    name: p.color.name,
    code: p.color.code,
    hex: swatchFor(id, p.color.code),
    meta: `${s.name} · ${p.article}`,
    ask: p.title,
  };
};

const isPlaque = (x: Plaque | null): x is Plaque => Boolean(x);

// Главные — чёрный Perel, графит Основит и чёрный Dauer (у Dauer рядом графитовый и антрацитовый).
const mainPlaques = [
  perelBlack ? kladkaPlaque('perel-sl', perelBlack.code) : null,
  osnovitBlack ? kladkaPlaque('osnovit-mc11', osnovitBlack.code) : null,
  dauerBlack ? kladkaPlaque('dauer-250', dauerBlack.code) : null,
  ...dauerDark.filter((c: Color) => c.name !== 'чёрный').map((c: Color) => kladkaPlaque('dauer-250', c.code)),
].filter(isPlaque);
// Тёмные из группы «серые»: тёмно-серый трёх марок и «мокрый асфальт» Основит — по плашкам
// палитр это самые тёмные серые (остальные серые — в разделе «Если чёрный слишком резкий»).
const greyPlaques = [
  kladkaPlaque('perel-sl', '15'),
  kladkaPlaque('osnovit-mc11', '022'),
  kladkaPlaque('osnovit-mc11', '028'),
  kladkaPlaque('dauer-250', '05'),
].filter(isPlaque);
const plaqueBrands = andList([...new Set([...mainPlaques, ...greyPlaques].map((x) => x.brand))]);
const rsPlaques = (['perel-rl', 'osnovit-xc30'] as SeriesId[]).map(rsPlaque).filter(isPlaque);

// Первый экран: те же тёмные оттенки кладочных палитр полосой — по плашкам от светлой к тёмной.
// Из тёмных Dauer в полосе только чёрный: с графитовым и антрацитовым полос было бы 9, на 320 px они не влезают.
const heroStrip = [...mainPlaques.filter((x) => !(x.brand === 'Dauer' && x.name !== 'чёрный')), ...greyPlaques].sort((a, b) => lum(b.hex) - lum(a.hex));

/* ── Кладочные: по типу кирпича ───────────────────────────────────────────────── */

const typeOrder: BrickType[] = ['obychnyj', 'ruchnoj', 'klinker'];
const brickGroups = typeOrder.map((t) => ({
  t,
  info: BRICK_TYPES[t],
  series: seriesFor(t).filter((s) => positionOf(s.id)),
}));

/* ── Расшивка ─────────────────────────────────────────────────────────────────── */

const specOf = (id: SeriesId, label: string) => (hasFacts(id) ? SERIES_FACTS[id].specs.find((f) => f.label === label) : undefined);

const rlNote = SERIES_FACTS['perel-rl'].notes?.find((n) => n.text.startsWith('Цветную декоративную затирку'));
const xcRenew = SERIES_FACTS['osnovit-xc30'].notes?.find((n) => n.text.startsWith('Подходит как для нового'));

const rasshivka = [
  {
    id: 'perel-rl' as SeriesId,
    // у RL назначение по кирпичной кладке — в forBrick (описание карточек RL)
    what: SERIES_FACTS['perel-rl'].forBrick,
    whatSrc: SERIES_FACTS['perel-rl'].forBrickSrc,
    extra: rlNote ? { text: 'Perel отдельно предупреждает: цветной кладочный раствор не заменяет декоративную затирку.', src: rlNote.src } : null,
  },
  {
    id: 'osnovit-xc30' as SeriesId,
    what: SERIES_FACTS['osnovit-xc30'].purpose,
    whatSrc: SERIES_FACTS['osnovit-xc30'].purposeSrc,
    // пересказ заметки технической карты ХС30 «Подходит как для нового строительства, так и для обновления швов кладки»
    extra: xcRenew ? { text: 'По технической карте Основит, ХС30 подходит и для нового строительства, и для обновления швов кладки.', src: xcRenew.src } : null,
  },
];

/* ── Серые оттенки: «если чёрный слишком резкий» ──────────────────────────────── */

const greyGroups = [
  { title: 'Perel SL, VL, NL', series: 'perel-sl' as SeriesId },
  { title: 'Perel RL — затирка', series: 'perel-rl' as SeriesId },
  { title: 'Основит Брикформ МС11 и МС11/1', series: 'osnovit-mc11' as SeriesId },
  { title: 'Основит Бриксэйв ХС30 — расшивка', series: 'osnovit-xc30' as SeriesId },
  // у Dauer палитра одна на 250, 251 и 252 (кодов нет — номер на палитре)
  { title: 'Dauer BRICK.COLOR 250, 251, 252', series: 'dauer-250' as SeriesId },
  // коды цвета у CKS 512 и CKS 017 разные — по строке на серию
  { title: 'Promix CKS 512', series: 'promix-cks512' as SeriesId },
  { title: 'Promix CKS 017', series: 'promix-cks017' as SeriesId },
  { title: 'Стройбриг Кирпирок MC11', series: 'stroybrig-mc11' as SeriesId },
].map((g) => ({
  ...g,
  colors: seriesById(g.series).colors.filter((c: Color) => c.tone === 'grey'),
}));
const greyCount = POSITIONS.filter((p) => p.color.tone === 'grey').length;

/* ── Морозостойкость и прочность тёмных позиций ───────────────────────────────── */

/** Морозостойкость именно чёрного цвета: у Perel VL и NL в данных строка вида
 *  «не менее 75 циклов; у красного (…) и чёрного (…) — не менее 50 циклов» — берём часть про чёрный. */
const frostForDark = (id: SeriesId) => {
  const f = specOf(id, 'Морозостойкость');
  if (!f) return null;
  const darkPart = /чёрного[^—]*—\s*(.+)$/.exec(f.value);
  // источник — карточка именно чёрной смеси, где стоит это число (у «серой» карточки — 75 циклов)
  return { value: darkPart ? darkPart[1] : f.value, other: darkPart ? f.value.split(';')[0] : null, src: (darkPart && PEREL_BLACK_FROST_SRC[id]) || f.src };
};

// только серии с данными производителя: у Promix и Стройбриг морозостойкости и прочности у нас нет
const specRows = darkAll.filter((p) => hasFacts(p.series)).map((p) => {
  const s = seriesById(p.series);
  const frost = frostForDark(p.series);
  const strength = specOf(p.series, 'Прочность на сжатие');
  return {
    id: p.id,
    name: s.name,
    color: s.codeKind === 'palette' ? `${p.color.name}, ${p.articleText}` : `${p.color.name}, ${s.brand === 'perel' ? 'арт.' : 'цвет'} ${p.article}`,
    hex: swatchFor(p.series, p.color.code),
    frost,
    strength,
  };
});
const specSources = [...new Map(specRows.flatMap((r) => [r.frost, r.strength]).filter(Boolean).map((f) => [f!.src, f!.src])).values()];
// Подписи источников различимы: у Perel VL и NL морозостойкость чёрного взята с карточки чёрной
// смеси, остальное — с карточки серии; одинаковые «Perel VL, Perel VL» путали (сквозная проверка 11.10).
const blackFrostSrcs = new Set(Object.values(PEREL_BLACK_FROST_SRC));
const sourceLabel = (src: string) => {
  const row = specRows.find((r) => r.frost?.src === src || r.strength?.src === src);
  if (!row) return host(src);
  return blackFrostSrcs.has(src) ? `${row.name}, чёрная смесь` : row.name;
};

/* ── Вопросы ──────────────────────────────────────────────────────────────────── */

const perelSl = seriesById('perel-sl');
const nl = positionOf('perel-nl');
const mc11Graphite = positionOf('osnovit-mc11');
const mc111Graphite = positionOf('osnovit-mc11-1');
const vl = positionOf('perel-vl');
/** «5–12 %» не должно рваться перед знаком процента */
const pct = (v?: string) => (v ?? '').replace(/ %/g, ' %');
const mc11Abs = specOf('osnovit-mc11', 'Водопоглощение кирпича');
const mc111Abs = specOf('osnovit-mc11-1', 'Водопоглощение кирпича');
// «SL — для керамического кирпича, VL — для кирпича ручной формовки, NL — для клинкерного кирпича» (catalog.ts → short)
const perelThree = (['perel-sl', 'perel-vl', 'perel-nl'] as SeriesId[])
  .map((id) => `${seriesById(id).name.replace('Perel ', '')} — ${seriesById(id).short}`)
  .join(', ');
const rl = positionOf('perel-rl');
const xc = positionOf('osnovit-xc30');
const vlFrost = frostForDark('perel-vl');
const slFrost = specOf('perel-sl', 'Морозостойкость');
const mcFrost = specOf('osnovit-mc11', 'Морозостойкость');
const rlWidth = specOf('perel-rl', 'Ширина шва');
const xcWidth = specOf('osnovit-xc30', 'Ширина шва');
// у RL «5–30 мм», у ХС30 «5–30 мм (рекомендуемая)» — если диапазон один, говорим одной фразой
const widthLine = rlWidth && xcWidth && xcWidth.value.startsWith(rlWidth.value)
  ? `Оба рассчитаны на швы шириной ${rlWidth.value}.`
  : `Ширина шва у RL — ${rlWidth?.value}, у ХС30 — ${xcWidth?.value}.`;
const perelBlackRows = (['perel-sl', 'perel-vl', 'perel-nl'] as SeriesId[]).map((id) => ({
  name: seriesById(id).name,
  article: positionOf(id)?.article,
  absorption: specOf(id, 'Водопоглощение кирпича')?.value,
  strength: specOf(id, 'Прочность на сжатие')?.value,
}));

// ⚠️ Общий вопрос «почему шов не такой, как образец» здесь НЕ ставить: он уже есть на страницах
// белой смеси и Основит (повтор между страницами). Вопросы этой страницы — только про тёмный шов.
const faq: FaqItem[] = [
  {
    q: 'Чем чёрный Perel отличается от графита Основит?',
    a: `<p>Это цвета разных производителей: в палитре Perel — «${perelBlack?.name}» (код ${perelBlack?.code}), у Основит — «${osnovitBlack?.name}» (код ${osnovitBlack?.code}). Чёрный Perel у нас есть в сериях SL, VL и NL, мешок ${perelSl.packKg} кг; графит Основит — в Брикформ МС11 и МС11/1, мешок ${seriesById('osnovit-mc11').packKg} кг.</p><p>Серию в обоих случаях выбирают по кирпичу. У Основит их две: МС11 — ${pct(mc11Abs?.value)}; МС11/1 — ${pct(mc111Abs?.value)}. У Perel три: ${perelThree}.</p>`,
  },
  {
    q: 'Какую тёмную смесь взять для клинкерного кирпича?',
    a: `<p>Perel NL, ${nl?.color.name}, арт. ${nl?.article}. Производитель пишет о серии: «${SERIES_FACTS['perel-nl'].forBrick}».</p><p>У Основит графит (цвет ${mc11Graphite?.color.code}) есть в Брикформ МС11 — клинкер производитель называет среди её оснований: «${SERIES_FACTS['osnovit-mc11'].forBrick}»</p><p>У Dauer для клинкера — BRICK.COLOR 252: «${SERIES_FACTS['dauer-252'].forBrick}». Тёмные цвета в его палитре — ${dauerDark.map((c: Color) => c.name).join(', ')}.</p>`,
  },
  {
    q: 'Какую тёмную смесь взять для кирпича ручной формовки?',
    a: `<p>Perel VL, ${vl?.color.name}, арт. ${vl?.article}. О серии производитель пишет: «${SERIES_FACTS['perel-vl'].forBrick}».</p><p>У Основит графит (цвет ${mc111Graphite?.color.code}) есть в Брикформ МС11/1, её основания по технической карте: «${SERIES_FACTS['osnovit-mc11-1'].forBrick}»</p>`,
  },
  {
    q: 'Чёрный Perel SL, VL и NL — это один и тот же цвет?',
    a: `<p>По палитре — да: у трёх серий одна палитра, и чёрный в ней — код ${perelBlack?.code}. Артикулы разные: ${perelBlackRows.map((r) => `${r.name} — ${r.article}`).join(', ')}.</p><p>Серии различаются кирпичом и характеристиками: ${perelBlackRows.map((r) => `${r.name} — для кирпича с водопоглощением ${pct(r.absorption)}, прочность ${r.strength}`).join('; ')}.</p>`,
  },
  {
    q: 'Правда ли, что чёрный раствор менее морозостойкий?',
    a: `<p>У Perel VL и NL — да: у чёрного, как и у красного, морозостойкость ${vlFrost?.value}, у остальных цветов этих серий — ${(vlFrost?.other ?? '').trim()}. У Perel SL все цвета — ${slFrost?.value}. У Основит Брикформ МС11 и МС11/1 производитель указывает для серии ${mcFrost?.value}.</p>`,
  },
  {
    q: 'Можно ли сделать тёмный шов на уже готовой кладке?',
    a: `<p>Да, для этого есть растворы для расшивки: Perel RL ${rl?.color.name} (арт. ${rl?.article}) и Основит Бриксэйв ХС30 ${xc?.color.name} (цвет ${xc?.article}). ${widthLine}</p><p>По технической карте ХС30 перед расшивкой кладка должна выстояться не менее 3–4 недель, а швы расчищают на одинаковую глубину — не менее 1,5–2 см.</p>`,
  },
];

/* ── Разметка ─────────────────────────────────────────────────────────────────── */

const itemList = {
  '@type': 'ItemList',
  name: 'Чёрные и графитовые смеси для кладки и расшивки швов',
  numberOfItems: darkAll.length,
  itemListElement: darkAll.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title })),
};

const lead = `Для тёмного шва у Perel есть цвет «${perelBlack?.name}», у Основит — «${osnovitBlack?.name}», у Dauer — ${dauerDark.map((c: Color) => `«${c.name}»`).join(', ')}. В ассортименте ${darkKladka.length} ${plural(darkKladka.length, 'позиция', 'позиции', 'позиций')} кладочной смеси — для обычного, клинкерного кирпича и кирпича ручной формовки — и ${darkRasshivka.length} ${plural(darkRasshivka.length, 'позиция', 'позиции', 'позиций')} для расшивки готовых швов.`;
---

<Page
  title={`Чёрная и графитовая кладочная смесь — ${BRAND_LIST}`}
  description="Чёрный шов Perel SL, VL, NL и Promix, графит Основит Брикформ и Стройбриг, графитовый, антрацитовый и чёрный Dauer BRICK.COLOR, тёмные растворы для расшивки RL и ХС30. Как тёмный шов выглядит на светлом и красном кирпиче."
  slug={SLUG}
  current="chernaya"
  source="chernaya"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Цвет шва"
    h1="Чёрная и графитовая кладочная смесь"
    crumb="Чёрная и графитовая"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={nb(lead)}
  >
    <div class="ph-actions" data-reveal>
      <a class="btn btn--primary" href="#pozicii">Тёмные позиции</a>
      <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
    </div>
    {heroStrip.length > 0 && (
      <figure class="hs" slot="aside">
        <div class="hs__strip strip strip--neutral" aria-hidden="true">
          {heroStrip.map((x, i) => (
            <span class="hs__band mortar" style={`--c:${x.hex};--i:${i}`}>
              <span class="hs__code"><span>{x.brand}</span><b class="num">{x.code}</b></span>
            </span>
          ))}
        </div>
        <figcaption class="hs__cap">
          <span class="label">{plaqueBrands} · {heroStrip.length} {plural(heroStrip.length, 'тёмный оттенок', 'тёмных оттенка', 'тёмных оттенков')} для кладки</span>
          <a class="hs__more" href="#kladka">Названия и серии <span aria-hidden="true">↓</span></a>
        </figcaption>
      </figure>
    )}
  </PageHead>

  <section class="dp" id="kladka" aria-labelledby="dp-title">
    <Container>
      <header class="dp__head" data-reveal>
        <p class="dp__kicker">Тёмная палитра</p>
        <h2 class="dp__title" id="dp-title">{nb('Чёрный, графит и тёмно-серые')}</h2>
        <p class="dp__sub">{nb('Чёрный у Perel и Dauer, графит у Основит и графитовый с антрацитовым у Dauer — для кладки; тёмное есть и для расшивки готовых швов. Рядом — тёмно-серые оттенки из тех же палитр. Нажмите на образец — назовём цену и наличие.')}</p>
      </header>

      <div class="dp__grid">
        <div class="dp__main">
          <p class="dp__label">Для кладки</p>
          <ul class="dp__big" data-reveal-stagger>
            {mainPlaques.map((x) => (
              <li>
                <button class="dp__chip" type="button" data-ask={x.ask} aria-label={`${x.ask} — узнать цену`}>
                  <span class="dp__sw mortar" style={`--c:${x.hex}`} aria-hidden="true"></span>
                  <span class="dp__name">{x.name}</span>
                  <span class="dp__meta num">{x.meta}</span>
                  {x.inSeries && <span class="dp__in">{x.brand} {x.inSeries}</span>}
                </button>
              </li>
            ))}
          </ul>
        </div>

        <div class="dp__side">
          <div class="dp__group">
            <p class="dp__label">Тёмно-серые и «мокрый асфальт»</p>
            <ul class="dp__small" data-reveal-stagger>
              {greyPlaques.map((x) => (
                <li>
                  <button class="dp__chip dp__chip--sm" type="button" data-ask={x.ask} aria-label={`${x.ask} — узнать цену`}>
                    <span class="dp__sw mortar" style={`--c:${x.hex}`} aria-hidden="true"></span>
                    <span class="dp__name">{x.name}</span>
                    <span class="dp__meta num">{x.meta}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <div class="dp__group">
            <p class="dp__label">{nb('Для расшивки готовых швов')}</p>
            <ul class="dp__small" data-reveal-stagger>
              {rsPlaques.map((x) => (
                <li>
                  <button class="dp__chip dp__chip--sm" type="button" data-ask={x.ask} aria-label={`${x.ask} — узнать цену`}>
                    <span class="dp__sw mortar" style={`--c:${x.hex}`} aria-hidden="true"></span>
                    <span class="dp__name">{x.name}</span>
                    <span class="dp__meta num">{x.meta}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>

      <div class="dp__foot">
        <SwatchNote class="dp__note" />
        <a class="arrow-link dp__link" href={PAGES.podbor.href}>Посмотреть тёмный шов на кирпиче <span aria-hidden="true">→</span></a>
      </div>
    </Container>
  </section>

  <Section
    id="pozicii"
    kicker="Кладочные смеси"
    title={'Чёрный и графит — под ваш кирпич'}
    subtitle={`Сначала тип кирпича, потом смесь: для каждого типа — серии ${BRAND_LIST} с тёмным цветом. Нажмите на образец или «Узнать цену» — назовём цену и наличие.`}
    bg="alt"
  >
    <ol class="bt3">
      {brickGroups.map((g, gi) => (
        <li class="bt3__row" aria-labelledby={`btg-${g.t}`}>
          <div class="bt3__head" data-reveal>
            <span class="bt3__num num" aria-hidden="true">0{gi + 1}</span>
            <h3 class="bt3__title" id={`btg-${g.t}`}>{nb(g.info.label)}</h3>
            <p class="bt3__abs"><span class="bt3__range num">{nb(g.info.absorption)}</span><span class="label">водопоглощение</span></p>
          </div>
          <ul class="ps" data-reveal-stagger>
            {g.series.map((s) => {
              const p = positionOf(s.id)!;
              const f = hasFacts(s.id) ? SERIES_FACTS[s.id] : null;
              return (
                <li class="ps__item">
                  <div class="ps__sw"><SwatchGrid series={s.id} tones={['black']} /></div>
                  <div class="ps__body">
                    <h4 class="ps__name">{s.name}</h4>
                    {f && (
                      <Fragment>
                        <p class="ps__label label">Для какого кирпича</p>
                        <p class="ps__quote">«{f.forBrick}»</p>
                        <p class="ps__src">по данным производителя: <a href={f.forBrickSrc} {...ext}>{host(f.forBrickSrc)}</a></p>
                      </Fragment>
                    )}
                    <p class="ps__meta">Мешок <span class="num">{nb(`${s.packKg} кг`)}</span></p>
                    <div class="ps__foot">
                      <button class="btn btn--ghost btn--sm" type="button" data-ask={p.title}>Узнать цену</button>
                      <a class="arrow-link ps__all" href={`${PAGES.katalog.href}#${s.id}`}>Все цвета {s.name} <span aria-hidden="true">→</span></a>
                    </div>
                  </div>
                </li>
              );
            })}
          </ul>
        </li>
      ))}
    </ol>
  </Section>

  <Section
    id="rasshivka"
    kicker="Для готовой кладки"
    title="Тёмное для расшивки швов"
    subtitle="Кладочная смесь даёт цветной шов сразу при кладке. Если кладка уже стоит или швы нужно обновить — тёмный цвет есть и у растворов для расшивки."
    bg="base"
  >
    <ul class="rs" data-reveal-stagger>
      {rasshivka.map((r) => {
        const s = seriesById(r.id);
        const p = positionOf(r.id)!;
        const width = specOf(r.id, 'Ширина шва');
        return (
          <li class="ps__item rs__item">
            <div class="ps__sw"><SwatchGrid series={r.id} tones={['black']} /></div>
            <div class="ps__body">
              <h3 class="ps__name rs__name">{s.name}</h3>
              <p class="ps__label label">Назначение</p>
              <p class="ps__quote">«{r.what}»</p>
              <p class="ps__src">по данным производителя: <a href={r.whatSrc} {...ext}>{host(r.whatSrc)}</a></p>
              <dl class="rs__facts">
                {width && <div><dt>Ширина шва</dt><dd class="num">{nb(width.value)}</dd></div>}
                <div><dt>Мешок</dt><dd class="num">{nb(`${s.packKg} кг`)}</dd></div>
              </dl>
              {r.extra && (
                <p class="rs__extra">
                  {r.extra.text}{' '}
                  <a class="rs__src" href={r.extra.src} {...ext}>{host(r.extra.src)}</a>
                </p>
              )}
              <div class="ps__foot">
                <button class="btn btn--ghost btn--sm" type="button" data-ask={p.title}>Узнать цену</button>
                <a class="arrow-link ps__all" href={`${PAGES.katalog.href}#${s.id}`}>Все цвета {s.name} <span aria-hidden="true">→</span></a>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    {/* одна оговорка на обе группы образцов подряд: кладочные (выше) и для расшивки */}
    <SwatchNote series={brickGroups.flatMap((g) => g.series.map((s) => s.id))} />
  </Section>

  <Section
    id="seryj"
    kicker="Серые оттенки"
    title="Если чёрный слишком резкий"
    subtitle="Все серые цвета в ассортименте — по палитрам серий, с кодами производителя."
    bg="alt"
  >
    <ul class="gr">
      {greyGroups.map((g) => (
        <li class="gr__row" data-reveal>
          <h3 class="gr__title">{nb(g.title)}</h3>
          <ul class="gr__list">
            {g.colors.map((c) => (
              <li class="gr__item">
                <span class="gr__chip mortar" style={`--c:${swatchFor(g.series, c.code)}`} aria-hidden="true"></span>
                <span class="gr__name">{c.name}</span>
                <span class="gr__code num">{seriesById(g.series).codeKind === 'palette' ? codeText(seriesById(g.series), c.code) : `код ${c.code}`}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="gr__actions" data-reveal>
      <a class="btn btn--ghost" href={`${PAGES.katalog.href}?ton=grey`}>Все серые в каталоге — {greyCount} {plural(greyCount, 'позиция', 'позиции', 'позиций')}</a>
      <a class="arrow-link" href="#kladka">{nb('Тёмно-серые рядом с чёрным — в палитре выше')} <span aria-hidden="true">↑</span></a>
    </p>
    <SwatchNote series={greyGroups.map((g) => g.series)} />
  </Section>

  {DARK_JOINT_FACTS.length > 0 && (
    <Section id="fakty" kicker="Производители о тёмном шве" title={'Что важно знать о чёрном растворе'} bg="base">
      <ol class="fx" data-reveal-stagger>
        {DARK_JOINT_FACTS.map((f, i) => (
          <li class="fx__item">
            <span class="fx__num num" aria-hidden="true">0{i + 1}</span>
            <p class="fx__text">{nb(f.text)}</p>
            <a class="fx__src" href={f.src} {...ext}>Источник: {host(f.src)}</a>
          </li>
        ))}
      </ol>

      <div class="tb" data-reveal>
        <div class="tb__aside">
          <h3 class="tb__title">{nb('Морозостойкость и прочность тёмных позиций')}</h3>
          <p class="tb__src">
            По данным производителя:{' '}
            {specSources.map((src, i) => (
              <Fragment>{i > 0 && ', '}<a href={src} {...ext}>{sourceLabel(src)}</a></Fragment>
            ))}.
          </p>
        </div>
        <table class="tb__table">
          <thead>
            <tr><th scope="col">Позиция</th><th scope="col">Морозостойкость</th><th scope="col">Прочность на сжатие</th></tr>
          </thead>
          <tbody>
            {specRows.map((r) => (
              <tr>
                <th scope="row">
                  <span class="tb__cell">
                    <span class="tb__sw mortar" style={`--c:${r.hex}`} aria-hidden="true"></span>
                    <span class="tb__pos"><b>{r.name}</b><span>{r.color}</span></span>
                  </span>
                </th>
                <td class="num" data-label="Морозостойкость">{r.frost ? nb(r.frost.value) : '—'}</td>
                <td class="num" data-label="Прочность на сжатие">{r.strength ? nb(r.strength.value) : '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>
  )}

  <Section id="voprosy" kicker="Вопросы" title="Частые вопросы о тёмном шве" bg="alt">
    <FaqAccordion items={faq} site="smesi" slug={SLUG} />
  </Section>

  <CtaBand
    source="chernaya"
    title={nb('Подберём тёмный шов под ваш кирпич')}
    text={nb('Назовите кирпич и площадь кладки — подскажем, чёрный, графит или серый, нужную серию и количество мешков.')}
  />
</Page>

<style>
  /* ── первый экран: полоса тёмных оттенков вместо кадра кладки ─────────────── */
  .ph-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5) var(--space-6); margin-top: var(--space-7); }
  .hs { margin: 0; }
  .hs__strip { height: clamp(220px, 34vw, 460px); }
  /* min-width: 0 — подпись не раздвигает полосу: семь полос на 320 px давали прокрутку вбок (24.10) */
  .hs__band { display: flex; align-items: flex-end; min-width: 0; animation: hs-in 0.9s var(--ease) both; animation-delay: calc(var(--i) * 70ms + 120ms); }
  .hs__code {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2px;
    min-width: 0;
    overflow: hidden;
    padding: 0 0 12px 12px;
    color: rgb(247 244 238 / 0.94);
    font-size: 11px;
    line-height: 1.15;
    letter-spacing: 0.06em;
  }
  .hs__code b { font-weight: 500; font-size: 13px; color: var(--paper); }
  .hs__cap { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-5); margin-top: var(--space-4); padding-top: var(--space-3); border-top: 1px solid var(--hair); }
  .hs__more { color: var(--ink); font-size: var(--fs-small); text-decoration: none; border-bottom: 1px solid var(--hair-strong); padding-bottom: 2px; }
  .hs__more:hover { border-color: var(--ink); }
  @keyframes hs-in { from { opacity: 0; translate: 0 16px; } to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .hs__band { animation: none; } }
  @media (max-width: 420px) {
    .hs__code { padding: 0 0 10px 8px; font-size: 10px; letter-spacing: 0.02em; }
    .hs__code b { font-size: 12px; }
  }
  @media (max-width: 359px) {
    .hs__code { padding: 0 0 8px 5px; font-size: 9px; letter-spacing: 0; }
    .hs__code b { font-size: 11px; }
  }

  /* ── тёмная палитра: плашки раствора на туши ──────────────────────────────── */
  .dp { padding-block: clamp(64px, 8.5vw, 136px); background: var(--ink); color: var(--paper); }
  .dp__head {
    display: grid;
    gap: var(--space-4) var(--space-7);
    margin-bottom: clamp(40px, 5vw, 72px);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(247 244 238 / 0.25);
  }
  .dp__kicker { margin: 0; font-size: var(--fs-tiny); font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: rgb(247 244 238 / 0.62); }
  .dp__title { margin: 0; font-size: var(--fs-h2); line-height: 1; letter-spacing: -0.02em; max-width: 16ch; text-wrap: balance; }
  .dp__sub { max-width: 52ch; margin: 0; font-size: var(--fs-lead); color: rgb(247 244 238 / 0.75); }
  @media (min-width: 1000px) {
    .dp__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; }
    .dp__kicker { grid-column: 1 / -1; }
  }

  .dp__grid { display: grid; gap: clamp(40px, 5vw, 64px); }
  .dp__label { margin: 0 0 var(--space-4); padding-bottom: var(--space-3); border-bottom: 1px solid rgb(247 244 238 / 0.18); font-size: var(--fs-tiny); font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: rgb(247 244 238 / 0.62); }
  .dp__big, .dp__small { display: grid; margin: 0; padding: 0; list-style: none; }
  .dp__big { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5) clamp(12px, 2vw, 28px); }
  .dp__small { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-5) clamp(10px, 1.4vw, 18px); }
  .dp__side { display: grid; gap: clamp(36px, 4vw, 56px); align-content: start; }

  .dp__chip { display: flex; flex-direction: column; width: 100%; padding: 0; border: 0; background: none; color: var(--paper); font: inherit; text-align: left; cursor: pointer; }
  .dp__sw { display: block; aspect-ratio: 4 / 5; margin-bottom: var(--space-4); outline: 1px solid rgb(247 244 238 / 0.14); outline-offset: -1px; transition: translate 0.5s var(--ease); }
  .dp__chip--sm .dp__sw { aspect-ratio: 1; margin-bottom: var(--space-3); }
  .dp__chip:hover .dp__sw, .dp__chip:focus-visible .dp__sw { translate: 0 -6px; }
  .dp__chip:focus-visible { outline: none; }
  .dp__chip:focus-visible .dp__sw { outline: 2px solid var(--paper); outline-offset: 3px; }
  .dp__name { font-family: var(--font-head); font-size: clamp(30px, 3vw, 44px); line-height: 1; letter-spacing: -0.015em; }
  .dp__chip--sm .dp__name { font-size: clamp(19px, 1.6vw, 23px); line-height: 1.1; }
  .dp__meta { margin-top: var(--space-2); font-size: var(--fs-small); color: var(--sand); }
  .dp__chip--sm .dp__meta { margin-top: 4px; font-size: 12.5px; letter-spacing: 0.02em; overflow-wrap: anywhere; }
  .dp__in { margin-top: 4px; font-size: var(--fs-small); color: rgb(247 244 238 / 0.68); }

  @media (min-width: 1000px) {
    .dp__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 5vw, 80px); }
  }
  @media (max-width: 599px) {
    .dp__small { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4) 10px; }
    .dp__name { font-size: 28px; }
    .dp__chip--sm .dp__name { font-size: 17px; }
    .dp__in, .dp__meta { font-size: 13.5px; }
  }

  .dp__foot { display: grid; gap: var(--space-5) var(--space-7); margin-top: clamp(48px, 5vw, 72px); align-items: end; }
  .dp .dp__link { color: var(--paper); border-bottom-color: rgb(247 244 238 / 0.4); justify-self: start; }
  .dp .dp__link:hover { border-bottom-color: var(--paper); }
  /* оговорка о цветопередаче — общий компонент, на туши перекрашена светлым */
  .dp__foot :global(.note) { margin: 0; border-top-color: rgb(247 244 238 / 0.18); color: rgb(247 244 238 / 0.66); }
  .dp__foot :global(.note .label) { color: rgb(247 244 238 / 0.85); }
  @media (min-width: 1000px) {
    .dp__foot { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(40px, 5vw, 80px); }
    .dp .dp__link { justify-self: start; }
  }

  /* ── кладочные: тип кирпича — строка через линии ──────────────────────────── */
  .bt3 { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .bt3__row { display: grid; gap: var(--space-5); padding: var(--space-6) 0 var(--space-7); border-bottom: 1px solid var(--hair); }
  .bt3__head { display: grid; grid-template-columns: auto minmax(0, 1fr); align-content: start; gap: var(--space-2) var(--space-3); }
  .bt3__num { padding-top: 0.5em; font-size: 12px; color: var(--color-muted); }
  .bt3__title { margin: 0; font-size: clamp(26px, 2.4vw, 34px); line-height: 1.05; letter-spacing: -0.01em; }
  .bt3__abs { grid-column: 2; display: flex; flex-direction: column; gap: 4px; margin: var(--space-3) 0 0; }
  .bt3__range { font-family: var(--font-head); font-size: clamp(44px, 4.6vw, 72px); line-height: 0.9; letter-spacing: -0.03em; }

  .ps { display: grid; margin: 0; padding: 0; list-style: none; }
  .ps__item { display: grid; grid-template-columns: minmax(76px, 104px) minmax(0, 1fr); gap: var(--space-4) clamp(16px, 2vw, 24px); align-items: start; padding: var(--space-5) 0; }
  .ps > .ps__item + .ps__item { border-top: 1px solid var(--hair); }
  .ps__sw { min-width: 0; }
  .ps__sw :global(.chips) { grid-template-columns: minmax(0, 1fr); }
  .ps__body { display: flex; flex-direction: column; min-width: 0; height: 100%; }
  .ps__name { margin: 0 0 var(--space-3); font-size: clamp(26px, 2.2vw, 32px); line-height: 1; letter-spacing: -0.01em; }
  .ps__label { margin: 0 0 6px; }
  .ps__quote { max-width: 48ch; margin: 0; font-family: var(--font-head); font-style: italic; font-size: clamp(19px, 1.5vw, 22px); line-height: 1.28; color: var(--ink); overflow-wrap: break-word; }
  .ps__src { margin: var(--space-2) 0 0; font-size: 12.5px; color: var(--color-muted); }
  .ps__src a { color: inherit; text-decoration: underline; text-decoration-color: var(--hair-strong); }
  .ps__src a:hover { color: var(--ink); text-decoration-color: currentColor; }
  .ps__meta { margin: var(--space-3) 0 0; font-size: var(--fs-small); color: var(--color-text-soft); }
  .ps__foot { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: auto; padding-top: var(--space-5); }
  .ps__all { font-size: var(--fs-small); }

  @media (min-width: 1000px) {
    .bt3__row { grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); column-gap: clamp(32px, 4vw, 64px); }
    /* подпись типа кирпича держится у своих смесей, пока строка прокручивается */
    .bt3__head { position: sticky; top: 112px; align-self: start; }
    .ps > .ps__item:first-child { padding-top: 0; }
    .ps > .ps__item:last-child { padding-bottom: 0; }
  }
  @media (max-width: 599px) {
