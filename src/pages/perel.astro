---
// Perel — страница бренда (план, волна 1; редизайн 11.10 в языке «палитры шва»).
// Угол: выбор серии Perel по кирпичу и полная справка по каждой серии: SL, VL, NL (кладочные)
// и затирка RL. Каталог ведёт сюда якорями #perel-sl, #perel-vl, #perel-nl, #perel-rl
// («Характеристики →») — id секций менять нельзя.
//
// Вёрстка редакционная: без карточек-коробок, разделение тонкими линиями, крупная антиква.
// Цвет на странице дают только образцы раствора (.mortar, .strip). Кирпича на странице нет —
// шов на кирпиче показывает инструмент /podbor-shva/, сюда ведёт ссылка.
//
// ФАКТЫ — только из данных: src/data/series-facts.ts (назначение и «для какого кирпича» дословно,
// характеристики, шаги, зимняя модификация, расход, о производителе, инструменты — у каждого
// значения URL источника), src/data/catalog.ts (что держит дилер: цвета, мешок).
// Цен нет намеренно (см. catalog.ts): действие позиции — «Узнать цену».
// Пересчёт «мешков на 1000 кирпичей» — арифметика нормы производителя на мешок дилера, подписан как пересчёт.
import Page from '../layouts/Page.astro';
import PageHead from '../components/smesi/PageHead.astro';
import Section from '../components/layout/Section.astro';
import Container from '../components/layout/Container.astro';
import SwatchGrid from '../components/smesi/SwatchGrid.astro';
import SwatchNote from '../components/smesi/SwatchNote.astro';
import CtaBand from '../components/smesi/CtaBand.astro';
import SpecTable from '../components/content/SpecTable.astro';
import FaqAccordion from '../components/content/FaqAccordion.astro';
import Collapse from '../components/ui/Collapse.astro';
import { SERIES, POSITIONS, PEREL_COLORS, seriesById, type SeriesId, type SeriesRef } from '../data/catalog';
import { SERIES_FACTS, CONSUMPTION, BRAND_FACTS, factsOf, type Fact } from '../data/series-facts';
import { swatchFor } from '../data/swatches';
import { PAGES } from '../data/nav';
import { liveUrl } from '../lib/sites';
import { plural } from '../lib/format';
import { nb as typoNb } from '../lib/typo';
import type { FaqItem, SpecRow } from '../lib/types';

/* ── Данные страницы ──────────────────────────────────────────────────────────── */

const MORTAR_IDS: SeriesId[] = ['perel-sl', 'perel-vl', 'perel-nl'];
const mortar = MORTAR_IDS.map((id) => seriesById(id));
const rl = seriesById('perel-rl');
const perelSeries = SERIES.filter((s) => s.brand === 'perel');
const perelPositions = POSITIONS.filter((p) => seriesById(p.series).brand === 'perel').length;

/** «Perel SL» → «SL» */
const code = (s: SeriesRef) => s.name.replace(/^Perel\s+/, '');
/** значение характеристики по подписи */
const spec = (id: SeriesId, label: string): Fact | undefined => factsOf(id).specs.find((f) => f.label === label);
const val = (id: SeriesId, label: string) => spec(id, label)?.value ?? '';
const num = (n: number) => String(n).replace('.', ',');
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const pad = (n: number) => String(n).padStart(2, '0');
/** Один знак после запятой, как в таблице производителя: 1 → «1,0». */
const kg1 = (n: number) => n.toFixed(1).replace('.', ',');
/** Типографика наших подписей и заголовков: неразрывные пробелы (src/lib/typo.ts) + диапазон «5–12»
 *  не рвётся на тире. Дословные цитаты производителя — только typoNb (меняются лишь пробелы). */
const nb = (t: string) =>
  typoNb(t)
    .replace(/(\d)–(\d)/g, '$1\u2060–\u2060$2')
    // «+20…+40 °C» не рвётся после многоточия, «СП 70.13330.2012» — после «СП»
    .replace(/…(?=[+−-]?\d)/g, '…\u2060')
    .replace(/СП (?=\d)/g, 'СП\u00a0')
    // тире не начинает строку (сквозная проверка дизайна 11.10): пробел перед «—» — неразрывный
    .replace(/ — /g, '\u00a0— ');
/** Адрес сайта производителя без переноса по дефису. */
const DOMAIN = 'td-\u2060perel.ru';

/** Подпись ссылки на источник — по адресу. */
function srcLabel(url: string): string {
  const u = new URL(url);
  if (u.hostname.includes('youtube')) return 'видео Perel на YouTube';
  if (u.pathname.endsWith('.pdf')) {
    if (u.pathname.includes('sertifikat')) return 'сертификат, PDF';
    const page = u.hash.match(/page=(\d+)/)?.[1];
    return `каталог Perel, PDF${page ? `, стр. ${page}` : ''}`;
  }
  const parts = u.pathname.split('/').filter(Boolean);
  if (parts[0] === 'catalog' && parts.length >= 3) return `карточка смеси на ${DOMAIN}`;
  if (parts[0] === 'catalog' && parts[1] === 'tsvetnaya-kladochnaya-smes') return `раздел «Цветная кладочная смесь» на ${DOMAIN}`;
  if (parts[0] === 'catalog') return `страница серии на ${DOMAIN}`;
  return DOMAIN;
}

/** Список источников без повторов: [{ href, label }]. */
function sources(urls: string[]) {
  const seen = new Set<string>();
  return urls.filter((u) => (seen.has(u) ? false : (seen.add(u), true))).map((href) => ({ href, label: srcLabel(href) }));
}

/** Характеристики серии для таблицы: характеристики + упаковка и хранение.
 *  Строку «Мешок» производителя не выводим — фасовку дилера показываем отдельно. */
function specRows(id: SeriesId): SpecRow[] {
  const f = factsOf(id);
  // пробел перед «—» неразрывный, чтобы строка значения не начиналась с тире (текст тот же)
  return [...f.specs, ...f.packaging.filter((p) => p.label !== 'Мешок')].map((x) => ({ label: x.label, value: x.value.replace(/ — /g, ' — ') }));
}
function specSources(id: SeriesId) {
  const f = factsOf(id);
  return sources([...f.specs, ...f.packaging.filter((p) => p.label !== 'Мешок')].map((x) => x.src));
}

/* О производителе: подпись строки — по содержанию факта. */
const aboutLabel = (t: string) =>
  t.includes('Щёлково') ? 'Производство'
  : t.includes('линии') ? 'Завод'
  : t.includes('Bayferrox') ? 'Пигменты'
  : t.includes('дилер') ? 'Как продают'
  : t.includes('ертификат') ? 'Сертификат'
  : t.includes('Текато') ? 'Группа компаний'
  : 'О производителе';

/* Общие для SL, VL, NL шаги и оговорки (текст одинаков на карточках трёх серий). */
const sl = SERIES_FACTS['perel-sl'];
const steps = sl.steps;
const stepSources = MORTAR_IDS.map((id) => ({ s: seriesById(id), href: factsOf(id).steps[0]?.src ?? '' }));
const winter = sl.winter;
const winterHowTo = sl.notes?.find((n) => n.text.startsWith('Для модификации «зима»'));
const colorTip = sl.notes?.find((n) => n.text.startsWith('Восприятие цвета шва'));
const overlap = sl.notes?.find((n) => n.text.includes('перекрываются'));
const choiceRule = sl.notes?.find((n) => n.text.startsWith('Главное условие подбора'));

/* Затирка RL. */
const rlF = SERIES_FACTS['perel-rl'];
const rlWidth = val('perel-rl', 'Ширина шва');
const rlGroutVsMortar = rlF.notes?.find((n) => n.text.includes('нельзя заменять'));
const rlAbout = rlF.notes?.find((n) => n.text.startsWith('Затирки Perel'));
const rlCons = CONSUMPTION.perelRl;
/** «Расход смеси 2–6 кг/м² в зависимости от …» → «в зависимости от …» */
const rlConsNote = rlCons.basis.replace(/^Расход смеси [\d,–\s]+кг\/м²\s*/, '');

/* Расход на кирпич. */
const cons = CONSUMPTION.perel;
const PACK = mortar[0].packKg; // у дилера SL, VL и NL — один мешок
const bags = (kg: number) => Math.round((kg * 1000) / PACK);
const nf1 = cons.perBrick[0];

/* Инструменты производителя: заголовок — до первого двоеточия. */
const tools = BRAND_FACTS.perel.tools.map((t) => {
  const i = t.text.indexOf(': ');
  const host = new URL(t.src).hostname;
  const kind = host.includes('youtube') ? 'Видео' : t.src.includes('.pdf') ? 'PDF' : 'На сайте Perel';
  const cta = host.includes('youtube') ? 'Смотреть на YouTube' : t.src.includes('.pdf') ? 'Открыть каталог' : `Открыть на ${DOMAIN}`;
  return i > 0
    ? { kind, title: nb(t.text.slice(0, i)), body: nb(cap(t.text.slice(i + 2))), href: t.src, cta }
    : { kind, title: nb(t.text.replace(/\.$/, '')), body: '', href: t.src, cta };
});

/* Вопросы — ответы только из данных. */
const ext = (href: string, text: string) => `<a href="${href}" rel="nofollow noopener" target="_blank">${text}</a>`;
const storage = sl.packaging.find((p) => p.label === 'Срок хранения');
const water = spec('perel-sl', 'Вода затворения');
const rlWater = spec('perel-rl', 'Вода затворения');
/** «0,14–0,17 л на 1 кг …» → литров на мешок дилера */
const waterPerKg = water?.value.match(/^(\d+,\d+)–(\d+,\d+) л на 1 кг/);
const rlWaterPerKg = rlWater?.value.match(/^(\d+,\d+)–(\d+,\d+) л на 1 кг/);
const litres = (x: string, kg = PACK) => num(+(parseFloat(x.replace(',', '.')) * kg).toFixed(2));
/** «Модификация «зима»: артикул …» → «Артикул …» — подпись блока уже называет модификацию. */
const winterBody = (t: string) => cap(t.replace(/^Модификация «зима»:\s*/, ''));
const noAdditives = steps.find((s) => s.text.startsWith('Никаких посторонних'));
const revive = steps.find((s) => s.text.startsWith('Раствор, потерявший'));

const faq: FaqItem[] = [
  {
    q: 'Чем отличаются серии Perel SL, VL и NL?',
    a: `Главное — водопоглощение кирпича, под который рассчитана смесь: SL — ${val('perel-sl', 'Водопоглощение кирпича')}, VL — ${val('perel-vl', 'Водопоглощение кирпича')}, NL — ${val('perel-nl', 'Водопоглощение кирпича')}. Производитель относит SL к керамическому кирпичу, VL — к кирпичу ручной формовки, NL — к клинкерному. Прочность на сжатие у SL — ${val('perel-sl', 'Прочность на сжатие')}, у VL и NL — ${val('perel-vl', 'Прочность на сжатие')}.`,
  },
  ...(rlGroutVsMortar
    ? [{
        q: 'Можно ли заполнить швы кладочной смесью вместо затирки RL?',
        a: `Нет: по словам производителя, цветную декоративную затирку нельзя заменять цветным кладочным раствором — об этом у Perel есть ${ext(rlGroutVsMortar.src, 'отдельное видео')} на YouTube. Затирка RL рассчитана на швы шириной ${rlWidth}.`,
      }]
    : []),
  {
    q: 'Сколько смеси Perel уходит на один кирпич?',
    a: `По таблице производителя на кирпич формата ${nf1.format} (${nf1.size} мм) — ${kg1(nf1.kgMin)}–${kg1(nf1.kgMax)} кг сухой смеси, на ${cons.perBrick[1].format} — ${kg1(cons.perBrick[1].kgMin)}–${kg1(cons.perBrick[1].kgMax)} кг. Норма одна для SL, VL и NL; толщина шва в таблице не указана. Остальные форматы — <a href="#rashod">в таблице расхода</a> на этой странице.`,
  },
  ...(winter
    ? [{
        q: 'Можно ли класть смесью Perel зимой?',
        a: `Для работы в холод у производителя есть модификация «зима»: ${winter.text.replace(/^Модификация «зима»:\s*/, '')} Есть ли зимняя смесь в наличии — уточняйте у менеджера.`,
      }]
    : []),
  ...(water && waterPerKg
    ? [{
        q: 'Сколько воды нужно на мешок?',
        a: `Для SL, VL и NL норма производителя — ${water.value}; на наш мешок ${PACK} кг это ${litres(waterPerKg[1])}–${litres(waterPerKg[2])} л.${rlWater && rlWaterPerKg ? ` Для затирки RL — ${rlWater.value.replace(/\s*\(.*\)$/, '')}, на мешок ${rl.packKg} кг — ${litres(rlWaterPerKg[1], rl.packKg)}–${litres(rlWaterPerKg[2], rl.packKg)} л.` : ''}${noAdditives ? ` ${noAdditives.text}` : ''}${revive ? ` ${revive.text}` : ''}`,
      }]
    : []),
  ...(storage
    ? [{ q: 'Сколько хранится смесь Perel?', a: `${cap(storage.value)}.` }]
    : []),
];

const itemList = {
  '@type': 'ItemList',
  name: 'Цветные смеси Perel',
  numberOfItems: perelSeries.length,
  itemListElement: perelSeries.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.name,
    url: `${liveUrl('smesi', 'perel')}#${s.id}`,
  })),
};

/* Фон разделов серий: SL и NL — на второй бумаге, VL — на основной (разделы читаются по очереди). */
const bgOf = (i: number) => (i % 2 === 0 ? 'alt' : 'base') as 'base' | 'alt';
---

<Page
  title="Цветные кладочные смеси Perel SL, VL, NL и затирка RL в Москве"
  description="Perel SL, VL и NL — цветные кладочные смеси для керамического, клинкерного кирпича и кирпича ручной формовки; затирка RL. Характеристики, цвета, расход."
  slug="perel"
  current="perel"
  source="perel"
  jsonLd={[itemList]}
>
  <PageHead
    kicker="Производитель Perel"
    h1="Цветные кладочные смеси Perel"
    crumb="Perel"
    trail={[{ label: 'Каталог', href: PAGES.katalog.href }]}
    lead={`Серию Perel выбирают по водопоглощению кирпича: SL — для керамического кирпича, VL — для кирпича ручной формовки, NL — для клинкерного. Каждая серия у нас в ${PEREL_COLORS.length} цветах шва, мешок ${PACK} кг; для расшивки готовых швов — затирка RL в ${rl.colors.length} цветах.`}
  >
    <div class="pr-actions" data-reveal>
      <a class="btn btn--primary" href="#vybor-serii">Выбрать серию</a>
      <a class="arrow-link" href={`${PAGES.katalog.href}?brend=perel`}>Все {perelPositions} {plural(perelPositions, 'позиция', 'позиции', 'позиций')} в каталоге <span aria-hidden="true">→</span></a>
    </div>

    <div class="pk" slot="aside">
      <div class="pk__strip strip" aria-hidden="true">
        {PEREL_COLORS.map((c) => <span class="mortar" style={`--c:${swatchFor('perel-sl', c.code)}`}></span>)}
      </div>
      <p class="pk__note">Полоса — {PEREL_COLORS.length} цветов шва SL, VL и NL; цвет на экране приблизительный.</p>
      <p class="pk__title label">Серии Perel</p>
      <ul class="pk__list">
        {mortar.map((s) => (
          <li>
            <a class="pk__row" href={`#${s.id}`}>
              <b class="pk__code">{code(s)}</b>
              <span class="pk__what">{s.short}<small>водопоглощение {nb(val(s.id, 'Водопоглощение кирпича'))}</small></span>
              <span class="pk__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
        <li>
          <a class="pk__row" href={`#${rl.id}`}>
            <b class="pk__code">{code(rl)}</b>
            <span class="pk__what">{rl.short}<small>швы шириной {nb(rlWidth)}</small></span>
            <span class="pk__arrow" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </div>
  </PageHead>

  <!-- ── Выбор серии: таблица через линии ── -->
  <Section
    id="vybor-serii"
    kicker="Выбор серии"
    title="Какую серию Perel выбрать"
    subtitle={choiceRule ? nb(`${choiceRule.text} В таблице — ещё прочность и морозостойкость.`) : undefined}
    bg="base"
  >
    <div class="cmp-wrap" data-reveal>
      <table class="cmp">
        <thead>
          <tr>
            <th scope="col">Серия</th>
            <th scope="col">Для какого кирпича</th>
            <th scope="col">Прочность на сжатие</th>
            <th scope="col">Морозостойкость</th>
            <th scope="col">Мешок у нас</th>
          </tr>
        </thead>
        <tbody>
          {mortar.map((s) => (
            <tr>
              <th scope="row" class="cmp__series">
                <a href={`#${s.id}`}><span class="cmp__brand">Perel</span> {code(s)}</a>
                <span class="cmp__colors">{s.colors.length} цветов</span>
              </th>
              <td data-label="Для какого кирпича">«{typoNb(factsOf(s.id).forBrick)}»</td>
              <td data-label="Прочность на сжатие" class="num">{nb(val(s.id, 'Прочность на сжатие'))}</td>
              <td data-label="Морозостойкость" class="num">{nb(val(s.id, 'Морозостойкость'))}</td>
              <td data-label="Мешок у нас" class="cmp__pack num">{s.packKg}&nbsp;кг</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="cmp-foot">
      {overlap && <p class="cmp-foot__hint" data-reveal>{nb(overlap.text)}</p>}
      <p class="src">
        По данным производителя:{' '}
        <a href={SERIES_FACTS['perel-sl'].forBrickSrc} rel="nofollow noopener" target="_blank">{srcLabel(SERIES_FACTS['perel-sl'].forBrickSrc)}</a>;
        характеристики&nbsp;— карточки{' '}
        {mortar.map((s, i) => (
          <Fragment>
            <a href={spec(s.id, 'Прочность на сжатие')?.src} rel="nofollow noopener" target="_blank">{code(s)}</a>{i < mortar.length - 1 ? ', ' : ''}
          </Fragment>
        ))}{' '}
        на {DOMAIN}.
      </p>
    </div>
  </Section>

  <!-- ── Серии SL, VL, NL: крупное название, назначение курсивом, образцы и характеристики ── -->
  {mortar.map((s, i) => {
    const f = factsOf(s.id);
    const srcs = specSources(s.id);
    const bg = bgOf(i);
    return (
      <section class:list={['ps', `ps--${bg}`]} id={s.id}>
        <Container>
          <header class="ps__head">
            <div class="ps__name" data-reveal="head">
              <p class="ps__idx label"><span class="num">{pad(i + 1)}</span> — кладочная смесь</p>
              <h2 class="ps__title">
                <span class="ps__brand">Perel</span>{' '}
                <span class="ps__code">{code(s)}</span>{' '}
                <span class="ps__short">{nb(s.short)}</span>
              </h2>
            </div>
            <figure class="ps__purpose" data-reveal>
              <blockquote class="ps__quote"><p>«{typoNb(f.purpose)}»</p></blockquote>
              <figcaption class="ps__cap">
                Назначение — по данным производителя,{' '}
                <a href={f.purposeSrc} rel="nofollow noopener" target="_blank">{srcLabel(f.purposeSrc)}</a>
              </figcaption>
            </figure>
          </header>

          <dl class="ps__facts" data-reveal>
            <div><dt>Водопоглощение кирпича</dt><dd class="num">{nb(val(s.id, 'Водопоглощение кирпича'))}</dd></div>
            <div><dt>Цветов у нас</dt><dd class="num">{s.colors.length}</dd></div>
            <div><dt>Мешок у нас</dt><dd class="num">{s.packKg}&nbsp;кг</dd></div>
          </dl>

          <div class="ps__colors" style={`--cols:${Math.ceil(s.colors.length / 2)}`}>
            <div class="ps__colors-head">
              <h3 class="ps__sub">Цвета шва — <span class="num">{s.colors.length}</span></h3>
              <p class="ps__hint">Нажмите на цвет — назовём цену и наличие.</p>
            </div>
            <SwatchGrid series={s.id} size="sm" />
            <div class="ps__colors-foot">
              <div class="ps__actions">
                <button class="btn btn--primary" type="button" data-ask={`${s.name} — цвет подберём`}>Узнать цену</button>
                <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
              </div>
              <SwatchNote />
            </div>
          </div>

          <div class="ps__specs">
            <h3 class="ps__sub ps__specs-title">Характеристики</h3>
            <div class="ps__specs-table" data-reveal>
              <Collapse max={440} fade={bg} label="Все характеристики">
                <SpecTable rows={specRows(s.id)} />
              </Collapse>
            </div>
            <p class="src ps__specs-src">
              По данным производителя:{' '}
              {srcs.map((x, j) => (
                <Fragment>
                  <a href={x.href} rel="nofollow noopener" target="_blank">{x.label}</a>{j < srcs.length - 1 ? ', ' : '.'}
                </Fragment>
              ))}
            </p>
          </div>
        </Container>
      </section>
    );
  })}

  <!-- ── Применение SL, VL, NL: тёмная полоса, шаги нумерованным списком через линии ── -->
  <section class="howto" id="primenenie">
    <Container>
      <header class="howto__head" data-reveal>
        <p class="howto__kicker">Применение</p>
        <h2 class="howto__title">{nb('Как работать со смесью SL, VL и NL')}</h2>
        <p class="howto__sub">Порядок у трёх серий один — так его описывает производитель.</p>
      </header>
      <div class="howto__grid">
        <div>
          <ol class="steps steps--dark" data-reveal-stagger>
            {steps.map((st, i) => (
              <li><span class="steps__n num">{pad(i + 1)}</span><p class="steps__t">{nb(st.text)}</p></li>
            ))}
          </ol>
          <p class="src src--dark">
            По данным производителя: описание на карточках{' '}
            {stepSources.map((x, i) => (
              <Fragment>
                <a href={x.href} rel="nofollow noopener" target="_blank">{code(x.s)}</a>{i < stepSources.length - 1 ? ', ' : ''}
              </Fragment>
            ))}{' '}
            на {DOMAIN}.
          </p>
        </div>
        <aside class="howto__side">
          {winter && (
            <div class="wnt wnt--dark" data-reveal>
              <p class="wnt__label">Модификация «зима»</p>
              <p>{nb(winterBody(winter.text))}</p>
              {winterHowTo && <p>{nb(winterHowTo.text)}</p>}
              <p class="wnt__stock">Есть ли зимняя смесь в наличии — уточняйте у менеджера.</p>
              <p class="wnt__src">
                По данным производителя:{' '}
                <a href={winter.src} rel="nofollow noopener" target="_blank">{srcLabel(winter.src)}</a>{winterHowTo && (
                  <Fragment>, <a href={winterHowTo.src} rel="nofollow noopener" target="_blank">{srcLabel(winterHowTo.src)}</a></Fragment>
                )}
              </p>
            </div>
          )}
          {colorTip && (
            <div class="tip tip--dark" data-reveal>
              <p>{nb(colorTip.text.replace(/\s*—\s*этому у производителя есть отдельное видео\.?$/, '.'))}</p>
              <a class="arrow-link" href={colorTip.src} rel="nofollow noopener" target="_blank">Видео производителя о расшивке <span aria-hidden="true">↗</span></a>
            </div>
          )}
        </aside>
      </div>
    </Container>
  </section>

  <!-- ── Расход: таблица через линии и пересчёт в мешки ── -->
  <Section
    id="rashod"
    kicker="Расход"
    title="Сколько смеси уходит на кирпич"
    subtitle="Норма производителя — на один кирпич, по формату. Она одна для SL, VL и NL."
    bg="base"
  >
    <div class="cons">
      <div class="cons__table" data-reveal>
        <div class="ctab-wrap">
          <table class="ctab">
            <thead>
              <tr>
                <th scope="col">Формат</th>
                <th scope="col">Размер, мм</th>
                <th scope="col">Смеси на 1 кирпич, кг</th>
                <th scope="col">Мешков по {PACK} кг на 1000 шт.<span class="ctab__note">пересчёт нормы</span></th>
              </tr>
            </thead>
            <tbody>
              {cons.perBrick.map((r) => (
                <tr>
                  <th scope="row">{r.format}</th>
                  <td class="num">{r.size}</td>
                  <td class="num ctab__kg">{kg1(r.kgMin)}–{kg1(r.kgMax)}</td>
                  <td class="num">{bags(r.kgMin)}–{bags(r.kgMax)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="src">
          По данным производителя:{' '}
          <a href={cons.src} rel="nofollow noopener" target="_blank">{srcLabel(cons.src)}</a>. Толщина шва в таблице не указана.
        </p>
      </div>
      <div class="cons__side" data-reveal>
        <p class="label">Кирпич {nf1.format}, {nf1.size}&nbsp;мм</p>
        <p class="cons__big num">{bags(nf1.kgMin)}–{bags(nf1.kgMax)}<span> {plural(bags(nf1.kgMax), 'мешок', 'мешка', 'мешков')}</span></p>
        <p class="cons__cap">
          на 1000 кирпичей — пересчёт нормы производителя ({kg1(nf1.kgMin)}–{kg1(nf1.kgMax)}&nbsp;кг сухой смеси на кирпич) на наш мешок {PACK}&nbsp;кг.
        </p>
        <div class="cons__calc">
          <h3 class="cons__calc-title">{nb('Сколько мешков на вашу кладку?')}</h3>
          <p>Посчитайте на калькуляторе расхода или назовите менеджеру формат и количество кирпича.</p>
          <a class="btn btn--primary" href={PAGES.kalkulyator.href}>Открыть калькулятор</a>
        </div>
      </div>
    </div>
  </Section>

  <!-- ── Затирка RL ── -->
  <section class="ps ps--alt" id={rl.id}>
    <Container>
      <header class="ps__head">
        <div class="ps__name">
          <div data-reveal="head">
            <p class="ps__idx label"><span class="num">04</span> — для расшивки швов</p>
            <h2 class="ps__title">
              <span class="ps__brand">Perel</span>{' '}
              <span class="ps__code">{code(rl)}</span>{' '}
              <span class="ps__short">{nb(rl.short)}</span>
            </h2>
          </div>
          <figure class="ps__for" data-reveal>
            <figcaption class="label">Для каких швов</figcaption>
            <blockquote><p>«{typoNb(rlF.forBrick)}»</p></blockquote>
            <a class="ps__cap ps__cap-link" href={rlF.forBrickSrc} rel="nofollow noopener" target="_blank">{srcLabel(rlF.forBrickSrc)} <span aria-hidden="true">↗</span></a>
          </figure>
        </div>
        <figure class="ps__purpose" data-reveal>
          <blockquote class="ps__quote"><p>«{typoNb(rlF.purpose)}»</p></blockquote>
          <figcaption class="ps__cap">
            Назначение — по данным производителя,{' '}
            <a href={rlF.purposeSrc} rel="nofollow noopener" target="_blank">{srcLabel(rlF.purposeSrc)}</a>
          </figcaption>
        </figure>
      </header>

      <dl class="ps__facts ps__facts--4" data-reveal>
        <div><dt>Ширина шва</dt><dd class="num">{nb(rlWidth)}</dd></div>
        <div><dt>Расход на 1 м²</dt><dd class="num">{num(rlCons.kgPerM2Min)}–{num(rlCons.kgPerM2Max)}&nbsp;<small>кг/м²</small></dd></div>
        <div><dt>Цветов у нас</dt><dd class="num">{rl.colors.length}</dd></div>
        <div><dt>Мешок у нас</dt><dd class="num">{rl.packKg}&nbsp;кг</dd></div>
      </dl>
      <p class="ps__factnote">
        Расход — {nb(rlConsNote)} По данным производителя:{' '}
        <a href={rlCons.src} rel="nofollow noopener" target="_blank">{srcLabel(rlCons.src)}</a>.
      </p>

      <div class="ps__colors" style={`--cols:${Math.ceil(rl.colors.length / 2)}`}>
        <div class="ps__colors-head">
          <h3 class="ps__sub">Цвета затирки — <span class="num">{rl.colors.length}</span></h3>
          <p class="ps__hint">Нажмите на цвет — назовём цену и наличие.</p>
        </div>
        <SwatchGrid series={rl.id} size="sm" />
        <div class="ps__colors-foot">
          <div class="ps__actions">
            <button class="btn btn--primary" type="button" data-ask={`${rl.name} — цвет подберём`}>Узнать цену</button>
            <a class="arrow-link" href={PAGES.podbor.href}>Посмотреть шов на кирпиче <span aria-hidden="true">→</span></a>
          </div>
          <SwatchNote />
        </div>
      </div>

      <div class="ps__specs">
        <h3 class="ps__sub ps__specs-title">Характеристики</h3>
        <div class="ps__specs-table" data-reveal>
          <Collapse max={440} fade="alt" label="Все характеристики">
            <SpecTable rows={specRows(rl.id)} />
          </Collapse>
        </div>
        <p class="src ps__specs-src">
          По данным производителя:{' '}
          {specSources(rl.id).map((x, j, arr) => (
            <Fragment>
              <a href={x.href} rel="nofollow noopener" target="_blank">{x.label}</a>{j < arr.length - 1 ? ', ' : '.'}
            </Fragment>
          ))}
        </p>
      </div>

      <div class="rl-how">
        <div>
          <h3 class="ps__sub">Как работать с затиркой</h3>
          <ol class="steps" data-reveal-stagger>
            {rlF.steps.map((st, i) => (
              <li><span class="steps__n num">{pad(i + 1)}</span><p class="steps__t">{nb(st.text)}</p></li>
            ))}
          </ol>
          <p class="src">
            По данным производителя:{' '}
            {sources(rlF.steps.map((x) => x.src)).map((x, j, arr) => (
              <Fragment>
                <a href={x.href} rel="nofollow noopener" target="_blank">{x.label}</a>{j < arr.length - 1 ? ', ' : '.'}
              </Fragment>
            ))}
          </p>
        </div>
        <aside class="rl-how__side">
          {rlF.winter && (
            <div class="wnt" data-reveal>
              <p class="wnt__label">Модификация «зима» у RL</p>
              <p>{nb(winterBody(rlF.winter.text))}</p>
              <p class="wnt__stock">Есть ли зимняя затирка в наличии — уточняйте у менеджера.</p>
              <p class="wnt__src">
                По данным производителя:{' '}
                <a href={rlF.winter.src} rel="nofollow noopener" target="_blank">{srcLabel(rlF.winter.src)}</a>
              </p>
            </div>
          )}
          {rlGroutVsMortar && (
            <div class="tip" data-reveal>
              <p>{nb(rlGroutVsMortar.text.replace(/\s*—\s*этому у производителя есть отдельное видео\.?$/, '.'))}</p>
              <a class="arrow-link" href={rlGroutVsMortar.src} rel="nofollow noopener" target="_blank">Видео производителя <span aria-hidden="true">↗</span></a>
            </div>
          )}
          {rlAbout && (
            <div class="tip" data-reveal>
              <p>{nb(rlAbout.text)}</p>
              <a class="arrow-link" href={rlAbout.src} rel="nofollow noopener" target="_blank">{DOMAIN} <span aria-hidden="true">↗</span></a>
            </div>
          )}
        </aside>
      </div>
    </Container>
  </section>

  <!-- ── О производителе: список через линии ── -->
  <Section id="proizvoditel" kicker="Производитель" title="Кто делает смеси Perel" bg="base">
    <ol class="about" data-reveal-stagger>
      {BRAND_FACTS.perel.about.map((f, i) => (
        <li class="about__row">
          <p class="about__label"><span class="num">{pad(i + 1)}</span>{aboutLabel(f.text)}</p>
          <p class="about__text">{nb(f.text)}</p>
          <a class="about__src" href={f.src} rel="nofollow noopener" target="_blank">{srcLabel(f.src)} <span aria-hidden="true">↗</span></a>
        </li>
      ))}
    </ol>
  </Section>

  <!-- ── Инструменты производителя: список ссылок через линии ── -->
  <Section id="instrumenty" kicker="Полезное у производителя" title="Инструменты Perel" bg="alt">
    <ul class="tools" data-reveal-stagger>
      {tools.map((t) => (
        <li>
          <a class="tool" href={t.href} rel="nofollow noopener" target="_blank">
            <span class="tool__kind label">{t.kind}</span>
            <span class="tool__main">
              <span class="tool__title">{t.title}</span>
              {t.body && <span class="tool__body">{t.body}</span>}
            </span>
            <span class="tool__cta">{t.cta} <span class="tool__arrow" aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="voprosy" kicker="Вопросы" title="Частые вопросы о Perel" bg="base">
    <div data-reveal>
      <FaqAccordion items={faq} site="smesi" slug="perel" />
    </div>
  </Section>

  <CtaBand
    source="perel"
    title={nb('Подберём серию Perel под ваш кирпич')}
    text={nb('Назовите кирпич и цвет шва — подскажем серию SL, VL или NL, проверим наличие и посчитаем количество мешков.')}
  />
</Page>

<style>
  /* ── Первый экран ── */
  .pr-actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5) var(--space-6); margin-top: var(--space-7); }

  .pk__strip { height: clamp(80px, 9vw, 132px); }
  .pk__note { margin: var(--space-3) 0 0; font-size: var(--fs-tiny); color: var(--color-muted); }
  .pk__title { margin: var(--space-6) 0 var(--space-2); }
  .pk__list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .pk__list li { border-bottom: 1px solid var(--hair); }
  .pk__row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-4);
    padding: 14px 0;
    color: var(--ink);
    text-decoration: none;
  }
  .pk__code { font-family: var(--font-head); font-weight: 500; font-size: clamp(30px, 2.6vw, 38px); line-height: 1; letter-spacing: -0.01em; }
  .pk__what { display: flex; flex-direction: column; gap: 2px; line-height: 1.3; }
  .pk__what small { font-size: var(--fs-small); color: var(--color-muted); }
  .pk__arrow { font-size: 20px; transition: translate 0.4s var(--ease); }
  .pk__row:hover .pk__code { font-style: italic; }
  .pk__row:hover .pk__arrow { translate: 6px 0; }

  /* ── Источники ── */
  .src { max-width: 72ch; margin: var(--space-5) 0 0; font-size: var(--fs-small); color: var(--color-muted); }
  .src a { color: var(--color-text-soft); }

  /* ── Сравнение серий: таблица через линии ── */
  .cmp { width: 100%; border-collapse: collapse; border-top: 1px solid var(--hair-strong); }
  .cmp th, .cmp td { padding: 22px 20px 22px 0; text-align: left; vertical-align: top; border-bottom: 1px solid var(--hair); }
  .cmp th:last-child, .cmp td:last-child { padding-right: 0; }
  .cmp thead th {
    padding-top: 14px;
    padding-bottom: 14px;
    font-size: var(--fs-tiny);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    vertical-align: bottom;
  }
  .cmp__series a {
    font-family: var(--font-head);
    font-weight: 500;
    font-size: clamp(30px, 2.8vw, 44px);
    line-height: 1;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .cmp__brand { font-style: italic; font-size: 0.6em; color: var(--color-text-soft); }
  .cmp__series a:hover { font-style: italic; }
  .cmp__colors { display: block; margin-top: var(--space-2); font-size: var(--fs-small); font-weight: 400; color: var(--color-muted); }
  .cmp td { color: var(--color-text-soft); }
  .cmp__pack { color: var(--ink); white-space: nowrap; }
  .cmp thead th:last-child { white-space: nowrap; }
  @media (min-width: 860px) {
    .cmp th[scope='row'] { width: 18%; }
    .cmp td:nth-child(2) { width: 36%; }
    .cmp td:nth-child(4) { width: 22%; }
  }
  @media (max-width: 859px) {
    .cmp thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .cmp, .cmp tbody, .cmp tr, .cmp th, .cmp td { display: block; }
    .cmp tr { padding: var(--space-5) 0; border-bottom: 1px solid var(--hair); }
    .cmp th, .cmp td { padding: var(--space-2) 0; border-bottom: 0; }
    .cmp td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 2px;
      font-size: var(--fs-tiny);
      font-weight: 500;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-muted);
    }
    .cmp th.cmp__series { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-4); }
    .cmp__colors { margin-top: 0; }
  }
  .cmp-foot { display: grid; gap: 0 var(--space-7); }
  .cmp-foot__hint { max-width: 62ch; margin: var(--space-5) 0 0; color: var(--color-text-soft); }
  @media (min-width: 1000px) {
    .cmp-foot { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; }
  }

  /* ── Раздел серии ── */
  .ps { padding-block: clamp(64px, 8.5vw, 136px); background: var(--paper); }
  .ps--alt { background: var(--paper-2); }
  .ps__head { display: grid; gap: var(--space-6) clamp(32px, 5vw, 80px); padding-top: var(--space-4); border-top: 1px solid var(--hair-strong); }
  .ps__idx { margin: 0 0 var(--space-5); }
  .ps__title { margin: 0; font-weight: 500; line-height: 1; }
  .ps__title > span { display: block; }
  .ps__brand { font-style: italic; font-size: clamp(24px, 2.2vw, 32px); color: var(--color-text-soft); }
  .ps__code {
    margin: 0.02em 0 0 -0.04em;
    font-size: clamp(112px, 15vw, 220px);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }
  .ps__short { margin-top: var(--space-4); font-size: clamp(26px, 2.6vw, 38px); line-height: 1.05; letter-spacing: -0.01em; text-wrap: balance; }
  .ps__purpose { margin: 0; }
  .ps__quote { margin: 0; }
  .ps__quote p {
    margin: 0;
    font-family: var(--font-head);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(22px, 1.9vw, 28px);
    line-height: 1.28;
    color: var(--ink);
  }
  .ps__cap { display: block; margin-top: var(--space-3); font-size: var(--fs-small); color: var(--color-muted); }
  .ps__cap a, a.ps__cap-link { color: var(--color-text-soft); }
  .ps__for { margin: var(--space-7) 0 0; max-width: 44ch; padding-top: var(--space-4); border-top: 1px solid var(--hair); }
  .ps__for blockquote { margin: var(--space-2) 0 0; }
  .ps__for blockquote p { margin: 0; font-size: var(--fs-lead); color: var(--ink); }
  @media (min-width: 1000px) {
    .ps__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: start; }
    /* цитата встаёт вровень со строкой «Perel», а не с подписью раздела */
    .ps__purpose { padding-top: calc(var(--fs-tiny) * 1.5 + var(--space-5) + 6px); }
  }

  /* Строка фактов серии: крупные цифры антиквой через тонкие вертикальные линии */
  .ps__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: clamp(40px, 5vw, 72px) 0 0; border-top: 1px solid var(--hair); border-bottom: 1px solid var(--hair); }
  .ps__facts--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .ps__facts > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: var(--space-2); padding: var(--space-5) var(--space-5) var(--space-5) 0; }
  .ps__facts > div + div { padding-left: var(--space-5); border-left: 1px solid var(--hair); }
  .ps__facts dt { font-size: var(--fs-tiny); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); line-height: 1.35; }
  .ps__facts dd { margin: 0; font-family: var(--font-head); font-size: clamp(38px, 4vw, 60px); line-height: 1; letter-spacing: -0.02em; white-space: nowrap; }
  .ps__facts dd small { font-size: 0.45em; letter-spacing: 0; }
  .ps__factnote { max-width: 72ch; margin: var(--space-4) 0 0; font-size: var(--fs-small); color: var(--color-muted); }
  .ps__factnote a { color: var(--color-text-soft); }
  @media (max-width: 899px) {
    .ps__facts--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ps__facts--4 > div:nth-child(3) { padding-left: 0; border-left: 0; }
    .ps__facts--4 > div:nth-child(n + 3) { border-top: 1px solid var(--hair); }
  }
  @media (max-width: 559px) {
    .ps__facts, .ps__facts--4 { grid-template-columns: minmax(0, 1fr); }
    .ps__facts > div, .ps__facts--4 > div {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-4);
      padding: var(--space-3) 0;
      border-left: 0;
    }
    .ps__facts > div + div { padding-left: 0; border-left: 0; border-top: 1px solid var(--hair); }
    .ps__facts dd { font-size: clamp(28px, 8.5vw, 36px); }
  }

  .ps__sub { margin: 0 0 var(--space-4); font-size: var(--fs-h3); line-height: 1.05; letter-spacing: -0.01em; }

  /* Образцы — на всю ширину раздела: палитра серии и есть главный цвет страницы */
  .ps__colors { margin-top: clamp(48px, 6vw, 88px); }
  .ps__colors-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--space-2) var(--space-6); margin-bottom: var(--space-5); }
  .ps__colors-head .ps__sub { margin: 0; }
  .ps__hint { margin: 0; font-size: var(--fs-small); color: var(--color-muted); }
  /* на десктопе ровно в два ряда (Perel 14 → по 7, RL 12 → по 6) */
  @media (min-width: 900px) {
