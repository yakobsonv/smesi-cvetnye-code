---
// Серия (редизайн 11.10): широкая полоса оттенков раствора сверху, название антиквой, тонкие строки
// фактов, две текстовые ссылки. Без рамки и тени — разделители линиями.
import { seriesById, seriesHref, type SeriesId } from '../../data/catalog';
import { swatchFor } from '../../data/swatches';
import { nb } from '../../lib/typo';

interface Props { id: SeriesId; level?: 2 | 3; href?: string }

const { id, level = 3, href } = Astro.props;
const s = seriesById(id);
const Heading = `h${level}` as any;
const link = href ?? seriesHref(s);
// у серий без страницы бренда (Promix, Стройбриг — данных производителя нет) ссылка ведёт на их цвета в каталоге
const linkLabel = s.page || href ? 'Характеристики' : 'Все цвета';
---

<article class="sr">
  <a class="sr__strip strip" href={link} tabindex="-1" aria-hidden="true">
    {s.colors.map((c) => <span class="mortar" style={`--c:${swatchFor(s.id, c.code)}`}></span>)}
  </a>
  <p class="sr__kind label">{s.purpose === 'kladka' ? 'Кладочная смесь' : 'Для расшивки швов'}</p>
  <Heading class="sr__title"><a href={link}>{s.name}</a></Heading>
  <p class="sr__short">{nb(s.short)}</p>
  <dl class="sr__facts">
    {s.absorption && <div><dt>Водопоглощение кирпича</dt><dd class="num">{s.absorption}</dd></div>}
    {/* у Dauer (codeKind 'palette') позиций у дилера нет — число цветов по палитре производителя, а не «у нас» (QA 24.10) */}
    <div><dt>{s.codeKind === 'palette' ? 'Оттенков в палитре' : 'Оттенков у нас'}</dt><dd class="num">{s.colors.length}</dd></div>
    <div><dt>Мешок</dt><dd class="num">{s.packKg} кг</dd></div>
  </dl>
  <div class="sr__actions">
    <a class="arrow-link" href={link}>{linkLabel} <span aria-hidden="true">→</span></a>
    <button class="sr__ask" type="button" data-ask={`${s.name} — цвет подберём`}>Узнать цену</button>
  </div>
</article>

<style>
  .sr { display: flex; flex-direction: column; height: 100%; }
  .sr__strip { height: 92px; margin-bottom: var(--space-5); }
  /* усиление цвета полосы — общее для всех .strip (smesi.css, Паша 24.10) */
  .sr__strip span { transition: flex-grow 0.5s var(--ease); }
  .sr__strip:hover span:hover { flex-grow: 2.4; }
  .sr__kind { margin: 0 0 var(--space-2); }
  .sr__title { margin: 0; font-size: clamp(30px, 2.6vw, 40px); line-height: 1; letter-spacing: -0.015em; }
  .sr__title a { color: inherit; text-decoration: none; }
  .sr__title a:hover { font-style: italic; }
  .sr__short { margin: var(--space-3) 0 var(--space-5); color: var(--color-text-soft); }
  .sr__facts { margin: 0 0 var(--space-5); border-top: 1px solid var(--hair); }
  .sr__facts div { display: flex; justify-content: space-between; gap: var(--space-4); padding: 10px 0; border-bottom: 1px solid var(--hair); font-size: var(--fs-small); }
  .sr__facts dt { color: var(--color-muted); }
  .sr__facts dd { margin: 0; font-weight: 500; text-align: right; }
  .sr__actions { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-5); margin-top: auto; }
  .sr__ask { padding: 0; border: 0; background: none; color: var(--color-muted); font: inherit; font-size: var(--fs-small); text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer; }
  .sr__ask:hover { color: var(--ink); }
</style>
