---
// Выбор смеси по кирпичу (редизайн 11.10): три колонки через тонкие линии, крупный диапазон
// водопоглощения антиквой. Диапазоны — подписями самого дилера (tk-sm.ru); у серий — свои,
// производителя (см. catalog.ts). Ссылка ведёт в каталог с выбранным типом.
import { BRICK_TYPES, seriesFor, type BrickType } from '../../data/catalog';
import { PAGES } from '../../data/nav';

interface Props { class?: string }
const { class: className } = Astro.props;
const order: BrickType[] = ['obychnyj', 'ruchnoj', 'klinker'];
---

<ol class:list={['bt', className]} data-reveal-stagger>
  {order.map((t) => {
    const info = BRICK_TYPES[t];
    return (
      <li class="bt__col">
        <p class="bt__range num">{info.absorption}</p>
        <p class="label">водопоглощение</p>
        <h3 class="bt__label">{info.label}</h3>
        <ul class="bt__series">
          {seriesFor(t).map((s) => <li>{s.name}</li>)}
        </ul>
        <a class="arrow-link" href={`${PAGES.katalog.href}?kirpich=${t}`}>Смотреть оттенки <span aria-hidden="true">→</span></a>
      </li>
    );
  })}
</ol>

<style>
  .bt { display: grid; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--hair-strong); }
  .bt__col { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-6) 0; border-bottom: 1px solid var(--hair); }
  .bt__range { margin: 0; font-family: var(--font-head); font-size: clamp(64px, 7vw, 112px); line-height: 0.9; letter-spacing: -0.03em; }
  .bt__label { margin: var(--space-4) 0 var(--space-2); font-size: clamp(24px, 2vw, 30px); line-height: 1.05; }
  .bt__series { display: grid; gap: 4px; margin: 0 0 var(--space-5); padding: 0; list-style: none; color: var(--color-text-soft); }
  .bt__series li::before { content: '— '; color: var(--color-muted); }
  .bt .arrow-link { margin-top: auto; align-self: flex-start; }
  @media (min-width: 900px) {
    .bt { grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: 1px solid var(--hair); }
    .bt__col { padding: var(--space-6) clamp(20px, 2.5vw, 40px) var(--space-7); border-bottom: 0; }
    .bt__col + .bt__col { border-left: 1px solid var(--hair); }
    .bt__col:first-child { padding-left: 0; }
  }
</style>
