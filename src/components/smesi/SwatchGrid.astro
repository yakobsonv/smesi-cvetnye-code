---
// Образцы цвета серии (редизайн 11.10): плашка раствора с фактурой, под ней название и код.
// Клик — окно «Узнать цену» с этой позицией. Оттенок — приближённый замер по палитре
// производителя (src/data/swatches.ts), поэтому под сеткой всегда оговорка (SwatchNote).
import { POSITIONS, seriesById, type SeriesId, type Tone } from '../../data/catalog';
import { swatchFor } from '../../data/swatches';

interface Props {
  series: SeriesId;
  tones?: Tone[];
  size?: 'md' | 'sm';
  showSeries?: boolean;
  class?: string;
}

const { series, tones, size = 'md', showSeries = false, class: className } = Astro.props;
const s = seriesById(series);
const items = POSITIONS.filter((p) => p.series === series && (!tones || tones.includes(p.color.tone)));
---

<ul class:list={['chips', `chips--${size}`, className]} data-swatch-grid>
  {items.map((p) => (
    <li data-tone={p.color.tone}>
      <button class="chip" type="button" data-ask={p.title} aria-label={`${p.title} — узнать цену`}>
        <span class="chip__swatch mortar" style={`--c:${swatchFor(p.series, p.color.code)}`} aria-hidden="true"></span>
        <span class="chip__name">{p.color.name}</span>
        <span class="chip__code num">{showSeries ? `${s.name} · ` : ''}{p.article}</span>
      </button>
    </li>
  ))}
</ul>

<style>
  .chips { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 28px 14px; margin: 0; padding: 0; list-style: none; }
  .chips--sm { grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 22px 12px; }
  .chip { display: flex; flex-direction: column; width: 100%; padding: 0; border: 0; background: none; color: var(--ink); font: inherit; text-align: left; cursor: pointer; }
  .chip__swatch { display: block; aspect-ratio: 4 / 5; margin-bottom: 10px; transition: translate 0.5s var(--ease); }
  .chip:hover .chip__swatch, .chip:focus-visible .chip__swatch { translate: 0 -6px; }
  .chip:focus-visible { outline: none; }
  .chip:focus-visible .chip__swatch { outline: 2px solid var(--ink); outline-offset: 3px; }
  .chip__name { font-size: 14.5px; font-weight: 500; line-height: 1.2; }
  .chip__code { margin-top: 2px; font-size: 12px; color: var(--color-muted); letter-spacing: 0.04em; }
  @media (max-width: 599px) {
    .chips, .chips--sm { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 10px; }
    .chip__swatch { aspect-ratio: 1; }
    .chip__name { font-size: 13.5px; }
  }
</style>
