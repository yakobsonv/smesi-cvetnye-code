---
// Карусель сочетаний «кирпич + шов» на главной: крупный центральный кадр и два боковых, развёрнутых в перспективе
// (CSS 3D: perspective + rotateY, без библиотек). Кадры — визуализации кладки клиента (src/data/kladka.ts).
// ⚠️ Кирпич вне /podbor-shva/ — по брифу 20.10, решение Влада — ожидается.
//
// Управление: стрелки (44 px), свайп (pointer events, вертикальная прокрутка не блокируется), ←/→ при фокусе
// на карусели. Без автопрокрутки. «Показать в кадре выше» (или клик по центральному кадру) ставит кирпич и шов в секцию
// «Оттенок на кладке» выше — через общее состояние src/lib/seam-state.ts.
import Container from '../layout/Container.astro';
import { KLADKA_UNIQUE } from '../../data/kladka';
import { HOME_BRICKS, brickLabel } from '../../lib/seams';

// Сочетания: у каждого кирпича связки — светлый, тёмный и тёплый шов (без пар «шов почти в цвет кирпича»).
const PAIRS: Array<[brick: string, seam: string]> = [
  ['osmibt-terrakot', 'white'],
  ['osmibt-soloma', 'darkgrey'],
  ['osmibt-korichnevyj', 'cream'],
  ['osmibt-terrakot', 'black'],
  ['osmibt-soloma', 'brown'],
  ['osmibt-korichnevyj', 'superwhite'],
];

const slides = PAIRS.map(([bid, sid]) => {
  if (!HOME_BRICKS.includes(bid)) throw new Error(`Кирпич ${bid} не в связке главной`);
  const b = KLADKA_UNIQUE.find((x) => x.id === bid);
  const s = b?.seams.find((x) => x.id === sid);
  if (!b || !s) throw new Error(`Нет кадра ${bid} × ${sid}`);
  return { brick: b.id, seam: s.id, caption: `${brickLabel(b.brick)} · шов ${s.label}`, src: s.src, srcSm: s.srcSm, w: s.w, h: s.h };
});
const n = slides.length;
---

<section class="sc" aria-labelledby="sc-title">
  <Container>
    <div class="sc__head" data-reveal>
      <p class="sc__kicker">Сочетания</p>
      <h2 class="sc__title" id="sc-title">Кирпич и шов: {n} сочетаний</h2>
      <p class="sc__sub">Листайте и покажите понравившееся в кадре выше — кирпич и шов встанут в него.</p>
    </div>

    <div class="sc__car" role="region" aria-roledescription="карусель" aria-label="Сочетания кирпича и шва" data-sc>
      <div class="sc__view" tabindex="0" role="group" aria-label="Кадры сочетаний, листаются стрелками влево и вправо" data-sc-view>
        {slides.map((s, i) => (
          <div
            class="sc__slide"
            role="group"
            aria-roledescription="слайд"
            aria-label={`${i + 1} из ${n}: ${s.caption}`}
            data-sc-slide={i}
            data-brick={s.brick}
            data-seam={s.seam}
            data-caption={s.caption}
            data-pos={i === 0 ? '0' : i === 1 ? '1' : i === n - 1 ? '-1' : 'far'}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            <img
              src={s.src}
              srcset={`${s.srcSm} 320w, ${s.src} ${s.w}w`}
              sizes="(min-width: 900px) 44vw, 72vw"
              width={s.w}
              height={s.h}
              alt={`Визуализация кладки: ${s.caption}`}
              loading="lazy"
              decoding="async"
              draggable="false"
            />
          </div>
        ))}
      </div>

      <div class="sc__bar">
        <button type="button" class="sc__arrow" data-sc-prev aria-label="Предыдущее сочетание"><span aria-hidden="true">←</span></button>
        <p class="sc__now" aria-live="polite">
          <span class="sc__count num" data-sc-count>1 / {n}</span>
          <span class="sc__cap" data-sc-cap>{slides[0].caption}</span>
        </p>
        <button type="button" class="sc__arrow" data-sc-next aria-label="Следующее сочетание"><span aria-hidden="true">→</span></button>
      </div>
      <div class="sc__foot">
        <button type="button" class="sc__apply btn btn--ghost" data-sc-apply>Показать в кадре выше <span aria-hidden="true">↑</span></button>
        <span class="sc__hint">Визуализация кладки, цвет на экране приблизительный</span>
      </div>
    </div>
  </Container>
</section>

<script>
  import { setSeamState } from '../../lib/seam-state';

  const root = document.querySelector<HTMLElement>('[data-sc]');
  if (root) {
    const view = root.querySelector<HTMLElement>('[data-sc-view]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-sc-slide]')];
    const count = root.querySelector<HTMLElement>('[data-sc-count]')!;
    const cap = root.querySelector<HTMLElement>('[data-sc-cap]')!;
    const n = slides.length;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let active = 0;

    const layout = () => {
      slides.forEach((s, i) => {
        // смещение по кругу: −1 слева, 0 в центре, 1 справа, остальные спрятаны позади
        let d = (i - active + n) % n;
        if (d > n / 2) d -= n;
        s.dataset.pos = d === 0 || d === 1 || d === -1 ? String(d) : 'far';
        if (d === 0) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
      });
      const cur = slides[active];
      count.textContent = `${active + 1} / ${n}`;
      cap.textContent = cur.dataset.caption || '';
    };
    const go = (k: number) => {
      active = (active + k + n) % n;
      layout();
    };
    const apply = () => {
      const cur = slides[active];
      setSeamState({ brick: cur.dataset.brick!, seam: cur.dataset.seam!, from: 'carousel' });
      // показать результат: кадр выше, если его не видно
      const box = document.querySelector<HTMLElement>('#shov-na-kladke [data-ss]');
      if (box) {
        const r = box.getBoundingClientRect();
        // отступ под прилипшую шапку сайта
        const header = document.querySelector('header')?.getBoundingClientRect().height ?? 72;
        if (r.top < header || r.top > window.innerHeight * 0.6) {
          window.scrollTo({ top: window.scrollY + r.top - header - 16, behavior: reduced ? 'auto' : 'smooth' });
        }
      }
    };

    root.querySelector('[data-sc-prev]')!.addEventListener('click', () => go(-1));
    root.querySelector('[data-sc-next]')!.addEventListener('click', () => go(1));
    root.querySelector('[data-sc-apply]')!.addEventListener('click', apply);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
    });

    // Свайп и клик по кадру: горизонтальный жест листает, короткий клик по центральному — применяет,
    // по боковому — делает его центральным.
    let start: { x: number; y: number } | null = null;
    view.addEventListener('pointerdown', (e) => { start = { x: e.clientX, y: e.clientY }; });
    view.addEventListener('pointercancel', () => { start = null; });
    view.addEventListener('pointerup', (e) => {
      if (!start) return;
      const dx = e.clientX - start.x;
      const dy = e.clientY - start.y;
      start = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) { go(dx < 0 ? 1 : -1); return; }
      if (Math.abs(dx) > 8 || Math.abs(dy) > 8) return;
      const slide = (e.target as HTMLElement).closest<HTMLElement>('[data-sc-slide]');
      if (!slide) return;
      if (slide.dataset.pos === '0') apply();
      else if (slide.dataset.pos === '1') go(1);
      else if (slide.dataset.pos === '-1') go(-1);
    });
    layout();
  }
</script>

<style>
  .sc { padding-block: clamp(64px, 8.5vw, 136px); overflow-x: clip; }
  .sc__head {
    display: grid;
    gap: var(--space-4) var(--space-7);
    margin-bottom: clamp(28px, 3.5vw, 48px);
    padding-top: var(--space-4);
    border-top: 1px solid var(--hair-strong);
  }
  .sc__kicker { margin: 0; font-size: var(--fs-tiny); font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-muted); }
  .sc__title { margin: 0; font-size: var(--fs-h2); line-height: 1; letter-spacing: -0.02em; max-width: 16ch; text-wrap: balance; }
  .sc__sub { max-width: 46ch; margin: 0; font-size: var(--fs-lead); color: var(--color-text-soft); }
  @media (min-width: 1000px) {
    .sc__head { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); align-items: end; }
    .sc__kicker { grid-column: 1 / -1; }
    .sc__sub { justify-self: end; }
  }

  /* Сцена: центральный кадр квадратный, боковые уходят в перспективу и частично прячутся за краем */
  .sc__view {
    --card: min(44vw, 520px);
    position: relative;
    height: var(--card);
    perspective: 1400px;
    perspective-origin: 50% 50%;
    overflow: hidden;
    touch-action: pan-y;
    user-select: none;
  }
  .sc__view:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }
  .sc__slide {
    position: absolute;
    top: 0;
    left: 50%;
    width: var(--card);
    height: var(--card);
    margin-left: calc(var(--card) / -2);
    background: var(--paper-3);
    transform-style: preserve-3d;
    transition: transform 0.7s var(--ease), opacity 0.7s var(--ease), filter 0.7s var(--ease);
    cursor: pointer;
  }
  .sc__slide img { display: block; width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
  .sc__slide[data-pos='0'] { z-index: 3; transform: none; }
  /* боковые — тише центральной: дальше и прозрачнее */
  .sc__slide[data-pos='1'] { z-index: 2; transform: translateX(84%) translateZ(-340px) rotateY(-44deg); opacity: 0.5; filter: saturate(0.85); }
  .sc__slide[data-pos='-1'] { z-index: 2; transform: translateX(-84%) translateZ(-340px) rotateY(44deg); opacity: 0.5; filter: saturate(0.85); }
  .sc__slide[data-pos='far'] { z-index: 1; transform: translateZ(-600px); opacity: 0; visibility: hidden; transition: transform 0.7s var(--ease), opacity 0.4s var(--ease), visibility 0s 0.7s; }

  .sc__bar {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    align-items: center;
    gap: 16px;
    max-width: 640px;
    margin: 22px auto 0;
  }
  .sc__arrow {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 1px solid var(--hair-strong);
    background: transparent;
    color: var(--ink);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .sc__arrow:hover { border-color: var(--ink); background: var(--ink); color: var(--paper); }
  .sc__arrow:focus-visible, .sc__apply:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .sc__now { display: grid; gap: 4px; margin: 0; text-align: center; }
  .sc__count { font-size: var(--fs-tiny); letter-spacing: 0.12em; color: var(--color-muted); }
  .sc__cap { font-family: var(--font-head); font-size: clamp(22px, 2vw, 28px); font-weight: 500; line-height: 1.1; }
  .sc__cap::first-letter { text-transform: uppercase; }
  .sc__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 24px; margin-top: 18px; text-align: center; }
  .sc__hint { font-size: 13px; color: var(--color-muted); }

  @media (max-width: 899px) {
    .sc__view { --card: min(68vw, 460px); }
    .sc__slide[data-pos='1'] { transform: translateX(70%) translateZ(-340px) rotateY(-46deg); }
    .sc__slide[data-pos='-1'] { transform: translateX(-70%) translateZ(-340px) rotateY(46deg); }
  }
  @media (max-width: 439px) {
    .sc__cap { font-size: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc__slide, .sc__slide[data-pos='far'] { transition: none; }
  }
</style>
