---
// Объёмная волна образцов раствора — первый экран главной (бриф 20.10, ориентир — ролик со скрученной лентой
// тонких пластин). Пластины — реальные позиции каталога (src/lib/wave-palette.ts), цвет — приближение
// swatchFor, рядом оговорка о цвете на экране. Оттенки идут блоками от светлого к тёмному.
//
// Слои: статичная CSS-раскладка тех же цветов в той же позе (видна сразу; она же — вариант без WebGL) и canvas,
// куда после первой отрисовки страницы динамическим import() грузится сцена Three.js (src/lib/mortar-wave.ts).
// Как только сцена нарисовала первый кадр — раскладка плавно уходит. Без «загрузочного экрана».
//
// Выбор оттенка — обычные кнопки под сценой (aria-pressed, клавиатура) или клик по пластине. Выбор не открывает
// окно цены: для этого — отдельная кнопка «Узнать цену» с data-ask выбранной позиции (механика PriceModal).
// Выбранный оттенок уходит в общее состояние (src/lib/seam-state.ts) — по нему меняется шов на кадре кладки ниже.
// Если в кадр выше поставлено сочетание из карусели, позиции у него нет — выбор в волне снимается.
//
// Сцена (.mw__stage) и панель (.mw__panel) — отдельные блоки: на узком экране страница ставит между ними
// пояснение и кнопку каталога (index.astro, display: contents у обёрток).
import { WAVE_PALETTE } from '../../lib/wave-palette';
import { WAVE_CONFIG as C, colorOfPlate, middleOfColor } from '../../lib/wave-config';

const first = WAVE_PALETTE[0];
const data = JSON.stringify(WAVE_PALETTE.map(({ name, article, series, title, hex }) => ({ name, article, series, title, hex })));

// Статичная раскладка: та же поза, что у сцены в момент t = 0 (кривая, наклон, закрутка), в процентах сцены.
// Перспектива сцены не повторяется точно — только чтобы при подмене слоёв форма не прыгала.
const N = C.count;
const P = WAVE_PALETTE.length;
const halfL = ((N - 1) * C.spacing) / 2;
const halfH = C.view.halfHeight; // видимая половина высоты сцены в её единицах
// x в % ширины сцены, как в resize(): компьютер/планшет (сдвиг вправо) и телефон до 600 px (почти по центру, запас 0,15)
const xPct = (i: number, phone = false) =>
  50 + ((i * C.spacing - halfL + (phone ? C.view.offsetXPhone : C.view.offsetX)) / (halfL + (phone ? 0.15 : C.view.marginX))) * 50;
const plates = Array.from({ length: N }, (_, i) => {
  const u = i / (N - 1) - 0.5;
  const phase = i * C.wave.phaseStep;
  const y = C.curve.rise * Math.sin(u * Math.PI * 1.8) + C.wave.amplitude * Math.sin(phase);
  const slope = (C.wave.amplitude * Math.cos(phase) * C.wave.phaseStep) / C.spacing;
  return {
    hex: WAVE_PALETTE[colorOfPlate(i, N, P)].hex,
    x: xPct(i).toFixed(2),
    xp: xPct(i, true).toFixed(2),
    y: (50 - (y / halfH) * 50).toFixed(2),
    r: ((Math.atan(slope) * C.wave.tilt * 180) / Math.PI).toFixed(1),
    t: ((C.curve.twist * 2 * u * 180) / Math.PI).toFixed(1),
  };
});

// Мелкие подписи-числа вокруг ленты, как в ролике: код оттенка над/под своим блоком (декор, дублирует подпись ниже).
const tags = WAVE_PALETTE.map((c, i) => ({
  x: Math.min(94, Math.max(4, xPct(middleOfColor(i, N, P)))).toFixed(1),
  xp: Math.min(92, Math.max(6, xPct(middleOfColor(i, N, P), true))).toFixed(1),
  y: i % 2 ? 84 : 12,
  text: c.article,
}));
---

<div class="mw" data-mw={data}>
  <div class="mw__stage" role="img" aria-label={`Лента из ${N} образцов цветного раствора, ${P} оттенков Perel и Основит`}>
    <div class="mw__static" aria-hidden="true">
      {plates.map((p) => (
        <span class="mw__plate mortar" style={`--c:${p.hex};--x:${p.x}%;--xp:${p.xp}%;--y:${p.y}%;--r:${p.r}deg;--t:${p.t}deg`}></span>
      ))}
    </div>
    <canvas class="mw__canvas" aria-hidden="true" data-mw-canvas></canvas>
    {tags.map((t, i) => <span class:list={['mw__tag num', { 'is-on': i === 0 }]} aria-hidden="true" data-mw-tag={i} style={`--x:${t.x}%;--xp:${t.xp}%;top:${t.y}%`}>{t.text}</span>)}
  </div>

  <div class="mw__panel">
    <div class="mw__bar">
      <p class="mw__now" aria-live="polite">
        <span class="mw__series" data-mw-series>{first.series} · {first.article}</span>
        <span class="mw__name" data-mw-name>{first.name}</span>
      </p>
      <button type="button" class="mw__ask btn btn--ghost btn--sm" data-ask={first.title} data-mw-ask>Узнать цену</button>
    </div>

    <div class="mw__palette" role="group" aria-label="Оттенок смеси">
      {WAVE_PALETTE.map((c, i) => (
        <button
          type="button"
          class="mw__chip"
          data-mw-color={i}
          aria-pressed={i === 0 ? 'true' : 'false'}
          aria-label={`${c.name}, ${c.series} ${c.article}`}
          title={`${c.name} · ${c.series} ${c.article}`}
        ><span class="mortar" style={`--c:${c.hex}`} aria-hidden="true"></span></button>
      ))}
    </div>

    <div class="mw__foot">
      <p class="mw__note">Цвет на экране приблизительный: плашки сняты с палитр производителей.</p>
      <button type="button" class="mw__pause" aria-pressed="false" data-mw-pause hidden>Остановить анимацию</button>
    </div>
  </div>
</div>

<script>
  import { getSeamState, setSeamState, subscribeSeamState, type SeamState } from '../../lib/seam-state';
  import type { WaveHandle } from '../../lib/mortar-wave';

  type Item = { name: string; article: string; series: string; title: string; hex: string };

  const root = document.querySelector<HTMLElement>('[data-mw]');
  if (root) {
    const items: Item[] = JSON.parse(root.dataset.mw || '[]');
    const canvas = root.querySelector<HTMLCanvasElement>('[data-mw-canvas]')!;
    const series = root.querySelector<HTMLElement>('[data-mw-series]')!;
    const name = root.querySelector<HTMLElement>('[data-mw-name]')!;
    const ask = root.querySelector<HTMLButtonElement>('[data-mw-ask]')!;
    const pause = root.querySelector<HTMLButtonElement>('[data-mw-pause]')!;
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-mw-color]')];
    const tags = [...root.querySelectorAll<HTMLElement>('[data-mw-tag]')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let wave: WaveHandle | null = null;

    /** −1 — в кадре выше сочетание из карусели: позиции у него нет, выбор снят */
    const current = (s: SeamState) => (s.seam ? -1 : s.color);

    const show = (i: number) => {
      const c = items[i];
      if (c) {
        series.textContent = `${c.series} · ${c.article}`;
        name.textContent = c.name;
        ask.dataset.ask = c.title;
        ask.hidden = false;
      } else {
        series.textContent = 'Оттенок смеси не выбран';
        name.textContent = 'Сочетание из подборки';
        ask.hidden = true;
      }
      chips.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
      tags.forEach((t, j) => t.classList.toggle('is-on', j === i));
    };

    chips.forEach((b) =>
      b.addEventListener('click', () => {
        const i = Number(b.dataset.mwColor);
        setSeamState({ color: i, seam: null, from: 'wave' });
      }),
    );

    subscribeSeamState((next, prev) => {
      const i = current(next);
      if (i === current(prev)) return;
      show(i);
      wave?.select(i, next.from === 'wave');
    });
    show(current(getSeamState()));

    // WebGL есть? Проверка на отдельном canvas, контекст сразу освобождаем.
    const hasWebGL = (() => {
      try {
        const test = document.createElement('canvas');
        const gl = (test.getContext('webgl2') || test.getContext('webgl')) as WebGLRenderingContext | null;
        gl?.getExtension('WEBGL_lose_context')?.loseContext();
        return !!gl;
      } catch {
        return false;
      }
    })();

    if (!hasWebGL) {
      root.classList.add('mw--static');
    } else {
      const start = async () => {
        try {
          const { mountWave } = await import('../../lib/mortar-wave');
          wave = mountWave(canvas, {
            colors: items.map((c) => c.hex),
            reduced,
            onPick: (i) => setSeamState({ color: i, seam: null, from: 'wave' }),
            onReady: () => root.classList.add('mw--live'),
          });
          wave.select(current(getSeamState()), false);
          if (!reduced) pause.hidden = false;
        } catch {
          // сцена не поднялась (нет памяти под контекст и т. п.) — остаётся статичная раскладка
          root.classList.add('mw--static');
        }
      };
      // после первой отрисовки страницы, чтобы не задерживать отрисовку заголовка
      requestAnimationFrame(() => setTimeout(start, 0));
    }

    pause.addEventListener('click', () => {
      const stopped = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(stopped));
      pause.textContent = stopped ? 'Запустить анимацию' : 'Остановить анимацию';
      wave?.setPaused(stopped);
    });
  }
</script>

<style>
  .mw { display: grid; gap: 14px; }
  .mw__panel { display: grid; gap: 14px; }

  .mw__stage {
    position: relative;
    aspect-ratio: 16 / 10;
    /* вертикальная прокрутка страницы пальцем по сцене не блокируется */
    touch-action: pan-y;
  }
  .mw__canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    touch-action: pan-y;
    transition: opacity 0.45s var(--ease);
  }
  .mw--live .mw__canvas { opacity: 1; }
  .mw--static .mw__canvas { display: none; }

  /* Статичная раскладка (до сцены, без WebGL): пластины в той же позе, что у сцены в момент старта */
  .mw__static {
    position: absolute;
    inset: 0;
    z-index: 1;
    perspective: 900px;
    transition: opacity 0.45s var(--ease);
  }
  .mw--live .mw__static { opacity: 0; visibility: hidden; transition: opacity 0.45s var(--ease), visibility 0s 0.45s; }
  .mw__static > .mw__plate.mortar {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: 9.5%;
    height: 36%;
    /* оси сцены → CSS: закрутка вокруг оси ленты (в сцене — вокруг нормали пластины) = rotateZ в плоскости плашки,
       наклон по касательной = rotateX, разворот к зрителю = rotateY */
    transform: translate(-50%, -50%) rotateY(39deg) rotateX(var(--r)) rotateZ(calc(-1 * var(--t)));
  }

  /* коды оттенков — под лентой и приглушённые; код выбранного — тушью */
  .mw__tag {
    position: absolute;
    left: var(--x);
    z-index: 0;
    translate: -50% 0;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    opacity: 0.6;
    pointer-events: none;
    transition: opacity var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .mw__tag.is-on { color: var(--ink); opacity: 1; }

  .mw__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 12px 24px;
    padding-top: 14px;
    border-top: 1px solid var(--hair-strong);
  }
  .mw__now { display: grid; gap: 4px; margin: 0; min-width: 0; }
  .mw__series { font-size: var(--fs-tiny); font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-muted); }
  .mw__name { font-family: var(--font-head); font-size: clamp(26px, 2.4vw, 34px); font-weight: 500; line-height: 1; letter-spacing: -0.01em; }
  .mw__name::first-letter { text-transform: uppercase; }
  .mw__ask { min-height: 44px; }
  .mw__ask[hidden] { display: none; }

  .mw__palette { display: flex; flex-wrap: wrap; gap: 6px; }
  /* восемь кнопок по 44 px в строку не входят уже телефона — две строки по четыре, без одинокой в конце */
  @media (max-width: 439px) { .mw__palette { display: grid; grid-template-columns: repeat(4, 44px); gap: 6px 10px; } }
  .mw__chip {
    display: block;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 4px;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .mw__chip .mortar {
    display: block;
    width: 100%;
    height: 100%;
    outline: 1.5px solid transparent;
    outline-offset: 2px;
    transition: translate 0.35s var(--ease), outline-color var(--dur) var(--ease);
  }
  .mw__chip:hover .mortar { translate: 0 -3px; }
  /* выбор — тонкая рамка вплотную к плашке; фокус с клавиатуры — отдельное кольцо по краю кнопки */
  .mw__chip[aria-pressed='true'] .mortar { outline-color: var(--ink); translate: none; }
  .mw__chip:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* оговорка слева, пауза справа — одной тихой строкой */
  .mw__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 20px; }
  /* на телефоне оговорке тесно рядом с паузой — пауза уходит строкой ниже */
  .mw__note { flex: 1 1 30ch; margin: 0; font-size: 13px; color: var(--color-muted); }
  .mw__pause {
    min-height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-muted);
    font: inherit;
    font-size: 13px;
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
  .mw__pause:hover { color: var(--ink); text-decoration-color: var(--ink); }
  .mw__pause:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .mw__pause[hidden] { display: none; }

  /* компьютер: сцена выходит за правый край сетки до края окна — лента «через экран», как в ролике
     (лишнее срезает overflow-x: clip у первого экрана, прокрутки вбок нет) */
  @media (min-width: 1000px) {
    .mw__stage {
      aspect-ratio: auto;
      height: clamp(380px, 52vh, 520px);
      margin-right: calc(-1 * max(var(--gutter), (100vw - var(--container)) / 2));
    }
  }
  /* телефон и планшет: сцена на всю ширину экрана, без полей */
  @media (max-width: 999px) {
    .mw__stage { margin-inline: calc(-1 * var(--gutter)); }
  }
  @media (max-width: 599px) {
    .mw__stage { aspect-ratio: 3 / 2; }
    .mw__tag { left: var(--xp); font-size: 10px; }
    .mw__static > .mw__plate.mortar { left: var(--xp); }
    .mw__tag:nth-of-type(even):not(.is-on) { display: none; }
  }
</style>
