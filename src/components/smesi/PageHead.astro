---
// Шапка внутренней страницы (редизайн 11.10): крошки, подпись, очень крупный H1 антиквой и лид.
// Правая колонка (slot aside) — для полосы оттенков и т.п.; кадров кирпича здесь больше нет.
import Container from '../layout/Container.astro';
import Breadcrumbs from '../layout/Breadcrumbs.astro';
import { PAGES } from '../../data/nav';
import { nb } from '../../lib/typo';
import type { BreadcrumbItem } from '../../lib/types';

interface Props {
  h1: string;
  kicker?: string;
  lead?: string;
  trail?: BreadcrumbItem[];
  crumb?: string;
  tone?: 'base' | 'alt';
}

const { h1, kicker, lead, trail = [], crumb } = Astro.props;
const hasAside = Astro.slots.has('aside');
---

<section class:list={['mh', hasAside && 'mh--split']}>
  <Container>
    <Breadcrumbs site="smesi" trail={[{ label: 'Главная', href: PAGES.home.href }, ...trail, { label: crumb ?? h1 }]} />
    <div class="mh__grid">
      <div class="mh__text">
        {kicker && <p class="mh__kicker" data-reveal>{kicker}</p>}
        <h1 class="mh__title" data-reveal="head">{nb(h1)}</h1>
        {lead && <p class="mh__lead" data-reveal>{nb(lead)}</p>}
        <slot />
      </div>
      {hasAside && <div class="mh__aside" data-reveal><slot name="aside" /></div>}
    </div>
  </Container>
</section>

<style>
  .mh { padding: var(--space-5) 0 clamp(48px, 7vw, 104px); border-bottom: 1px solid var(--hair); }
  .mh__grid { display: grid; gap: var(--space-7); margin-top: clamp(28px, 5vw, 72px); align-items: end; }
  .mh__kicker { margin: 0 0 var(--space-4); font-size: var(--fs-tiny); font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-muted); }
  .mh__title {
    margin: 0;
    font-family: var(--font-head);
    font-weight: 500;
    font-size: var(--fs-h1);
    line-height: 0.95;
    letter-spacing: -0.025em;
    max-width: 13ch;
    text-wrap: balance;
  }
  .mh__lead { max-width: 54ch; margin: var(--space-6) 0 0; font-size: var(--fs-lead); color: var(--color-text-soft); }
  @media (min-width: 1000px) {
    .mh--split .mh__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 5vw, 80px); }
  }
</style>
