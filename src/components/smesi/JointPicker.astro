---
// Подбор цвета шва под кирпич: кадр кладки + переключатели «завод → цвет кирпича → цвет шва».
// Кадры — визуализации кладки из материалов клиента (Яндекс.Диск, «Текстуры (кладки)»), подписи
// шва поставлены по видимому цвету, а не по имени файла (src/data/kladka.ts).
// ⚠️ Кадр показывает ОТТЕНОК шва, а не конкретную позицию: бренда и кода смеси у кадров нет.
// Поэтому под кадром — ссылки на близкие по тону позиции каталога, а не «это Perel 0005».
//
// Вид (редизайн 11.10, язык «палитра шва»): кадр крупно без скругления, подпись ПОД кадром;
// завод — текстовые вкладки, цвета кирпича — строка слов с подчёркиванием выбранного, цвета шва —
// квадратные плашки раствора (.mortar) с подписью, выбранная обведена тушью. Группы — через тонкие линии.
// На узком экране кадр (кадрирован 4:3) прилипает под шапкой: переключаешь шов — и сразу видишь кладку.
//
// Без JS: виден первый кадр и все переключатели-ссылки ведут в каталог; со скриптом кадр
// меняется на месте, загружаются только выбранные кадры (атрибут data-src, не src).
import { KLADKA_UNIQUE as KLADKA, KLADKA_TONE_ON_TONE } from '../../data/kladka';
import { PAGES } from '../../data/nav';
import { TONE_OF_SEAM, brickLabel } from '../../lib/seams';

interface Props {
  /** compact — для первого экрана главной: один кирпич, только швы */
  variant?: 'full' | 'compact';
  /** id кирпича для compact и стартовый для full */
  start?: string;
  id?: string;
}

const { variant = 'full', start, id = 'jp' } = Astro.props;
const bricks = variant === 'compact' ? KLADKA.filter((b) => b.id === (start ?? KLADKA[0]?.id)) : KLADKA;
const first = bricks.find((b) => b.id === start) ?? bricks[0];
const firstSeam = first?.seams[0];
const factories = [...new Map(bricks.map((b) => [b.factory, b.factoryName])).entries()];
const full = variant === 'full';
// Номер шага у подписи группы — только в полном варианте (в компактном группа одна).
const many = factories.length > 1;
const step = (n: number) => (full ? `0${n}` : '');

// Кадры, где шов почти в цвет кирпича (ΔE < 10, замер агента данных): подписываем, чтобы
// человек не решил, что шва «нет».
const toneOnTone = new Set(KLADKA_TONE_ON_TONE.map(([b, s]) => `${b}|${s}`));
const data = JSON.stringify(
  bricks.map((b) => ({ id: b.id, factory: b.factory, brick: b.brick, label: brickLabel(b.brick), seams: b.seams.map((s) => ({ id: s.id, label: s.label, src: s.src, srcSm: s.srcSm, tone: TONE_OF_SEAM[s.id] ?? '', same: toneOnTone.has(`${b.id}|${s.id}`) })) })),
);
---

{first && firstSeam && (
  <div class:list={['jp', `jp--${variant}`]} id={id} data-jp={data} data-katalog={PAGES.katalog.href}>
    <figure class="jp__stage">
      <div class="jp__frame">
        <img
          class="jp__img"
          src={firstSeam.src}
          srcset={`${firstSeam.srcSm} 320w, ${firstSeam.src} ${firstSeam.w}w`}
          sizes={variant === 'compact' ? '(min-width: 960px) 44vw, 92vw' : '(min-width: 860px) 56vw, 92vw'}
          width={firstSeam.w}
          height={firstSeam.h}
          alt={`Кладка: ${brickLabel(first.brick)}, ${firstSeam.label} шов`}
          data-jp-img
          fetchpriority={variant === 'compact' ? 'high' : undefined}
        />
      </div>
      <figcaption class="jp__cap">
        <span class="jp__now" data-jp-caption>{brickLabel(first.brick)} · шов {firstSeam.label}{toneOnTone.has(`${first.id}|${firstSeam.id}`) ? ' — почти в цвет кирпича' : ''}</span>
        <span class="jp__hint">Визуализация кладки, цвет на экране приблизительный</span>
      </figcaption>
    </figure>

    <div class="jp__controls">
      {full && (
        <Fragment>
          {many && (
            <div class="jp__group">
              <p class="jp__label"><span class="jp__step num">{step(1)}</span>Завод</p>
              <div class="jp__tabs" role="tablist" aria-label="Завод кирпича">
                {factories.map(([f, name]) => (
                  <button type="button" class="jp__tab" role="tab" aria-selected={f === first.factory ? 'true' : 'false'} data-jp-factory={f}>{name}</button>
                ))}
              </div>
            </div>
          )}
          <div class="jp__group">
            <p class="jp__label"><span class="jp__step num">{step(many ? 2 : 1)}</span>Цвет кирпича</p>
            <div class="jp__bricks" data-jp-bricks>
              {bricks.map((b) => (
                <button
                  type="button"
                  class="jp__brick"
                  data-jp-brick={b.id}
                  data-factory={b.factory}
                  aria-pressed={b.id === first.id ? 'true' : 'false'}
                  hidden={b.factory !== first.factory}
                >{b.brick}</button>
              ))}
            </div>
          </div>
        </Fragment>
      )}

      <div class="jp__group">
        <p class="jp__label"><span class="jp__step num">{step(many ? 3 : 2)}</span>Цвет шва</p>
        <div class="jp__seams" data-jp-seams>
          {first.seams.map((s, i) => (
            <button type="button" class="jp__seam" data-jp-seam={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <span class="jp__sw mortar" data-seam={s.id} aria-hidden="true"></span>
              <span class="jp__sn">{s.label}</span>
            </button>
          ))}
        </div>
      </div>

      <a class="jp__link arrow-link" href={`${PAGES.katalog.href}?ton=${TONE_OF_SEAM[firstSeam.id] ?? ''}`} data-jp-link>
        Смеси этого тона в каталоге <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
)}

<script>
  type Seam = { id: string; label: string; src: string; srcSm: string; tone: string; same?: boolean };
  type Brick = { id: string; factory: string; brick: string; label: string; seams: Seam[] };

  document.querySelectorAll<HTMLElement>('[data-jp]').forEach((root) => {
    const bricks: Brick[] = JSON.parse(root.dataset.jp || '[]');
    const katalog = root.dataset.katalog || '/katalog/';
    const img = root.querySelector<HTMLImageElement>('[data-jp-img]');
    const caption = root.querySelector<HTMLElement>('[data-jp-caption]');
    const seamsBox = root.querySelector<HTMLElement>('[data-jp-seams]');
    const link = root.querySelector<HTMLAnchorElement>('[data-jp-link]');
    if (!img || !seamsBox || !bricks.length) return;

    const startId = root.querySelector<HTMLElement>('[data-jp-brick][aria-pressed="true"]')?.dataset.jpBrick;
    let brick = bricks.find((b) => b.id === startId) ?? bricks[0];
    let seamId = brick.seams[0]?.id;

    const press = (sel: string, attr: string, value: string) =>
      root.querySelectorAll<HTMLElement>(sel).forEach((b) => b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value)));

    const show = () => {
      const seam = brick.seams.find((s) => s.id === seamId) ?? brick.seams[0];
      if (!seam) return;
      seamId = seam.id;
      // srcset снимаем: иначе браузер оставит прежний кадр из набора
      img.removeAttribute('srcset');
      img.src = seam.src;
      img.alt = `Кладка: ${brick.label}, ${seam.label} шов`;
      if (caption) caption.textContent = `${brick.label} · шов ${seam.label}${seam.same ? ' — почти в цвет кирпича' : ''}`;
      if (link) link.href = `${katalog}?ton=${seam.tone}`;
      press('[data-jp-seam]', 'data-jp-seam', seam.id);
    };

    // Плашки шва пересобираются под выбранный кирпич; разметка та же, что в серверной вёрстке выше.
    const renderSeams = () => {
      seamsBox.innerHTML = '';
      brick.seams.forEach((s) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'jp__seam';
        b.dataset.jpSeam = s.id;
        b.setAttribute('aria-pressed', String(s.id === seamId));
        const sw = document.createElement('span');
        sw.className = 'jp__sw mortar';
        sw.dataset.seam = s.id;
        sw.setAttribute('aria-hidden', 'true');
        const name = document.createElement('span');
        name.className = 'jp__sn';
        name.textContent = s.label;
        b.append(sw, name);
        seamsBox.append(b);
      });
    };

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      const seamBtn = t.closest<HTMLElement>('[data-jp-seam]');
      if (seamBtn) { seamId = seamBtn.dataset.jpSeam!; show(); return; }
      const brickBtn = t.closest<HTMLElement>('[data-jp-brick]');
      if (brickBtn) {
        const next = bricks.find((b) => b.id === brickBtn.dataset.jpBrick);
        if (!next) return;
        brick = next;
        if (!brick.seams.some((s) => s.id === seamId)) seamId = brick.seams[0]?.id;
        press('[data-jp-brick]', 'data-jp-brick', brick.id);
        renderSeams();
        show();
        return;
      }
      const tab = t.closest<HTMLElement>('[data-jp-factory]');
      if (tab) {
        const f = tab.dataset.jpFactory!;
        root.querySelectorAll<HTMLElement>('[data-jp-factory]').forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
        root.querySelectorAll<HTMLElement>('[data-jp-brick]').forEach((x) => { x.hidden = x.dataset.factory !== f; });
        const firstOf = bricks.find((b) => b.factory === f);
        if (firstOf) {
          brick = firstOf;
          if (!brick.seams.some((s) => s.id === seamId)) seamId = brick.seams[0]?.id;
          press('[data-jp-brick]', 'data-jp-brick', brick.id);
          renderSeams();
          show();
        }
      }
    });

    // Подгрузить соседние кадры текущего кирпича заранее — переключение без пустой паузы.
    const warm = () => brick.seams.forEach((s) => { const i = new Image(); i.src = s.src; });
    if ('requestIdleCallback' in window) (window as any).requestIdleCallback(warm);
    else setTimeout(warm, 1200);
  });
</script>

<!-- is:global: кнопки шва пересобирает скрипт, а узлы, созданные скриптом, не получают
     скоуп-атрибут Astro — скоуп-стили до них молча не доходят (тот же дефект, что 29.09
     у карточки товара ЖКЗ). Префикс .jp уникален, наружу стили не текут. -->
<style is:global>
  .jp { display: grid; gap: clamp(28px, 4vw, 48px); }

  /* ── Кадр: крупно, без скругления; подпись — под кадром, а не поверх ── */
  .jp__stage { margin: 0; }
  .jp__frame { overflow: hidden; background: var(--paper-2); }
  .jp__img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; }
  .jp__cap { display: grid; gap: 4px; padding-top: 14px; }
  .jp__now { display: block; font-family: var(--font-head); font-size: clamp(22px, 2vw, 28px); font-weight: 500; line-height: 1.1; letter-spacing: -0.01em; color: var(--ink); }
  .jp__now::first-letter { text-transform: uppercase; }
  .jp__hint { font-size: 13px; color: var(--color-muted); }

  /* ── Переключатели: группы через тонкие линии, подпись мелким капсом с номером шага ── */
  .jp__controls { display: grid; align-content: start; border-top: 1px solid var(--hair-strong); }
  .jp__group { display: grid; gap: 10px; padding: 16px 0 22px; border-bottom: 1px solid var(--hair); }
  .jp__label {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 0;
    font-size: var(--fs-tiny);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .jp__step { letter-spacing: 0.04em; color: var(--ink); }
  .jp__step:empty { display: none; }

  .jp__tab, .jp__brick, .jp__seam {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-soft);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .jp__tab:focus-visible, .jp__brick:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* Завод — текстовые вкладки антиквой, выбранная подчёркнута тушью */
  .jp__tabs { display: flex; flex-wrap: wrap; gap: 2px 28px; }
  .jp__tab {
    padding: 4px 0 3px;
    border-bottom: 1px solid transparent;
    font-family: var(--font-head);
    font-size: clamp(21px, 1.8vw, 25px);
    font-weight: 500;
    line-height: 1.2;
    color: var(--color-muted);
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .jp__tab:hover { color: var(--ink); }
  .jp__tab[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--ink); }

  /* Цвет кирпича — строка слов, выбранный подчёркнут */
  .jp__bricks { display: flex; flex-wrap: wrap; gap: 0 22px; }
  .jp__brick {
    padding: 8px 0 5px;
    border-bottom: 1px solid transparent;
    font-size: 16.5px;
    line-height: 1.3;
    transition: color var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .jp__brick[hidden] { display: none; }
  .jp__brick:hover { color: var(--ink); border-bottom-color: var(--hair-strong); }
  .jp__brick[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--ink); }

  /* Цвет шва — квадратные плашки раствора с подписью; выбранная обведена тушью */
  .jp__seams { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px 14px; padding-top: 4px; }
  .jp__seam { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  .jp__sw {
    --c: #bdb6ab;
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    outline: 1.5px solid transparent;
    outline-offset: 3px;
    transition: translate 0.4s var(--ease), outline-color var(--dur) var(--ease);
  }
  /* светлые плашки на бумаге: кромка чуть заметнее, чем у .mortar по умолчанию */
  html[data-site='smesi'] .jp .jp__sw { box-shadow: inset 0 0 0 1px var(--hair), inset 0 -18px 30px -24px rgb(0 0 0 / 0.25); }
  .jp__seam:hover .jp__sw { translate: 0 -3px; }
  .jp__seam[aria-pressed='true'] .jp__sw { outline-color: var(--ink); translate: none; }
  .jp__seam:focus-visible { outline: none; }
  .jp__seam:focus-visible .jp__sw { outline: 2px solid var(--ink); }
  /* без автопереносов: «суперб-елый» читается хуже, чем перенос по дефису «светло-/коричневый» */
  .jp__sn { font-size: 13.5px; line-height: 1.2; overflow-wrap: break-word; }
  .jp__seam[aria-pressed='true'] .jp__sn { color: var(--ink); font-weight: 500; }

  /* условные оттенки плашек — подсказка, не образец конкретной смеси */
  .jp__sw[data-seam='white'] { --c: #f2efe8; }
  .jp__sw[data-seam='superwhite'] { --c: #ffffff; }
  .jp__sw[data-seam='lightgrey'] { --c: #c7c6c1; }
  .jp__sw[data-seam='grey'] { --c: #9c9a95; }
  .jp__sw[data-seam='darkgrey'] { --c: #5d5b57; }
  .jp__sw[data-seam='black'] { --c: #232220; }
  .jp__sw[data-seam='blackbrown'] { --c: #422f28; }
  .jp__sw[data-seam='darkbrown'] { --c: #5c3d2c; }
  .jp__sw[data-seam='brown'] { --c: #5a3a26; }
  .jp__sw[data-seam='lightbrown'] { --c: #a77b55; }
  .jp__sw[data-seam='cream'] { --c: #cbaca5; }

  .jp__link { justify-self: start; margin-top: 22px; }

  /* ── Полный вариант на узком экране: кадр 4:3 прилипает под шапкой, переключатели листаются под ним ── */
  /* Линия под подписью отделяет прилипший кадр от листаемого под ним; у переключателей своей верхней линии тогда нет. */
  @media (max-width: 859px) {
    .jp--full .jp__img { aspect-ratio: 4 / 3; }
    /* боковые «тени» той же бумагой закрывают поля страницы: иначе рамка выбранной плашки, уехавшей
       под кадр, выглядывает слева полоской (она выходит за плашку на 4–5 px) */
    .jp--full .jp__stage {
      z-index: 2;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--hair-strong);
      background: var(--paper);
      box-shadow: -24px 0 0 var(--paper), 24px 0 0 var(--paper);
    }
    .jp--full .jp__controls { border-top: 0; }
  }
  /* планшет и невысокий телефон: кадр ниже (16:9), чтобы под ним оставалось место переключателям */
  @media (min-width: 600px) and (max-width: 859px), (max-width: 859px) and (max-height: 719px) {
    .jp--full .jp__img { aspect-ratio: 16 / 9; }
  }
  /* планшет: плашки мельче, иначе по 150 px они съедают экран под кадром. Подпись «коричневый» при 13 px
     занимает 77 px — восемь в строку помещаются только с 760 px (замер переносов), до того по шесть. */
  @media (min-width: 600px) and (max-width: 859px) {
    .jp--full .jp__seams { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px 10px; }
    .jp__sn { font-size: 13px; }
  }
  @media (min-width: 760px) and (max-width: 859px) {
    .jp--full .jp__seams { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  }
  @media (max-width: 859px) and (min-height: 600px) {
    .jp--full .jp__stage { position: sticky; top: 72px; align-self: start; }
  }
  @media (max-width: 599px) {
    .jp__seams { gap: 16px 10px; }
    .jp__sn { font-size: 13px; }
  }
  /* «коричневый» — самое длинное слово без дефиса (~72 px): уже 4 плашек в ряд ему тесно */
  @media (max-width: 379px) {
    .jp__seams { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ── Широкий экран: кадр 7 колонок из 12, переключатели 5 ── */
  @media (min-width: 860px) {
    .jp--full { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(32px, 4.5vw, 72px); align-items: start; }
  }
  /* колонка переключателей ещё узкая для четырёх подписей в строку */
  @media (min-width: 860px) and (max-width: 999px) {
    .jp--full .jp__seams { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* ── compact — первый экран на тёмном фоне (сейчас на страницах не используется) ── */
  .jp--compact .jp__now { color: var(--paper); }
  .jp--compact .jp__hint, .jp--compact .jp__label { color: rgb(247 244 238 / 0.7); }
  .jp--compact .jp__controls { border-top-color: rgb(247 244 238 / 0.3); }
  .jp--compact .jp__group { border-bottom-color: rgb(247 244 238 / 0.18); }
  .jp--compact .jp__seam { color: rgb(247 244 238 / 0.75); }
  .jp--compact .jp__seam[aria-pressed='true'] .jp__sn { color: var(--paper); }
  .jp--compact .jp__seam[aria-pressed='true'] .jp__sw,
  .jp--compact .jp__seam:focus-visible .jp__sw { outline-color: var(--paper); }
  html[data-site='smesi'] .jp--compact .jp__link { color: var(--paper); border-bottom-color: rgb(247 244 238 / 0.4); }
  html[data-site='smesi'] .jp--compact .jp__link:hover { border-bottom-color: var(--sand); }
</style>
